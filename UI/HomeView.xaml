<UserControl
    x:Class="CANvision.Native.UI.HomeView"
    xmlns:cvmodels="clr-namespace:CANvision.Native.Models"
    xmlns:cvctl="clr-namespace:CANvision.Native.UI.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CANvision.Native.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Pulsing "still working" state for phases with no real progress to
             report (AI explanation generation) — used instead of freezing a
             percentage number that looks identical to a hung progress bar. -->
        <Style x:Key="PulsingWhenIndeterminate" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnalysisIndeterminate}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.35" Duration="0:0:0.9"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource CvGroundBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardFlipStates">

                <!-- Default: both cards visible, normal content shown -->
                <VisualState x:Name="ChooserMode">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveCard"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineCard"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="LiveCard"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0"/>
                        <DoubleAnimation Storyboard.TargetName="OfflineCard"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveNormal"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveConnectingPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineNormal"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineImportingPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineModelPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- Live session selected: offline card collapsed, live card shows progress -->
                <VisualState x:Name="LiveConnecting">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineCard"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveNormal"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveConnectingPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- Offline import selected: live card collapsed, offline card shows progress -->
                <VisualState x:Name="OfflineImporting">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveCard"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineNormal"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineImportingPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineModelPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- File chosen: confirm the vehicle / AI model before the analysis runs -->
                <VisualState x:Name="OfflineModelSelect">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveCard"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineNormal"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineImportingPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineModelPanel"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualStateGroup.Transitions>

                    <!-- ChooserMode → LiveConnecting: offline fades, live card flips -->
                    <VisualTransition From="ChooserMode" To="LiveConnecting">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OfflineCard"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="LiveCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0" Duration="0:0:0.15"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveNormal"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveConnectingPanel"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="LiveCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.15"/>
                        </Storyboard>
                    </VisualTransition>

                    <!-- LiveConnecting → ChooserMode: live card flips back, offline fades in -->
                    <VisualTransition From="LiveConnecting" To="ChooserMode">
                        <Storyboard>
                            <!-- Restore OfflineCard visibility at t=0 so opacity fade-in works -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineCard"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="LiveCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0" Duration="0:0:0.15"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveConnectingPanel"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveNormal"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="LiveCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="OfflineCard"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.2"/>
                        </Storyboard>
                    </VisualTransition>

                    <!-- ChooserMode → OfflineImporting: live fades, offline card flips -->
                    <VisualTransition From="ChooserMode" To="OfflineImporting">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LiveCard"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="OfflineCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0" Duration="0:0:0.15"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineNormal"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineImportingPanel"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OfflineCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.15"/>
                        </Storyboard>
                    </VisualTransition>

                    <!-- OfflineImporting → ChooserMode: offline card flips back, live fades in -->
                    <VisualTransition From="OfflineImporting" To="ChooserMode">
                        <Storyboard>
                            <!-- Restore LiveCard visibility at t=0 so opacity fade-in works -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LiveCard"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OfflineCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0" Duration="0:0:0.15"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineImportingPanel"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OfflineNormal"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OfflineCardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="LiveCard"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.2"/>
                        </Storyboard>
                    </VisualTransition>

                </VisualStateGroup.Transitions>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Ambient wash, as on the other screens -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.55" RadiusY="0.6">
                    <GradientStop Color="#1A145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Two-card chooser -->
        <Grid>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- ── LIVE SESSION card ─────────────────────────────────── -->
                <Border x:Name="LiveCard"
                        Width="460" Height="400" Padding="44,38"
                        Background="{DynamicResource CvPanelBrush}" BorderBrush="{DynamicResource CvBorderAccentBrush}"
                        BorderThickness="1" CornerRadius="3" Margin="8,0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LiveCardScale" ScaleX="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- corner brackets -->
                        <Path Data="M 0,28 L 0,0 L 28,0" Stroke="{DynamicResource CvAccentBrush}" Opacity="0.55" StrokeThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-44,-38,0,0" IsHitTestVisible="False"/>
                        <Path Data="M 28,0 L 28,28 L 0,28" Stroke="{DynamicResource CvAccentBrush}" Opacity="0.55" StrokeThickness="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-44,-38" IsHitTestVisible="False"/>

                        <!-- Face A: choose live -->
                        <Grid x:Name="LiveNormal">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <cvctl:CvTrackedText Grid.Row="0" Label="MODE 01" Style="{StaticResource CvCaps}" Foreground="{DynamicResource CvAccentBrush}" Margin="0,0,0,16"/>
                            <cvctl:CvTrackedText Grid.Row="1" Label="LIVE SESSION" FontFamily="{StaticResource CvDisplayFont}" FontSize="32" FontWeight="Bold" Tracking="1" Foreground="{DynamicResource CvTextBrightBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <TextBlock Grid.Row="2" Text="Real-time CAN bus monitoring with live anomaly detection, signal decoding and AI-powered threat analysis." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,16,0,0" FontFamily="{StaticResource CvUiFont}" FontSize="13" LineHeight="22" Foreground="{DynamicResource CvTextMutedBrush}"/>
                            <Border Grid.Row="3" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource CvTextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackendStatusText}" Value="CONNECTED">
                                                    <Setter Property="Fill" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="BACKEND OFFLINE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackendStatusText}" Value="CONNECTED">
                                                    <Setter Property="Text" Value="BACKEND CONNECTED"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            </Border>
                            <Button Grid.Row="4" Style="{StaticResource CvButtonPrimary}" Height="40"
                                    IsEnabled="{Binding CanStartLive}"
                                    Command="{Binding LaunchOnlineDiagnosisCommand}"
                                    AutomationProperties.Name="START LIVE SESSION"
                                    ToolTip="Start monitoring the live CAN bus">
                                <cvctl:CvTrackedText Label="START LIVE SESSION" FontFamily="{StaticResource CvDisplayFont}"
                                                     FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>

                        <!-- Face B: connecting -->
                        <Grid x:Name="LiveConnectingPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <cvctl:CvTrackedText Grid.Row="0" Label="MODE 01" Style="{StaticResource CvCaps}" Foreground="{DynamicResource CvAccentBrush}" Margin="0,0,0,16"/>
                            <cvctl:CvTrackedText Grid.Row="1" Label="ESTABLISHING LINK" FontFamily="{StaticResource CvDisplayFont}" FontSize="26" FontWeight="Bold" Tracking="1" Foreground="{DynamicResource CvTextBrightBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,22,0,0">
                                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Margin="0,0,0,18"
                                             Foreground="{DynamicResource CvAccentBrush}" Background="{DynamicResource CvOverlay14Brush}"/>
                                <Border Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource CvTextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackendStatusText}" Value="CONNECTED">
                                                    <Setter Property="Fill" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="BACKEND OFFLINE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackendStatusText}" Value="CONNECTED">
                                                    <Setter Property="Text" Value="BACKEND CONNECTED"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                                </Border>
                                <TextBlock Text="INTERFACE INITIALIZING..." FontFamily="{StaticResource CvMonoFont}" FontSize="10"
                                           Foreground="{DynamicResource CvTextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Row="4" Style="{StaticResource CvButtonGhost}" Height="40"
                                    Command="{Binding CancelLiveSessionCommand}"
                                    AutomationProperties.Name="CANCEL"
                                    ToolTip="Cancel the live session">
                                <cvctl:CvTrackedText Label="CANCEL" FontFamily="{StaticResource CvDisplayFont}"
                                                     FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── OFFLINE IMPORT card ──────────────────────────────── -->
                <Border x:Name="OfflineCard"
                        Width="460" Height="400" Padding="44,38"
                        Background="{DynamicResource CvPanelBrush}" BorderBrush="{DynamicResource CvBorderAccentBrush}"
                        BorderThickness="1" CornerRadius="3" Margin="8,0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="OfflineCardScale" ScaleX="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- corner brackets -->
                        <Path Data="M 0,28 L 0,0 L 28,0" Stroke="{DynamicResource CvAccentBrush}" Opacity="0.55" StrokeThickness="1"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-44,-38,0,0" IsHitTestVisible="False"/>
                        <Path Data="M 28,0 L 28,28 L 0,28" Stroke="{DynamicResource CvAccentBrush}" Opacity="0.55" StrokeThickness="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-44,-38" IsHitTestVisible="False"/>

                        <!-- Face A: choose offline -->
                        <Grid x:Name="OfflineNormal">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <cvctl:CvTrackedText Grid.Row="0" Label="MODE 02" Style="{StaticResource CvCaps}" Foreground="{DynamicResource CvAccentBrush}" Margin="0,0,0,16"/>
                            <cvctl:CvTrackedText Grid.Row="1" Label="OFFLINE IMPORT" FontFamily="{StaticResource CvDisplayFont}" FontSize="32" FontWeight="Bold" Tracking="1" Foreground="{DynamicResource CvTextBrightBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <TextBlock Grid.Row="2" Text="Import a recorded CAN log, pick the vehicle / AI model and run forensic ML analysis with AI-powered attack explanations." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,16,0,0" FontFamily="{StaticResource CvUiFont}" FontSize="13" LineHeight="22" Foreground="{DynamicResource CvTextMutedBrush}"/>
                            <Border Grid.Row="3" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource CvTextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDiveIn}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HealthModelText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            
                                            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDiveIn}" Value="True">
                                                    
                                                    <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            </Border>
                            <Button Grid.Row="4" Style="{StaticResource CvButtonPrimary}" Height="40"
                                    Command="{Binding ImportReplayCommand}"
                                    AutomationProperties.Name="IMPORT LOG FILE"
                                    ToolTip="Choose a CAN log to analyse">
                                <cvctl:CvTrackedText Label="IMPORT LOG FILE" FontFamily="{StaticResource CvDisplayFont}"
                                                     FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>

                        <!-- Face B: importing / analysing -->
                        <Grid x:Name="OfflineImportingPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <cvctl:CvTrackedText Grid.Row="0" Label="MODE 02" Style="{StaticResource CvCaps}" Foreground="{DynamicResource CvAccentBrush}" Margin="0,0,0,16"/>
                            <cvctl:CvTrackedText Grid.Row="1" Label="ANALYZING FILE" FontFamily="{StaticResource CvDisplayFont}" FontSize="26" FontWeight="Bold" Tracking="1" Foreground="{DynamicResource CvTextBrightBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,22,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- IsIndeterminate scrolls continuously during the phase with no
                                         real progress to report, instead of freezing at a percentage. -->
                                    <ProgressBar Grid.Column="0" Height="3" BorderThickness="0" VerticalAlignment="Center"
                                                 Value="{Binding AnalysisProgressPercent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsAnalysisIndeterminate}" Maximum="100"
                                                 Foreground="{DynamicResource CvAccentBrush}" Background="{DynamicResource CvOverlay14Brush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AnalysisProgressText}" Margin="10,0,0,0"
                                               Visibility="{Binding IsAnalysisIndeterminate, Converter={StaticResource InvBoolToVis}}"
                                               FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                               Foreground="{DynamicResource CvAccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding AnalysisStatusText}" Style="{StaticResource PulsingWhenIndeterminate}"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource CvTextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding AnalysisFramesText}" FontFamily="{StaticResource CvMonoFont}" FontSize="10"
                                           Foreground="{DynamicResource CvTextMutedBrush}"/>
                            </StackPanel>
                            <cvctl:CvTrackedText Grid.Row="4" Label="PROCESSING · PLEASE WAIT" Style="{StaticResource CvCaps}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Face C: vehicle / AI model selection, between IMPORT and RUN ANALYSIS -->
                        <Grid x:Name="OfflineModelPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <cvctl:CvTrackedText Grid.Row="0" Label="MODE 02 · SELECT MODEL" Style="{StaticResource CvCaps}"
                                                 Foreground="{DynamicResource CvAccentBrush}"/>
                            <TextBlock Grid.Row="1" Text="{Binding PendingImportName}" Margin="0,8,0,0"
                                       FontFamily="{StaticResource CvMonoFont}" FontSize="13"
                                       Foreground="{DynamicResource CvTextBrightBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PendingImportName}"/>

                            <cvctl:CvTrackedText Grid.Row="2" Label="VEHICLE / AI MODEL" Style="{StaticResource CvCaps}" Margin="0,18,0,0"/>
                            <ComboBox Grid.Row="3" Style="{StaticResource CvComboBox}" Height="34" Margin="0,7,0,0"
                                      ItemsSource="{Binding ModelSelection.Models}"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectedItem="{Binding ModelSelection.SelectedModel, Mode=TwoWay}"
                                      ToolTip="Trained model the offline analysis will use">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type cvmodels:TrainedModelInfo}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Margin="12,0,0,0"
                                                       FontFamily="{StaticResource CvMonoFont}" FontSize="9"
                                                       Foreground="{DynamicResource CvTextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CvUiFont}" FontSize="12"
                                                       Foreground="{DynamicResource CvTextBrightBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- what the analysis will actually use -->
                            <Border Grid.Row="4" Style="{StaticResource CvInset}" Margin="0,10,0,0" Padding="13,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ModelSelection.SelectedModel.Name}" FontFamily="{StaticResource CvDisplayFont}"
                                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource CvTextBrightBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <DockPanel Style="{StaticResource CvKvRowTight}">
                                        <cvctl:CvTrackedText Label="MODEL" Style="{StaticResource CvKvKey}"/>
                                        <TextBlock Text="{Binding ModelSelection.SelectedModel.ModelLabel}" Style="{StaticResource CvKvValue}"
                                                   Foreground="{DynamicResource CvAccentBrush}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource CvKvRowTight}">
                                        <cvctl:CvTrackedText Label="STATES" Style="{StaticResource CvKvKey}"/>
                                        <TextBlock Text="{Binding ModelSelection.SelectedModel.StatesText}" Style="{StaticResource CvKvValue}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource CvKvRowTight}">
                                        <cvctl:CvTrackedText Label="STATUS" Style="{StaticResource CvKvKey}"/>
                                        <TextBlock Text="{Binding ModelSelection.SelectedModel.StatusText}" Style="{StaticResource CvKvValue}"
                                                   Foreground="{DynamicResource CvOkBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource CvButtonPrimary}" Height="38"
                                        Command="{Binding RunAnalysisCommand}"
                                        ToolTip="Run the analysis with the selected model">
                                    <cvctl:CvTrackedText Label="RUN ANALYSIS" FontFamily="{StaticResource CvDisplayFont}"
                                                         FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource CvButtonGhost}" Height="38" Padding="16,0"
                                        Command="{Binding CancelModelSelectionCommand}"
                                        ToolTip="Choose a different file">
                                    <cvctl:CvTrackedText Label="BACK" FontFamily="{StaticResource CvDisplayFont}"
                                                         FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Backend status: the one real value on this bar -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="18,0,18,16" Orientation="Horizontal">
            <cvctl:CvTrackedText Label="BACKEND" Style="{StaticResource CvCaps}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BackendStatusText}" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource CvMonoFont}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CvTextBrush}"/>
        </StackPanel>

    </Grid>
</UserControl>
