<UserControl
    x:Class="CANvision.Native.UI.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D00F1A1A" Offset="0"/>
                        <GradientStop Color="#D00A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#44009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="HudLbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3A6060"/>
        </Style>

        <Style x:Key="HudAccent" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#00C8C8"/>
        </Style>

        <Style x:Key="HudSoft" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#D0ECEC"/>
        </Style>

        <Style x:Key="RowLbl" TargetType="TextBlock" BasedOn="{StaticResource HudLbl}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#A0C8C8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SessionBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="Background" Value="#0A001818"/>
            <Setter Property="BorderBrush" Value="#2800C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16001818"/>
                                <Setter Property="BorderBrush" Value="#5000C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid Margin="40,24,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Header ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                               Foreground="#2A5050">
                        CANVISION
                    </TextBlock>
                    <TextBlock FontFamily="Bahnschrift" FontSize="26" FontWeight="Light"
                               Foreground="#00D7F8" Margin="0,2,0,0">
                        Intrusion Detection System
                    </TextBlock>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#08001818" BorderBrush="#1A009999"
                        BorderThickness="1" CornerRadius="2" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BACKEND" Style="{StaticResource HudLbl}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="Consolas" FontSize="10" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="OFFLINE"/>
                                    <Setter Property="Foreground" Value="#3A5050"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackendStatusText}" Value="CONNECTED">
                                            <Setter Property="Text" Value="CONNECTED"/>
                                            <Setter Property="Foreground" Value="#56F0AC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Live Session Hero ════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource HudPanel}" Padding="24,20"
                    BorderBrush="#5500C8C8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: description + buttons -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE MONITORING" Style="{StaticResource HudLbl}"/>
                        <TextBlock Text="Real-time CAN bus intrusion detection"
                                   FontFamily="Bahnschrift" FontSize="14" FontWeight="Light"
                                   Foreground="#B0DCDC" Margin="0,5,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <!-- Hero START button — solid cyan fill -->
                            <Button Height="36" Padding="22,0"
                                    FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"
                                    Foreground="#001818" Background="#00C8C8"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding StartSessionCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="2"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00DEDE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="▶  START LIVE SESSION"
                                           FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"/>
                            </Button>

                            <Button Content="STOP" Margin="10,0,0,0"
                                    Style="{StaticResource SessionBtn}"
                                    Foreground="#3A5050" BorderBrush="#10005050"
                                    Command="{Binding StopSessionCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#1A009999"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"/>

                    <!-- Right: session state -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="SESSION" Style="{StaticResource HudLbl}" HorizontalAlignment="Right"/>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                                   FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="IDLE"/>
                                    <Setter Property="Foreground" Value="#283E3E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveSessionActive}" Value="True">
                                            <Setter Property="Text" Value="● LIVE"/>
                                            <Setter Property="Foreground" Value="#56F0AC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Rectangle Height="1" Fill="#10009999" Margin="0,10,0,10"/>

                        <TextBlock Text="ML STATUS" Style="{StaticResource HudLbl}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding MlStatusText}"
                                   FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#00C8C8" HorizontalAlignment="Right"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="155"/>

                        <Rectangle Height="1" Fill="#10009999" Margin="0,10,0,10"/>

                        <TextBlock Text="ALERTS" Style="{StaticResource HudLbl}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotalAlertsText}"
                                   FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3A6060"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalAlertsText}" Value="--">
                                            <Setter Property="Foreground" Value="#283E3E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Bottom row: Offline Analysis | System Status ════════════════ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Offline Analysis panel -->
                <Border Grid.Column="0" Style="{StaticResource HudPanel}">
                    <StackPanel>
                        <TextBlock Text="OFFLINE ANALYSIS" Style="{StaticResource HudLbl}"/>
                        <Rectangle Height="1" Fill="#0A009999" Margin="0,8,0,8"/>

                        <TextBlock Text="DATASET" Style="{StaticResource HudLbl}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ImportedReplayName}"
                                   FontFamily="Bahnschrift" FontSize="11" Foreground="#D0ECEC"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                        <Button Content="IMPORT LOG FILE" Style="{StaticResource SessionBtn}"
                                HorizontalAlignment="Left"
                                Command="{Binding ImportReplayCommand}"/>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding ReadinessText}"
                                       FontFamily="Bahnschrift" FontSize="8"
                                       Foreground="#2A5050" HorizontalAlignment="Center"/>
                            <ProgressBar Height="2" Margin="0,5,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding AnalysisProgressPercent, Mode=OneWay}"
                                         Background="#08001818" BorderThickness="0"
                                         Foreground="#00C8C8"/>
                            <TextBlock Text="{Binding AnalysisProgressText}"
                                       FontFamily="Bahnschrift" FontSize="10"
                                       Foreground="#2A5050" HorizontalAlignment="Right"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- System Status panel -->
                <Border Grid.Column="2" Style="{StaticResource HudPanel}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM STATUS" Style="{StaticResource HudLbl}"/>
                        <Rectangle Height="1" Fill="#0A009999" Margin="0,8,0,8"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DATASET" Style="{StaticResource RowLbl}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DatasetStatusText}" Style="{StaticResource RowVal}"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FRAMES" Style="{StaticResource RowLbl}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FramesLoadedText}" Style="{StaticResource RowVal}"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CONNECTION" Style="{StaticResource RowLbl}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectivityText}" Style="{StaticResource RowVal}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ANALYSIS" Style="{StaticResource RowLbl}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AnalysisStatusText}" Style="{StaticResource RowVal}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Analysis Pipeline Strip ════════════════════════════════════ -->
            <Border Grid.Row="6" Background="#C80A1212" BorderBrush="#2A009999"
                    BorderThickness="1" CornerRadius="3" Padding="22,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <TextBlock Text="DATASET">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Bahnschrift"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#263E3E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="LOADING DATASET">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisProgressText}" Value="100.0%">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  →  " Foreground="#16004A4A"
                               FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>

                    <TextBlock Text="PARSE">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Bahnschrift"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#263E3E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="PARSING FRAMES">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisProgressText}" Value="100.0%">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  →  " Foreground="#16004A4A"
                               FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>

                    <TextBlock Text="INFERENCE">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Bahnschrift"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#263E3E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="EXTRACTING FEATURES">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="RUNNING ML ANALYSIS">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisProgressText}" Value="100.0%">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  →  " Foreground="#16004A4A"
                               FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>

                    <TextBlock Text="DETECTIONS">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Bahnschrift"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#263E3E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="GENERATING DETECTIONS">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisStatusText}" Value="BUILDING INTELLIGENCE">
                                        <Setter Property="Foreground" Value="#00C8C8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalysisProgressText}" Value="100.0%">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiveSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  →  " Foreground="#16004A4A"
                               FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>

                    <TextBlock Text="COMPLETE">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Bahnschrift"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#263E3E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanDiveIn}" Value="True">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- ══ Dive In ════════════════════════════════════════════════════ -->
            <Button Grid.Row="8" HorizontalAlignment="Center"
                    Style="{StaticResource HudHeroCapsuleButtonStyle}"
                    IsEnabled="{Binding CanDiveIn}"
                    Command="{Binding DataContext.NavigationService.EnterSystemCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Dive In"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="17" Text=">"/>
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>
