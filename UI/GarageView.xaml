<UserControl
    x:Class="CANvision.Native.UI.GarageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#101317">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Width="820"
            Height="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1D232B"
            BorderBrush="#2C3844"
            BorderThickness="2"
            CornerRadius="18">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#6C7A89"
                    FontSize="20"
                    Text="3D Car Placeholder" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,48" HorizontalAlignment="Center">
            <TextBlock
                Margin="0,0,0,20"
                Foreground="White"
                FontSize="42"
                FontWeight="Bold"
                Text="CANvisionNative" />
            <Button
                x:Name="EnterDiagnosticsButton"
                x:FieldModifier="public"
                Width="220"
                Height="48"
                Background="#0E639C"
                BorderBrush="#1C97EA"
                Foreground="White"
                Content="Enter Diagnostics" />
        </StackPanel>
    </Grid>
</UserControl>
