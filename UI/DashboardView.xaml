<!--
  ===========================================================================
  DASHBOARD  -  CANvision IDS master screen
  ===========================================================================
  Composition rebuilt against the CANvision reference:

    [ status ribbon ........................................... clock ]
    [ rail ] [ 6 KPI tiles ................................ ] [ obs.  ]
    [      ] [ operational state ] [ anomaly score trend    ] [ rail  ]
    [      ] [ active threat ] [ live CAN monitor ] [ quick ] [       ]
    [ bottom ribbon ......................................... sync  ]

  Presentation only. Every value binds to an existing DashboardViewModel
  property; nothing is fabricated. Panels with no data show an explicit
  empty state instead of placeholder numbers.

  Styles come from UI/Theme/DesignSystem.xaml + ScreenStyles.xaml.
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- status ribbon -->
            <RowDefinition Height="*"/>      <!-- body -->
            <RowDefinition Height="Auto"/>   <!-- bottom ribbon -->
        </Grid.RowDefinitions>

        <!-- Ambient wash, top-left, as in the reference frame -->
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ STATUS RIBBON ════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CvRibbon}" Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- link state: amber when offline, cyan when live -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource CvWarnBrush}"/>
                                <Setter Property="Effect" Value="{DynamicResource CvWarnGlow}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveStateText}" Value="LIVE">
                                        <Setter Property="Fill" Value="{DynamicResource CvAccentBrush}"/>
                                        <Setter Property="Effect" Value="{DynamicResource CvAccentGlow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <cv:CvTrackedText Label="{Binding LiveStateText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      FontFamily="{StaticResource CvMonoFont}" FontSize="11" FontWeight="SemiBold">
                        <cv:CvTrackedText.Style>
                            <Style TargetType="cv:CvTrackedText">
                                <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveStateText}" Value="LIVE">
                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cv:CvTrackedText.Style>
                    </cv:CvTrackedText>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="14" Margin="18,0" Fill="{DynamicResource CvBorderAccentBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="IDS"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonValue}" Label="{Binding OperationalStateText}"
                                      Foreground="{DynamicResource CvAccentBrush}"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="PPS" Margin="26,0,0,0"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonValue}" Label="{Binding RuntimeFpsText}"/>
                    <cv:CvTrackedText Label="{Binding LastSyncSummaryText}" Margin="26,0,0,0"
                                      VerticalAlignment="Center" FontFamily="{StaticResource CvMonoFont}" FontSize="11">
                        <cv:CvTrackedText.Style>
                            <Style TargetType="cv:CvTrackedText">
                                <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastSyncSummaryText}" Value="ALL SYSTEMS SYNCED">
                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cv:CvTrackedText.Style>
                    </cv:CvTrackedText>
                </StackPanel>

                <cv:CvTrackedText Grid.Column="3" Label="{Binding LastEventTimestamp}" VerticalAlignment="Center"
                                  FontFamily="{StaticResource CvMonoFont}" FontSize="12" FontWeight="SemiBold"
                                  Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT RAIL ─────────────────────────────────────────── -->
            <StackPanel Grid.Column="0">
                <!-- current module -->
                <Border Style="{StaticResource CvRailActive}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource CvSectionMarker}" Height="14"/>
                        <cv:CvTrackedText Label="DASHBOARD" Style="{StaticResource CvRailText}"
                                          Foreground="{DynamicResource CvTextBrightBrush}"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource NavBtn}" Margin="0,8,0,0"
                        Command="{Binding DataContext.NavigationService.NavigateToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static models:SectionKey.Telemetry}">
                    <Border Style="{StaticResource CvRailItem}">
                        <cv:CvTrackedText Label="TELEMETRY" Style="{StaticResource CvRailText}"/>
                    </Border>
                </Button>

                <Button Style="{StaticResource NavBtn}" Margin="0,8,0,0"
                        Command="{Binding DataContext.NavigationService.NavigateToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static models:SectionKey.LogPlayback}">
                    <Border Style="{StaticResource CvRailItem}">
                        <cv:CvTrackedText Label="LOG PLAYBACK" Style="{StaticResource CvRailText}"/>
                    </Border>
                </Button>

                <!-- session -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <cv:CvTrackedText Label="SESSION" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding SessionStateText}" Margin="0,7,0,0"
                                   FontFamily="{StaticResource CvDisplayFont}" FontSize="15" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                    <Setter Property="Effect" Value="{DynamicResource CvWarnGlow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSessionRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                            <Setter Property="Effect" Value="{DynamicResource CvAccentGlowSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Margin="0,9,0,0" Height="3" Minimum="0" Maximum="100"
                                     Value="{Binding ReplayProgressPercent, Mode=OneWay}"
                                     Style="{StaticResource CvProgressBar}"
                                     Foreground="{DynamicResource CvWarnBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <cv:CvTrackedText Label="ELAPSED" Style="{StaticResource CvCaps}"/>
                            <cv:CvTrackedText Label="{Binding ReplayElapsedText}" Style="{StaticResource CvCaps}" Margin="7,0,0,0"
                                              Foreground="{DynamicResource CvTextSoftBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- offline analysis -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <cv:CvTrackedText Label="OFFLINE ANALYSIS" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="Import CSV from Home" Margin="0,7,0,0"
                                   FontFamily="{StaticResource CvDisplayFont}" FontSize="12.5"
                                   Foreground="{DynamicResource CvTextSoftBrush}"/>
                    </StackPanel>
                </Border>

                <!-- system -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <cv:CvTrackedText Label="SYSTEM" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding SystemNameText}" Margin="0,7,0,0"
                                   FontFamily="{StaticResource CvDisplayFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CvTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <cv:CvTrackedText Label="{Binding RuntimeStateText}" Style="{StaticResource CvCaps}" Margin="0,7,0,0"
                                          Foreground="{DynamicResource CvTextSoftBrush}" TextTrimming="CharacterEllipsis"/>
                        <cv:CvTrackedText Label="{Binding LastSyncSummaryText}" Style="{StaticResource CvCaps}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ─── CENTRE ────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="5*" MinHeight="250"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="4.4*" MinHeight="230"/>
                </Grid.RowDefinitions>

                <!-- KPI strip: 6 tiles, 2px accent rule on top, per reference -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding DashboardTopKpis}" Margin="-5,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AnalysisKpiItem}">
                            <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                                <Grid>
                                    <Rectangle Height="2" VerticalAlignment="Top"
                                               Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF000000" Offset="0"/>
                                                <GradientStop Color="#22000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <StackPanel Margin="12,11,10,0">
                                        <cv:CvTrackedText Label="{Binding Label}" Style="{StaticResource CvCaps}" FontSize="10"/>
                                        <TextBlock x:Name="KpiVal" Text="{Binding Value}" Margin="0,8,0,0"
                                                   FontFamily="{StaticResource CvDisplayFont}" FontSize="23" FontWeight="Bold"
                                                   Foreground="{DynamicResource CvTextBrightBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <cv:CvTrackedText Label="{Binding Meta}" Style="{StaticResource CvCaps}" Margin="0,7,0,0"
                                                          Foreground="{DynamicResource CvTextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Label}" Value="FUSION SCORE">
                                    <Setter TargetName="KpiVal" Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    <Setter TargetName="KpiVal" Property="Effect" Value="{DynamicResource CvAccentGlowSoft}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Label}" Value="CRITICAL ALERTS">
                                    <Setter TargetName="KpiVal" Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                    <Setter TargetName="KpiVal" Property="Effect" Value="{DynamicResource CvDangerGlow}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Label}" Value="LATENCY">
                                    <Setter TargetName="KpiVal" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                    <Setter TargetName="KpiVal" Property="Effect" Value="{DynamicResource CvWarnGlow}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- operational state + anomaly trend -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.46*" MinWidth="300" MaxWidth="400"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- OPERATIONAL STATE -->
                    <Border Grid.Column="0" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.36" GradientOrigin="0.5,0.36" RadiusX="0.55" RadiusY="0.42">
                                <GradientStop Color="#242FF0D6" Offset="0"/>
                                <GradientStop Color="#000A1416" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Grid Margin="18,16,18,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <cv:CvTrackedText Label="OPERATIONAL STATE" Style="{StaticResource CvCaps}"/>

                            <!-- dial: two guide rings + a lit arc in the state colour -->
                            <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="150" Margin="0,8">
                                <Grid Width="150" Height="150">
                                    <Ellipse Stroke="#4D2FF0D6" StrokeThickness="1"/>
                                    <Ellipse Margin="15" Stroke="#242FF0D6" StrokeThickness="1"/>
                                    <Ellipse Stroke="{Binding OperationalStateColor, Converter={StaticResource HexColorToBrushConverter}}"
                                             StrokeThickness="2" StrokeDashArray="58 177" StrokeDashCap="Flat"
                                             RenderTransformOrigin="0.5,0.5" Effect="{DynamicResource CvAccentGlow}">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-134"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <cv:CvTrackedText Label="{Binding ThreatSeverityText}" HorizontalAlignment="Center"
                                                          FontFamily="{StaticResource CvDisplayFont}" FontSize="14" FontWeight="Bold"
                                                          Foreground="{Binding OperationalStateColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                          Effect="{DynamicResource CvAccentGlowSoft}"/>
                                        <cv:CvTrackedText Label="THREAT LEVEL" Style="{StaticResource CvCaps}" FontSize="9"
                                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,14">
                                <cv:CvTrackedText Label="{Binding OperationalStateText}" HorizontalAlignment="Center"
                                                  FontFamily="{StaticResource CvDisplayFont}" FontSize="25" FontWeight="Bold"
                                                  Foreground="{DynamicResource CvTextBrightBrush}"
                                                  Effect="{DynamicResource CvAccentGlow}"/>
                                <cv:CvTrackedText Label="{Binding ThreatSummaryText}" Style="{StaticResource CvCaps}" FontSize="9"
                                                  HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 4-cell stat strip separated by hairlines -->
                            <Border Grid.Row="3" BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource CvStatCell}" BorderThickness="0">
                                        <StackPanel>
                                            <cv:CvTrackedText Label="LAST DET" Style="{StaticResource CvStatKey}"/>
                                            <TextBlock Text="{Binding LastAnomalyTimestamp}" Style="{StaticResource CvStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CvStatCell}">
                                        <StackPanel>
                                            <cv:CvTrackedText Label="TOP ID" Style="{StaticResource CvStatKey}"/>
                                            <TextBlock Text="{Binding TopAnomalousCanId}" Style="{StaticResource CvStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CvStatCell}">
                                        <StackPanel>
                                            <cv:CvTrackedText Label="SCORE" Style="{StaticResource CvStatKey}"/>
                                            <TextBlock Text="{Binding AnomalyScoreText}" Style="{StaticResource CvStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CvStatCell}">
                                        <StackPanel>
                                            <cv:CvTrackedText Label="CONF" Style="{StaticResource CvStatKey}"/>
                                            <TextBlock Text="{Binding AnomalyConfidenceText}" Style="{StaticResource CvStatValue}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ANOMALY SCORE TREND -->
                    <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                        <Grid Margin="18,14,18,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"/>
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="ANOMALY SCORE TREND" Style="{StaticResource CvPanelTitle}"/>
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="{Binding TrendDirectionText}" Style="{StaticResource CvCaps}"
                                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="· 60 S WINDOW" Style="{StaticResource CvCaps}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <cv:CvTrackedText DockPanel.Dock="Right" Label="— ALERT 0.55" Style="{StaticResource CvCaps}"
                                                  Foreground="{DynamicResource CvWarnBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <cv:CvTrackedText DockPanel.Dock="Right" Label="— CRITICAL 0.80" Style="{StaticResource CvCaps}"
                                                  Foreground="{DynamicResource CvDangerBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- plot. Y domain is the ViewModel's 0-1.5 score range over a
                                 540x116 point space; the rows below place the threshold
                                 rules at their true positions in that domain
                                 (0.80 -> 46.7% from top, 0.55 -> 63.3%). The rolling
                                 buffer is 120 ticks x 500 ms = 60 s. -->
                            <Grid Grid.Row="1" Margin="0,16,0,8">
                                <!-- faint grid -->
                                <UniformGrid Rows="4" IsHitTestVisible="False">
                                    <Border BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,1"/>
                                </UniformGrid>

                                <!-- thresholds -->
                                <Grid IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="46.67*"/>
                                        <RowDefinition Height="16.66*"/>
                                        <RowDefinition Height="36.67*"/>
                                    </Grid.RowDefinitions>
                                    <Line Grid.Row="1" VerticalAlignment="Top" X1="0" X2="1" Stretch="Fill"
                                          Stroke="{DynamicResource CvDangerBrush}" StrokeThickness="1"
                                          StrokeDashArray="6 7" Opacity="0.55"/>
                                    <Line Grid.Row="2" VerticalAlignment="Top" X1="0" X2="1" Stretch="Fill"
                                          Stroke="{DynamicResource CvWarnBrush}" StrokeThickness="1"
                                          StrokeDashArray="6 7" Opacity="0.55"/>
                                </Grid>

                                <!-- data -->
                                <Viewbox Stretch="Fill" ClipToBounds="True">
                                    <Canvas Width="540" Height="116">
                                        <Polygon Points="{Binding DashboardAnomalyFillPoints}">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#572FF0D6" Offset="0"/>
                                                    <GradientStop Color="#002FF0D6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <Polyline Points="{Binding DashboardAnomalyPoints}"
                                                  Stroke="{DynamicResource CvAccentBrush}" StrokeThickness="0.9"
                                                  StrokeLineJoin="Round" Effect="{DynamicResource CvAccentGlow}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <!-- x axis: 60 s window in 15 s steps -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <cv:CvTrackedText Grid.Column="0" Label="-60 S" Style="{StaticResource CvCaps}"/>
                                <cv:CvTrackedText Grid.Column="1" Label="-45 S" Style="{StaticResource CvCaps}"/>
                                <cv:CvTrackedText Grid.Column="2" Label="-30 S" Style="{StaticResource CvCaps}"/>
                                <cv:CvTrackedText Grid.Column="3" Label="-15 S" Style="{StaticResource CvCaps}"/>
                                <cv:CvTrackedText Grid.Column="3" Label="NOW" Style="{StaticResource CvCaps}"
                                                  HorizontalAlignment="Right" Foreground="{DynamicResource CvAccentDimBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- active threat · CAN monitor · quick stats -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*" MinWidth="220" MaxWidth="290"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.27*" MinWidth="200" MaxWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- ACTIVE THREAT -->
                    <Border Grid.Column="0" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderDangerBrush}" Background="{DynamicResource CvThreatCardBrush}">
                        <StackPanel Margin="18,15,16,14">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CvSectionMarker}" Fill="{DynamicResource CvDangerBrush}"
                                           Effect="{DynamicResource CvDangerGlow}"/>
                                <cv:CvTrackedText Label="ACTIVE THREAT" Style="{StaticResource CvPanelTitle}" Foreground="{DynamicResource CvThreatTitleBrush}"/>
                            </StackPanel>
                            <cv:CvTrackedText Label="CURRENT" Style="{StaticResource CvCaps}" Margin="0,16,0,0"/>
                            <TextBlock Text="{Binding CurrentThreatText}" Margin="0,6,0,0"
                                       FontFamily="{StaticResource CvDisplayFont}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource CvTextBrightBrush}" TextTrimming="CharacterEllipsis"/>
                            <Rectangle Height="1" Margin="0,14,0,12">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4DFF4D5E" Offset="0"/>
                                        <GradientStop Color="#00FF4D5E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <cv:CvTrackedText Label="SEVERITY" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Label="{Binding ThreatSeverityText}" Margin="0,5,0,0"
                                                      FontFamily="{StaticResource CvMonoFont}" FontSize="12" FontWeight="Bold">
                                        <cv:CvTrackedText.Style>
                                            <Style TargetType="cv:CvTrackedText">
                                                <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThreatSeverityText}" Value="HIGH">
                                                        <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ThreatSeverityText}" Value="CRITICAL">
                                                        <Setter Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </cv:CvTrackedText.Style>
                                    </cv:CvTrackedText>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <cv:CvTrackedText Label="SCORE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding AnomalyScoreText}" Style="{StaticResource CvStatValue}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <cv:CvTrackedText Label="TOP CAN ID" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding AffectedCanIdsText}" Style="{StaticResource CvStatValue}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <cv:CvTrackedText Label="ATTACK TYPE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding AttackTypeText}" Style="{StaticResource CvStatValue}" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource CvTextSoftBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LIVE CAN BUS MONITOR -->
                    <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                                    <cv:CvTrackedText DockPanel.Dock="Left" Label="LIVE CAN BUS MONITOR" Style="{StaticResource CvPanelTitle}"
                                                      Margin="9,0,0,0"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LiveFrames.Count}" FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                                   Foreground="{DynamicResource CvTextSoftBrush}"/>
                                        <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvCaps}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- column heads -->
                            <Border Grid.Row="1" Background="{DynamicResource CvTableHeadBrush}" Padding="16,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <cv:CvTrackedText Grid.Column="0" Label="TIME" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="1" Label="CAN ID" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="2" Label="PAYLOAD BYTES (HEX)" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="3" Label="SCORE" Style="{StaticResource CvCaps}" FontSize="9"
                                                      HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- rows -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding LiveFrames}" ClipToBounds="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LiveFrameRow}">
                                        <Border Style="{StaticResource CvTableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="54"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvTextSoftBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CanId}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvAccentBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Bytes}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvTextBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Score}" Style="{StaticResource CvCell}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- empty state -->
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveFrames.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Center"
                                        BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="1">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/>
                                </Border>
                                <cv:CvTrackedText Label="NO FRAMES IN BUFFER" Style="{StaticResource CvCaps}"
                                                  HorizontalAlignment="Center" Margin="0,11,0,0"/>
                                <TextBlock Text="Frames stream here while a replay or live session runs."
                                           Margin="0,6,0,0" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                           Foreground="{DynamicResource CvTextFaintBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- IDS QUICK STATS -->
                    <Border Grid.Column="4" Style="{StaticResource CardFlush}">
                        <StackPanel Margin="18,15,16,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Style="{StaticResource CvSectionMarker}" Fill="{DynamicResource CvVioletBrush}"
                                           Effect="{DynamicResource CvVioletGlow}"/>
                                <cv:CvTrackedText Label="IDS QUICK STATS" Style="{StaticResource CvPanelTitle}"/>
                            </StackPanel>

                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="LIVE FPS" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding RuntimeFpsText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding LatencyMsText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvWarnBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding PacketsAnalyzedText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="ALERTS" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding TotalAlertsText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="CRITICAL" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding CriticalAlertsText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvDangerBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="IDS STATE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding OperationalStateText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvAccentBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="PIPELINE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding PipelineHealthText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CvKvValue}">
                                            <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PipelineHealthText}" Value="Degraded">
                                                    <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ─── RIGHT RAIL: OBSERVABILITY ─────────────────────────── -->
            <StackPanel Grid.Column="4">
                <Border Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                    <StackPanel Margin="16,15,16,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Rectangle Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText Label="OBSERVABILITY" Style="{StaticResource CvPanelTitle}"/>
                        </StackPanel>

                        <!-- session status -->
                        <Border Style="{StaticResource CvObsBlock}">
                            <StackPanel>
                                <cv:CvTrackedText Label="SESSION STATUS" Style="{StaticResource CvCaps}" FontSize="9" Margin="0,0,0,8"/>
                                <DockPanel Style="{StaticResource CvKvRowTight}">
                                    <cv:CvTrackedText Label="STATUS" Style="{StaticResource CvKvKey}"/>
                                    <TextBlock Text="{Binding ReplayStatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CvKvValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReplayStatusText}" Value="RUNNING">
                                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReplayStatusText}" Value="COMPLETE">
                                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel Style="{StaticResource CvKvRowTight}">
                                    <cv:CvTrackedText Label="DURATION" Style="{StaticResource CvKvKey}"/>
                                    <TextBlock Text="{Binding ReplayElapsedText}" Style="{StaticResource CvKvValue}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource CvKvRowTight}">
                                    <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvKvKey}"/>
                                    <TextBlock Text="{Binding ReplayFramesText}" Style="{StaticResource CvKvValue}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- model status -->
                        <Border Style="{StaticResource CvObsBlock}" Margin="0,10,0,0">
                            <StackPanel>
                                <cv:CvTrackedText Label="MODEL STATUS" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding ActiveModelName}" Margin="0,7,0,0"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource CvTextBrightBrush}"/>
                                <Border Height="3" Margin="0,10,0,0" CornerRadius="1.5" Background="{DynamicResource CvTableHeadBrush}">
                                    <Border CornerRadius="1.5" HorizontalAlignment="Stretch" Effect="{DynamicResource CvAccentGlowSoft}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CvTextFaintBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModelHealthText}" Value="100%">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#4D2FF0D6" Offset="0"/>
                                                                    <GradientStop Color="#FF2FF0D6" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <cv:CvTrackedText Label="HEALTH" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Label="{Binding ModelHealthText}" Style="{StaticResource CvCaps}" FontSize="9"
                                                      Margin="7,0,0,0" Foreground="{DynamicResource CvTextSoftBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- detection confidence -->
                        <Border Style="{StaticResource CvObsBlock}" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource CvBorderVioletBrush}">
                            <Border.Background>
                                <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.8" RadiusY="1.1">
                                    <GradientStop Color="#2EB07BFF" Offset="0"/>
                                    <GradientStop Color="#05FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <cv:CvTrackedText Label="DETECTION CONFIDENCE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding AnomalyConfidenceText}" Margin="0,8,0,0"
                                           FontFamily="{StaticResource CvDisplayFont}" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource CvVioletSoftBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                                <ProgressBar Margin="0,10,0,0" Height="3" Minimum="0" Maximum="100"
                                             Value="{Binding DetectionConfidenceValue, Mode=OneWay}"
                                             Style="{StaticResource CvProgressBar}"
                                             Foreground="{DynamicResource CvVioletBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- live alerts -->
                        <Border Style="{StaticResource CvObsBlock}" Margin="0,10,0,0">
                            <StackPanel>
                                <cv:CvTrackedText Label="LIVE ALERTS" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding LiveAlertsCountText}"
                                               FontFamily="{StaticResource CvDisplayFont}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource CvTextBrightBrush}"/>
                                    <cv:CvTrackedText Label="IN SESSION" Style="{StaticResource CvCaps}"
                                                      Margin="9,0,0,3" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <DockPanel Style="{StaticResource CvKvRowTight}" Margin="0,8,0,0">
                                    <cv:CvTrackedText Label="LAST SYNC" Style="{StaticResource CvKvKey}"/>
                                    <TextBlock Text="{Binding LastEventTimestamp}" Style="{StaticResource CvKvValue}"
                                               Foreground="{DynamicResource CvTextSoftBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- detection rate -->
                <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0">
                    <StackPanel Margin="16,14,16,14">
                        <cv:CvTrackedText Label="DETECTION RATE · SESSION" Style="{StaticResource CvCaps}" FontSize="9"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                            <TextBlock Text="{Binding DetectionRateText}"
                                       FontFamily="{StaticResource CvDisplayFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <TextBlock Margin="9,0,0,4" VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                       Foreground="{DynamicResource CvTextMutedBrush}">
                                <Run Text="{Binding TotalAlertsText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding PacketsAnalyzedText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding DetectionRateBasisText}" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                   Foreground="{DynamicResource CvTextMutedBrush}" TextWrapping="Wrap" Margin="0,-6,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetectionRateBasisText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 20 x 6 s alert-count buckets (last 120 s), from AlertTrendBars -->
                        <ItemsControl ItemsSource="{Binding AlertTrendBars}" Height="44">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Margin="1.5,0" VerticalAlignment="Bottom"
                                               Height="{Binding Converter={StaticResource ScaleConverter}, ConverterParameter=0.26}"
                                               Fill="#8C2FF0D6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,7,0,0" LastChildFill="False">
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="-120 S" Style="{StaticResource CvCaps}" FontSize="8.5"/>
                            <cv:CvTrackedText DockPanel.Dock="Right" Label="ALERT HISTORY" Style="{StaticResource CvCaps}" FontSize="8.5"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ BOTTOM RIBBON ════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="16,12,16,10" Padding="14,0" Height="30"
                Background="{DynamicResource CvOverlay06Brush}" BorderBrush="{DynamicResource CvBorderBrush}" BorderThickness="1" CornerRadius="3">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <cv:CvTrackedText DockPanel.Dock="Left" Label="SOURCE" Style="{StaticResource CvCaps}"/>
                <cv:CvTrackedText DockPanel.Dock="Left" Label="{Binding ActiveReplayFile}" Style="{StaticResource CvCaps}"
                                  Margin="7,0,0,0" Foreground="{DynamicResource CvTextSoftBrush}" Upper="False" MaxWidth="320"
                                  TextTrimming="CharacterEllipsis"/>
                <cv:CvTrackedText DockPanel.Dock="Left" Label="ATTACK" Style="{StaticResource CvCaps}" Margin="24,0,0,0"/>
                <cv:CvTrackedText DockPanel.Dock="Left" Label="{Binding DetectedAttackType}" Style="{StaticResource CvCaps}"
                                  Margin="7,0,0,0" Foreground="{DynamicResource CvTextSoftBrush}"/>
                <cv:CvTrackedText DockPanel.Dock="Left" Label="FPS" Style="{StaticResource CvCaps}" Margin="24,0,0,0"/>
                <cv:CvTrackedText DockPanel.Dock="Left" Label="{Binding RuntimeFpsText}" Style="{StaticResource CvCaps}"
                                  Margin="7,0,0,0" Foreground="{DynamicResource CvTextSoftBrush}"/>
                <cv:CvTrackedText DockPanel.Dock="Right" Label="{Binding LastEventTimestamp}" Style="{StaticResource CvCaps}"
                                  Margin="7,0,0,0" Foreground="{DynamicResource CvTextSoftBrush}"/>
                <cv:CvTrackedText DockPanel.Dock="Right" Label="LAST SYNC" Style="{StaticResource CvCaps}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
