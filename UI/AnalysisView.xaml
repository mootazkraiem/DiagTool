<UserControl
    x:Class="CANvision.Native.UI.AnalysisView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Connection:" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="Disconnected" Foreground="#FF8080" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Model:" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="Vehicle / Generic" Foreground="#CFCFCF" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Source:" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="No source selected" Foreground="#CFCFCF" />
                </StackPanel>
                <Button Grid.Column="3" Width="90" Margin="0,0,10,0" Content="Start" />
                <Button Grid.Column="4" Width="90" Content="Stop" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Padding="16" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Control Panel" Foreground="#00B7FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Text="Vehicle" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="Kia EV6" Margin="0,4,0,14" Foreground="#CFCFCF" />
                    <TextBlock Text="Data Source" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="File: sample.mf4" Margin="0,4,0,20" Foreground="#CFCFCF" />
                    <Button Content="Start" />
                    <Button Content="Stop" />
                    <Button Content="Re-run Analysis" />
                    <Button Content="Export Results" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="0,0,12,0" Padding="14" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8">
                <TabControl Background="#2A2A2A" BorderBrush="#3A3A3A" Foreground="White">
                    <TabItem Header="Live Signals">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Real-time CAN Signals" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                            <Border Grid.Row="1" Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                                <Canvas Margin="10" />
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Anomalies">
                        <Grid Margin="10">
                            <DataGrid AutoGenerateColumns="False" Background="#222222" Foreground="White" BorderBrush="#3A3A3A" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*" />
                                    <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId}" Width="*" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Features">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Feature Visualization" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                            <Border Grid.Row="1" Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                                <Grid />
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Details" Foreground="#00B7FF" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Text="Selected CAN ID" Foreground="White" FontWeight="Bold" />
                    <TextBlock Text="0x1A0" Margin="0,4,0,16" Foreground="#CFCFCF" />
                    <TextBlock Text="Statistics" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mean" Foreground="White" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Foreground="#CFCFCF" Text="-" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Std" Foreground="White" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Foreground="#CFCFCF" Text="-" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency" Foreground="White" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Foreground="#CFCFCF" Text="-" />
                    </Grid>
                    <TextBlock Text="Anomaly Details" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" />
                    <Border Padding="10" Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="Select an anomaly row to view details." Foreground="#CFCFCF" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
