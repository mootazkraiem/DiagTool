<!--
  ===========================================================================
  TELEMETRY  -  CANvision IDS
  ===========================================================================
  Composition rebuilt against the CANvision reference, in the visual
  language of the approved Dashboard:

    [ status ribbon ........................................... clock ]
    [ stream  ] [ 5 channel tiles (value + LiveCharts trace) ] [ stream ]
    [ replay  ] [ signal channels (4 LiveCharts traces)       ] [ health ]
    [ session ] [ live signal monitor      ] [ CAN-ID activity ] [ ids    ]
    [ runtime ] [                          ] [                 ] [ events ]

  Presentation only. Every value binds to an existing TelemetryViewModel
  property; traces are the ViewModel's real rolling histories (80 samples
  per channel). Nothing is fabricated; empty buffers show an empty state.
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.TelemetryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- status ribbon -->
            <RowDefinition Height="*"/>      <!-- body -->
        </Grid.RowDefinitions>

        <!-- Ambient wash, top-left, as on the Dashboard -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ STATUS RIBBON ════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CvRibbon}" Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource CvWarnBrush}"/>
                                <Setter Property="Effect" Value="{DynamicResource CvWarnGlow}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveStateText}" Value="LIVE">
                                        <Setter Property="Fill" Value="{DynamicResource CvAccentBrush}"/>
                                        <Setter Property="Effect" Value="{DynamicResource CvAccentGlow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <cv:CvTrackedText Label="{Binding LiveStateText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      FontFamily="{StaticResource CvMonoFont}" FontSize="11" FontWeight="SemiBold">
                        <cv:CvTrackedText.Style>
                            <Style TargetType="cv:CvTrackedText">
                                <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveStateText}" Value="LIVE">
                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cv:CvTrackedText.Style>
                    </cv:CvTrackedText>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="14" Margin="18,0" Fill="{DynamicResource CvBorderAccentBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="STATUS"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonValue}" Label="{Binding ConnectionStateText}"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="REPLAY" Margin="26,0,0,0"/>
                    <cv:CvTrackedText Label="{Binding ReplayStatusText}" Margin="8,0,0,0">
                        <cv:CvTrackedText.Style>
                            <Style TargetType="cv:CvTrackedText" BasedOn="{StaticResource CvRibbonKey}">
                                <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReplayStatusText}" Value="RUNNING">
                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cv:CvTrackedText.Style>
                    </cv:CvTrackedText>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="{Binding ReplayNameText}" Upper="False"
                                      Margin="26,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <cv:CvTrackedText Grid.Column="3" Label="{Binding LastEventTimestamp}" VerticalAlignment="Center"
                                  FontFamily="{StaticResource CvMonoFont}" FontSize="12" FontWeight="SemiBold"
                                  Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: CONTROL RAIL ────────────────────────────────── -->
            <StackPanel Grid.Column="0">

                <!-- stream control -->
                <Border Style="{StaticResource CvRailCard}">
                    <StackPanel>
                        <cv:CvTrackedText Label="STREAM CONTROL" Style="{StaticResource CvCaps}" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource CvButtonPrimary}" Height="36" Command="{Binding ResumeStreamCommand}">
                            <cv:CvTrackedText Label="START SESSION" FontFamily="{StaticResource CvDisplayFont}"
                                              FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource CvButtonGhost}" Height="36" Margin="0,8,0,0" Command="{Binding FreezeStreamCommand}">
                            <cv:CvTrackedText Label="STOP SESSION" FontFamily="{StaticResource CvDisplayFont}"
                                              FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- replay transport -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <cv:CvTrackedText Label="REPLAY CONTROL" Style="{StaticResource CvCaps}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource CvButtonTransport}" Height="34" Margin="0,0,4,0"
                                    Command="{Binding ResumeStreamCommand}" IsEnabled="{Binding HasReplayLoaded}"
                                    ToolTip="Starts live bus polling (live session). Offline replay playback is driven from Log Playback." Content="&#x25B6;"/>
                            <Button Style="{StaticResource CvButtonTransport}" Height="34" Margin="4,0,0,0"
                                    Command="{Binding FreezeStreamCommand}" IsEnabled="{Binding HasReplayLoaded}"
                                    ToolTip="Stops live bus polling." Content="&#x275A;&#x275A;"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- session -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,10,0,0" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                    <StackPanel>
                        <cv:CvTrackedText Label="SESSION" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding ReplayNameText}" Margin="0,7,0,0"
                                   FontFamily="{StaticResource CvDisplayFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Margin="0,10,0,6" Height="3" Minimum="0" Maximum="100"
                                     Value="{Binding ReplayProgressPercent, Mode=OneWay}"
                                     Style="{StaticResource CvProgressBar}"/>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="LOG SPAN" Style="{StaticResource CvKvKey}" FontSize="9"
                                              ToolTip="Time span of the loaded log (last frame minus first frame)"/>
                            <TextBlock Text="{Binding SessionDurationText}" Style="{StaticResource CvKvValue}" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding RuntimeReplayFramesText}" Style="{StaticResource CvKvValue}" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="PROGRESS" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding RuntimeReplayProgressText}" Style="{StaticResource CvKvValue}" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="REPLAY FPS" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding ReplayFpsText}" Style="{StaticResource CvKvValue}" FontSize="11" ToolTip="Runtime FPS. Offline replay: throughput of the import analysis pass (frames / analysis time), fixed after analysis. Live session: bus FPS reported by the backend."/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="DROPPED" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource CvKvValue}" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- runtime -->
                <Border Style="{StaticResource CvRailCard}" Margin="0,10,0,0" BorderBrush="{DynamicResource CvBorderWarnBrush}" Background="{DynamicResource CvRuntimeCardBrush}">
                    <StackPanel>
                        <cv:CvTrackedText Label="RUNTIME" Style="{StaticResource CvCaps}"/>
                        <cv:CvTrackedText Label="{Binding ConnectionStateText}" Margin="0,7,0,8"
                                          FontFamily="{StaticResource CvDisplayFont}" FontSize="13" FontWeight="Bold">
                            <cv:CvTrackedText.Style>
                                <Style TargetType="cv:CvTrackedText">
                                    <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                    <Setter Property="Effect" Value="{DynamicResource CvWarnGlow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStateText}" Value="CONNECTED">
                                            <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                            <Setter Property="Effect" Value="{DynamicResource CvAccentGlowSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </cv:CvTrackedText.Style>
                        </cv:CvTrackedText>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding ReplayLatencyText}" Style="{StaticResource CvKvValue}" FontSize="11" ToolTip="Runtime latency. Offline replay: total backend ML analysis time for the loaded log. Live session: measured round-trip of each /vehicle poll."/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="LAST PACKET" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding LastEventTimestamp}" Style="{StaticResource CvKvValue}" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="MODE" Style="{StaticResource CvKvKey}" FontSize="9"/>
                            <TextBlock Text="{Binding UnitNameText}" Style="{StaticResource CvKvValue}" FontSize="10.5"
                                       Foreground="{DynamicResource CvTextSoftBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ─── CENTRE ────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="116"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                </Grid.RowDefinitions>

                <!-- channel tiles: value + real rolling trace -->
                <UniformGrid Grid.Row="0" Rows="1" Columns="5" Margin="-5,0">
                    <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                        <Grid>
                            <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentBrush}"/>
                            <cv:CvSparkChart Tag="{Binding SpeedTelemetryValueText}" Values="{Binding SpeedHistory}" StrokeHex="#2FF0D6" Style="{StaticResource CvTileSpark}"/>
                            <StackPanel Margin="12,11,10,0">
                                <cv:CvTrackedText Label="SPEED" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding SpeedTelemetryValueText}" Style="{StaticResource CvTileValue}"/>
                                <cv:CvTrackedText Label="{Binding SpeedTelemetryStateText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                        <Grid>
                            <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvVioletBrush}"/>
                            <cv:CvSparkChart Tag="{Binding VoltageTelemetryValueText}" Values="{Binding VoltageHistory}" StrokeHex="#B07BFF" Style="{StaticResource CvTileSpark}"/>
                            <StackPanel Margin="12,11,10,0">
                                <cv:CvTrackedText Label="VOLTAGE" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding VoltageTelemetryValueText}" Style="{StaticResource CvTileValue}"/>
                                <cv:CvTrackedText Label="{Binding VoltageTelemetryStateText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                        <Grid>
                            <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentSoftBrush}"/>
                            <cv:CvSparkChart Tag="{Binding CurrentTelemetryValueText}" Values="{Binding CurrentHistory}" StrokeHex="#7EF7E4" Style="{StaticResource CvTileSpark}"/>
                            <StackPanel Margin="12,11,10,0">
                                <cv:CvTrackedText Label="CURRENT" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding CurrentTelemetryValueText}" Style="{StaticResource CvTileValue}"/>
                                <cv:CvTrackedText Label="{Binding CurrentTelemetryStateText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                        <Grid>
                            <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvWarnBrush}"/>
                            <cv:CvSparkChart Tag="{Binding MotorTempTelemetryValueText}" Values="{Binding MotorTempHistory}" StrokeHex="#FFB245" Style="{StaticResource CvTileSpark}"/>
                            <StackPanel Margin="12,11,10,0">
                                <cv:CvTrackedText Label="MOTOR TEMP" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding MotorTempTelemetryValueText}" Style="{StaticResource CvTileValue}"/>
                                <cv:CvTrackedText Label="{Binding MotorTempTelemetryStateText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CvKpiTile}" Margin="5,0" ToolTip="Runtime FPS. Offline replay: throughput of the import analysis pass (frames / analysis time), fixed after analysis. Live session: bus FPS reported by the backend.">
                        <Grid>
                            <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentBrush}"/>
                            <cv:CvSparkChart Tag="{Binding PacketsPerSecondTelemetryValueText}" Values="{Binding PacketRateHistory}" StrokeHex="#2FF0D6" Style="{StaticResource CvTileSpark}"/>
                            <StackPanel Margin="12,11,10,0">
                                <cv:CvTrackedText Label="PACKETS / SEC" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding PacketsPerSecondTelemetryValueText}" Style="{StaticResource CvTileValue}"
                                           Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                                <cv:CvTrackedText Label="{Binding PacketsPerSecondTelemetryStateText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- SIGNAL CHANNELS: four real rolling traces -->
                <Border Grid.Row="2" Style="{StaticResource CardFlush}">
                    <StackPanel Margin="18,14,18,8">
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="SIGNAL CHANNELS" Style="{StaticResource CvPanelTitle}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="SPEED · SOC · TEMP · VOLTAGE" Style="{StaticResource CvCaps}"
                                              Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <cv:CvTrackedText DockPanel.Dock="Right" Label="LAST 80 SAMPLES" Style="{StaticResource CvCaps}"
                                              VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Style="{StaticResource CvChannelRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <cv:CvTrackedText Label="SPEED" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding SpeedTelemetryValueText}" Style="{StaticResource CvChannelValue}" Foreground="{DynamicResource CvAccentBrush}"/>
                            </StackPanel>
                            <Line Grid.Column="1" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource CvOverlay14Brush}" StrokeThickness="1" StrokeDashArray="3 5" IsHitTestVisible="False"/>
                            <cv:CvSparkChart Grid.Column="1" Tag="{Binding SpeedTelemetryValueText}" Values="{Binding SpeedHistory}" StrokeHex="#2FF0D6" Style="{StaticResource CvLaneSpark}"/>
                            <cv:CvTrackedText Grid.Column="2" Label="KM/H" Style="{StaticResource CvCaps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Style="{StaticResource CvChannelRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <cv:CvTrackedText Label="SOC" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding BatteryTelemetryValueText}" Style="{StaticResource CvChannelValue}" Foreground="{DynamicResource CvAccentSoftBrush}"/>
                            </StackPanel>
                            <Line Grid.Column="1" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource CvOverlay14Brush}" StrokeThickness="1" StrokeDashArray="3 5" IsHitTestVisible="False"/>
                            <cv:CvSparkChart Grid.Column="1" Tag="{Binding BatteryTelemetryValueText}" Values="{Binding SocHistory}" StrokeHex="#7EF7E4" Style="{StaticResource CvLaneSpark}"/>
                            <cv:CvTrackedText Grid.Column="2" Label="%" Style="{StaticResource CvCaps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Style="{StaticResource CvChannelRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <cv:CvTrackedText Label="MOTOR TEMP" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding MotorTempTelemetryValueText}" Style="{StaticResource CvChannelValue}" Foreground="{DynamicResource CvWarnBrush}"/>
                            </StackPanel>
                            <Line Grid.Column="1" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource CvOverlay14Brush}" StrokeThickness="1" StrokeDashArray="3 5" IsHitTestVisible="False"/>
                            <cv:CvSparkChart Grid.Column="1" Tag="{Binding MotorTempTelemetryValueText}" Values="{Binding MotorTempHistory}" StrokeHex="#FFB245" Style="{StaticResource CvLaneSpark}"/>
                            <cv:CvTrackedText Grid.Column="2" Label="°C" Style="{StaticResource CvCaps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Style="{StaticResource CvChannelRow}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <cv:CvTrackedText Label="VOLTAGE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <TextBlock Text="{Binding VoltageTelemetryValueText}" Style="{StaticResource CvChannelValue}" Foreground="{DynamicResource CvVioletSoftBrush}"/>
                            </StackPanel>
                            <Line Grid.Column="1" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource CvOverlay14Brush}" StrokeThickness="1" StrokeDashArray="3 5" IsHitTestVisible="False"/>
                            <cv:CvSparkChart Grid.Column="1" Tag="{Binding VoltageTelemetryValueText}" Values="{Binding VoltageHistory}" StrokeHex="#B07BFF" Style="{StaticResource CvLaneSpark}"/>
                            <cv:CvTrackedText Grid.Column="2" Label="V" Style="{StaticResource CvCaps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- live signal monitor + CAN-ID activity -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.62*" MinWidth="280" MaxWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LIVE SIGNAL MONITOR -->
                    <Border Grid.Column="0" Style="{StaticResource CardFlush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                                    <cv:CvTrackedText DockPanel.Dock="Left" Label="LIVE SIGNAL MONITOR" Style="{StaticResource CvPanelTitle}" Margin="9,0,0,0"/>
                                    <cv:CvTrackedText DockPanel.Dock="Right" Label="{Binding CanTrafficVolumeText}" Style="{StaticResource CvCaps}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource CvTableHeadBrush}" Padding="16,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="56"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <cv:CvTrackedText Grid.Column="0" Label="SIGNAL NAME" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="1" Label="CAN ID" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="2" Label="VALUE" Style="{StaticResource CvCaps}" FontSize="9" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                                    <cv:CvTrackedText Grid.Column="3" Label="UNIT" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <cv:CvTrackedText Grid.Column="4" Label="STATUS" Style="{StaticResource CvCaps}" FontSize="9"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SignalRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SignalItem}">
                                            <Border Style="{StaticResource CvTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="56"/><ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextBrightBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CanId}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvAccentBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextBrush}"
                                                               HorizontalAlignment="Right" Margin="0,0,14,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Unit}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextMutedBrush}"/>
                                                    <TextBlock x:Name="St" Grid.Column="4" Text="{Binding State}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextDimBrush}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="LIVE">
                                                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="READY">
                                                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="HELD">
                                                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Style="{StaticResource CvEmptyWhenZero}" Tag="{Binding SignalRows.Count}">
                                <Border Style="{StaticResource CvEmptyGlyph}"><Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/></Border>
                                <cv:CvTrackedText Label="NO DECODED SIGNALS" Style="{StaticResource CvCaps}" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                                <TextBlock Text="Signals decode here when a vehicle DBC profile matches the stream." Style="{StaticResource CvEmptyBody}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CAN-ID ACTIVITY -->
                    <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}" Fill="{DynamicResource CvWarnBrush}"
                                               Effect="{DynamicResource CvWarnGlow}"/>
                                    <cv:CvTrackedText DockPanel.Dock="Left" Label="CAN-ID ACTIVITY" Style="{StaticResource CvPanelTitle}"/>
                                    <cv:CvTrackedText DockPanel.Dock="Right" Label="COUNT · AVG SCORE" Style="{StaticResource CvCaps}" FontSize="9"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CanActivityRows}" Margin="16,8,16,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CanActivityItem}">
                                            <Grid Height="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="46"/><ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CanId}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvAccentBrush}"/>
                                                <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource CvTableHeadBrush}" VerticalAlignment="Center">
                                                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Effect="{DynamicResource CvAccentGlowSoft}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#592FF0D6" Offset="0"/>
                                                                <GradientStop Color="#FF2FF0D6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ScoreText}" Style="{StaticResource CvCell}" Foreground="{DynamicResource CvTextDimBrush}"
                                                           HorizontalAlignment="Right" FontSize="10.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Style="{StaticResource CvEmptyWhenZero}" Tag="{Binding CanActivityRows.Count}">
                                <Border Style="{StaticResource CvEmptyGlyph}"><Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/></Border>
                                <cv:CvTrackedText Label="NO FLAGGED CAN IDS" Style="{StaticResource CvCaps}" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                                <TextBlock Text="IDs appear as the detector scores traffic." Style="{StaticResource CvEmptyBody}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ─── RIGHT RAIL ────────────────────────────────────────── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- STREAM HEALTH -->
                <Border Grid.Row="0" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                    <StackPanel Margin="16,15,16,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Rectangle Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText Label="STREAM HEALTH" Style="{StaticResource CvPanelTitle}"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="-5,-5">
                            <Border Style="{StaticResource CvObsBlock}" Margin="5" Padding="12,10">
                                <StackPanel>
                                    <cv:CvTrackedText Label="PACKET RATE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding PacketRateText}" Style="{StaticResource CvHealthValue}" Foreground="{DynamicResource CvAccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvObsBlock}" Margin="5" Padding="12,10">
                                <StackPanel>
                                    <cv:CvTrackedText Label="SAMPLE RATE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding SampleRateText}" Style="{StaticResource CvHealthValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvObsBlock}" Margin="5" Padding="12,10">
                                <StackPanel>
                                    <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource CvHealthValue}" Foreground="{DynamicResource CvWarnBrush}" ToolTip="Runtime latency. Offline replay: total backend ML analysis time for the loaded log. Live session: measured round-trip of each /vehicle poll."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvObsBlock}" Margin="5" Padding="12,10">
                                <StackPanel>
                                    <cv:CvTrackedText Label="PACKET LOSS" Style="{StaticResource CvCaps}" FontSize="9"/>
                                    <TextBlock Text="{Binding PacketLossText}" Style="{StaticResource CvHealthValue}" Foreground="{DynamicResource CvAccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- IDS STATUS -->
                <Border Grid.Row="2" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderVioletBrush}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.7" RadiusY="1.2">
                            <GradientStop Color="#26B07BFF" Offset="0"/>
                            <GradientStop Color="#000A1416" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <cv:CvTrackedText Label="IDS STATUS" Style="{StaticResource CvCaps}" FontSize="9"/>
                            <TextBlock Text="{Binding StreamOperationalStateText}" Margin="0,8,0,0"
                                       FontFamily="{StaticResource CvDisplayFont}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{Binding StreamStateColor, Converter={StaticResource HexColorToBrushConverter}}"
                                       TextTrimming="CharacterEllipsis"/>
                            <cv:CvTrackedText Margin="0,7,0,0" Style="{StaticResource CvCaps}" FontSize="9" Label="{Binding InferenceHealthText}"/>
                            <cv:CvTrackedText Margin="0,3,0,0" Style="{StaticResource CvCaps}" FontSize="9" Label="{Binding StreamStateText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <cv:CvTrackedText Label="CONFIDENCE" Style="{StaticResource CvCaps}" FontSize="9" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DetectionConfidenceText}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource CvDisplayFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource CvVioletSoftBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                            <TextBlock Text="{Binding ActiveModelName}" Margin="0,5,0,0" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource CvMonoFont}" FontSize="9.5" Foreground="{DynamicResource CvTextDimBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LIVE EVENTS -->
                <Border Grid.Row="4" Style="{StaticResource CardFlush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="LIVE EVENTS" Style="{StaticResource CvPanelTitle}" Margin="9,0,0,0"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TelemetryEventRows.Count}" FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                               Foreground="{DynamicResource CvTextSoftBrush}"/>
                                    <cv:CvTrackedText Label="EVENTS" Style="{StaticResource CvCaps}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TelemetryEventRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TelemetryEventItem}">
                                        <Border Style="{StaticResource CvTableRow}" Height="25">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Style="{StaticResource CvCell}" FontSize="10.5"
                                                           Foreground="{DynamicResource CvTextDimBrush}"/>
                                                <TextBlock x:Name="Sev" Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource CvCell}" FontSize="10"
                                                           Foreground="{DynamicResource CvTextMutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource CvCell}" FontSize="10.5"
                                                           Foreground="{DynamicResource CvTextSoftBrush}" ToolTip="{Binding Message}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="WARN">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Style="{StaticResource CvEmptyWhenZero}" Tag="{Binding TelemetryEventRows.Count}">
                            <Border Style="{StaticResource CvEmptyGlyph}"><Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/></Border>
                            <cv:CvTrackedText Label="NO EVENTS YET" Style="{StaticResource CvCaps}" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                            <TextBlock Text="Detector events stream here in real time." Style="{StaticResource CvEmptyBody}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
