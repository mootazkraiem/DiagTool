<UserControl
    x:Class="CANvision.Native.UI.TelemetryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    Background="#060E0E">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1A1A" Offset="0"/>
                        <GradientStop Color="#0A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#28009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#3A6060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#D0ECEC"/>
        </Style>

        <Style x:Key="ValAccent" TargetType="TextBlock" BasedOn="{StaticResource Val}">
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#2A4A4A"/>
        </Style>

        <Style x:Key="AccentBar" TargetType="Rectangle">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Fill" Value="#00C8C8"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="RailCommandButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource ValAccent}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="LineHeight" Value="25"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="KpiState" TargetType="TextBlock" BasedOn="{StaticResource Meta}">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#426A6A"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="KpiTrendFrame" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="RailCard" TargetType="Border">
            <Setter Property="Background" Value="#08000000"/>
            <Setter Property="BorderBrush" Value="#182F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.6" RadiusY="0.55">
                    <GradientStop Color="#08001818" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#18009999" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding StreamStateColor}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding LiveStateText}" Foreground="{Binding StreamStateColor}" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="STATUS" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding ConnectionStateText}" Foreground="#3A6060" FontFamily="Bahnschrift" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="PPS" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="10" Text="{Binding PacketsPerSecondText}" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="12" Text="REPLAY" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="14" Text="{Binding ReplayStatusText}" Foreground="#3A6060" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="16" Text="{Binding ReplayNameText}" Foreground="#2A5050" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="18" Text="{Binding LastEventTimestamp}" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#14009999" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="10,10,10,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="STREAM CONTROL" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <Button Margin="0,7,0,5" Style="{StaticResource RailCommandButton}" Command="{Binding ResumeStreamCommand}" Content="START SESSION"/>
                        <Button Style="{StaticResource RailCommandButton}" Command="{Binding FreezeStreamCommand}" Content="STOP SESSION"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="REPLAY CONTROL" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <Grid Margin="0,7,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource TransportButton}" Command="{Binding FreezeStreamCommand}" Content="⏮"/>
                            <Button Grid.Column="1" Margin="0,0,5,0" Style="{StaticResource TransportButton}" Command="{Binding ResumeStreamCommand}" Content="▶"/>
                            <Button Grid.Column="2" Margin="0,0,5,0" Style="{StaticResource TransportButton}" Command="{Binding FreezeStreamCommand}" Content="⏸"/>
                            <Button Grid.Column="3" Margin="0,0,5,0" Style="{StaticResource TransportButton}" Command="{Binding FreezeStreamCommand}" Content="■"/>
                            <Button Grid.Column="4" Style="{StaticResource TransportButton}" Command="{Binding ResumeStreamCommand}" Content="⏭"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="SESSION" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <TextBlock Text="{Binding ReplayNameText}" Style="{StaticResource ValAccent}" FontSize="13" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding UnitNameText}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="DURATION" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SessionDurationText}" Foreground="#D0ECEC" FontFamily="Bahnschrift" FontSize="9"/>
                            <TextBlock Grid.Row="1" Text="FRAMES" Style="{StaticResource Meta}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeReplayFramesText}" Foreground="#D0ECEC" FontFamily="Bahnschrift" FontSize="9" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Text="PROGRESS" Style="{StaticResource Meta}" Margin="0,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeReplayProgressText}" Foreground="#D0ECEC" FontFamily="Bahnschrift" FontSize="9" Margin="0,3,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RUNTIME" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <TextBlock Text="{Binding ConnectionStateText}" Style="{StaticResource ValAccent}" FontSize="14" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding LatencyText, StringFormat='HEARTBEAT {0}'}" Style="{StaticResource Meta}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LastEventTimestamp, StringFormat='LAST PACKET {0}'}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="96"/>
                <RowDefinition Height="176"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="5">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SPEED" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding SpeedTelemetryValueText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding SpeedTelemetryStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource KpiTrendFrame}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="116" Height="26" ClipToBounds="True">
                                    <Polyline Points="{Binding SpeedTrendPoints}" Stroke="#00C8C8" StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="VOLTAGE" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding VoltageTelemetryValueText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding VoltageTelemetryStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource KpiTrendFrame}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="116" Height="26" ClipToBounds="True">
                                    <Polyline Points="{Binding VoltageTrendPoints}" Stroke="#00C8C8" StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CURRENT" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding CurrentTelemetryValueText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding CurrentTelemetryStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource KpiTrendFrame}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="116" Height="26" ClipToBounds="True">
                                    <Polyline Points="{Binding CurrentTrendPoints}" Stroke="#00C8C8" StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="MOTOR TEMP" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding MotorTempTelemetryValueText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding MotorTempTelemetryStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource KpiTrendFrame}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="116" Height="26" ClipToBounds="True">
                                    <Polyline Points="{Binding MotorTempTrendPoints}" Stroke="#00C8C8" StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PACKETS/SEC" Style="{StaticResource Lbl}"/>
                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                            <TextBlock Text="{Binding PacketsPerSecondTelemetryValueText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding PacketsPerSecondTelemetryStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource KpiTrendFrame}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="116" Height="26" ClipToBounds="True">
                                    <Polyline Points="{Binding PacketRateTrendPoints}" Stroke="#00C8C8" StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,4,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="SIGNAL CHANNELS" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="SPEED · SOC · TEMP · VOLTAGE" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPEED" Style="{StaticResource Lbl}"/>
                            <TextBlock Text="{Binding SpeedTelemetryValueText}" Foreground="#56F0AC" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#05001818" BorderBrush="#0C3A6060" BorderThickness="1" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="400" Height="34" ClipToBounds="True">
                                    <Polyline Points="{Binding SpeedChannelPoints}" Stroke="#56F0AC" StrokeThickness="1.5" Opacity="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SOC %" Style="{StaticResource Lbl}"/>
                            <TextBlock Text="{Binding BatteryTelemetryValueText}" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#05001818" BorderBrush="#0C3A6060" BorderThickness="1" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="400" Height="34" ClipToBounds="True">
                                    <Polyline Points="{Binding SocChannelPoints}" Stroke="#00C8C8" StrokeThickness="1.5" Opacity="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MOTOR TEMP" Style="{StaticResource Lbl}"/>
                            <TextBlock Text="{Binding MotorTempTelemetryValueText}" Foreground="#FF8C3A" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#05001818" BorderBrush="#0C3A6060" BorderThickness="1" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="400" Height="34" ClipToBounds="True">
                                    <Polyline Points="{Binding MotorTempChannelPoints}" Stroke="#FF8C3A" StrokeThickness="1.5" Opacity="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VOLTAGE" Style="{StaticResource Lbl}"/>
                            <TextBlock Text="{Binding VoltageTelemetryValueText}" Foreground="#96B4FF" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#05001818" BorderBrush="#0C3A6060" BorderThickness="1" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="400" Height="34" ClipToBounds="True">
                                    <Polyline Points="{Binding VoltageChannelPoints}" Stroke="#96B4FF" StrokeThickness="1.5" Opacity="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="LIVE SIGNAL MONITOR" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SIGNAL NAME" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="CAN ID" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="3" Text="UNIT" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="5" Text="TREND" Style="{StaticResource Meta}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SignalRows}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SignalItem}">
                                        <Border BorderBrush="#143A7272" BorderThickness="0,0,0,1" Padding="0,1" MinHeight="20">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="#0900C8C8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="88"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="#CFECEC" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" BorderBrush="#244A7070" BorderThickness="1" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CanId}" Foreground="{Binding CanIdBrush}" FontFamily="Consolas" FontSize="10"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#00C8C8" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="#6E9090" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding State}" Foreground="{Binding StateBrush}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="5" Width="78" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Rectangle Height="1" Fill="#264E4E" VerticalAlignment="Center"/>
                                                    <Polyline Points="{Binding TrendPoints}" Stroke="#00E6E6" StrokeThickness="1.7"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="VEHICLE CONTEXT" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CONNECTION STATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionStateText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="VEHICLE STATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BatteryTelemetryValueText}" Foreground="#00C8C8" FontFamily="Consolas" FontSize="9"/>
                            <TextBlock Grid.Row="2" Text="DRIVE MODE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VehicleModeText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9"/>
                            <TextBlock Grid.Row="3" Text="WATCHLIST" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WatchlistText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9"/>
                            <TextBlock Grid.Row="4" Text="SIGNAL HEALTH" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SignalHealthText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9"/>
                            <TextBlock Grid.Row="5" Text="GEAR" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GearText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="SUBSYSTEM HEALTH" Style="{StaticResource Lbl}" Foreground="#00C8C8" Margin="0,0,0,5"/>
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding SubsystemRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#142F6666" BorderThickness="1" Background="#05000000" Padding="7,5" Margin="0,0,6,6" MinHeight="28">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" BorderBrush="{Binding StateBrush}" BorderThickness="1" Padding="5,1" Background="#07000000">
                                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="0,16,14,12" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="OBSERVABILITY" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"/>

                <Border Grid.Row="1" Style="{StaticResource RailCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STREAM HEALTH" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="PACKET RATE" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding PacketRateText}" Style="{StaticResource ValAccent}" FontSize="22"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,6">
                                <TextBlock Text="SAMPLE RATE" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SampleRateText}" Style="{StaticResource Val}" FontSize="22"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="LATENCY" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Val}" FontSize="22"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="PACKET LOSS" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding PacketLossText}" Foreground="#FF716C" FontFamily="Bahnschrift" FontSize="22"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#0A001818" BorderBrush="#3300C8C8" BorderThickness="1" Padding="9,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IDS STATUS" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                            <TextBlock Text="{Binding StreamOperationalStateText}" Foreground="{Binding StreamStateColor}" FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveModelName}" Style="{StaticResource Meta}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding InferenceHealthText, StringFormat='INFERENCE {0}'}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CONFIDENCE" Style="{StaticResource Meta}"/>
                            <TextBlock Text="{Binding DetectionConfidenceText}" Style="{StaticResource ValAccent}" FontSize="28" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StreamStateText}" Style="{StaticResource KpiState}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource RailCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="REPLAY OBSERVABILITY" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                        <Grid Grid.Row="1" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="REPLAY STATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ReplayStatusText}" Foreground="#56F0AC" FontFamily="Bahnschrift" FontSize="12"/>
                            <TextBlock Grid.Row="1" Text="FRAMES / SEC" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReplayFpsText}" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="12"/>
                            <TextBlock Grid.Row="2" Text="DROPPED FRAMES" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DroppedFramesText}" Foreground="#D0ECEC" FontFamily="Bahnschrift" FontSize="12"/>
                            <TextBlock Grid.Row="3" Text="REPLAY LATENCY" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReplayLatencyText}" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="12"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="#08000000" BorderBrush="#182F36" BorderThickness="1" Padding="9,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="LIVE EVENTS" Style="{StaticResource Lbl}" Foreground="#00C8C8"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TelemetryEventRows.Count, StringFormat='{}{0} EVENTS'}" Style="{StaticResource Meta}"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIME" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="SEV" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="2" Text="SRC" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="3" Text="MESSAGE" Style="{StaticResource Meta}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding EventsEmptyStateText}" Foreground="#233D3D" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TelemetryEventRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#143A7272" BorderThickness="0,0,0,1" Padding="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="#6E9090" FontFamily="Consolas" FontSize="9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Severity}" Foreground="{Binding SeverityBrush}" FontFamily="Consolas" FontSize="9"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#00C8C8" FontFamily="Consolas" FontSize="9"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#18009999" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <UniformGrid Columns="8" Margin="12,8,12,8">
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="BATTERY" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding BatteryTelemetryValueText}" Style="{StaticResource Val}" FontSize="20"/>
                        <TextBlock Text="{Binding BatteryTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="SPEED" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding SpeedTelemetryValueText}" Style="{StaticResource Val}" FontSize="20"/>
                        <TextBlock Text="{Binding SpeedTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="MOTOR TEMP" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding MotorTempTelemetryValueText}" Style="{StaticResource Val}" FontSize="20"/>
                        <TextBlock Text="{Binding MotorTempTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="VOLTAGE" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding VoltageTelemetryValueText}" Style="{StaticResource Val}" FontSize="20"/>
                        <TextBlock Text="{Binding VoltageTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="CURRENT" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding CurrentTelemetryValueText}" Style="{StaticResource Val}" FontSize="20"/>
                        <TextBlock Text="{Binding CurrentTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="PACKETS/SEC" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding PacketsPerSecondTelemetryValueText}" Style="{StaticResource ValAccent}" FontSize="20"/>
                        <TextBlock Text="{Binding PacketsPerSecondTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="REPLAY" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding ReplayProgressTelemetryValueText}" Style="{StaticResource ValAccent}" FontSize="20"/>
                        <TextBlock Text="{Binding ReplayProgressTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,3">
                    <StackPanel>
                        <TextBlock Text="PACKET LOSS" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding PacketLossTelemetryValueText}" Foreground="#FF716C" FontFamily="Bahnschrift" FontSize="20"/>
                        <TextBlock Text="{Binding PacketLossTelemetryStateText}" Style="{StaticResource KpiState}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CanTrafficVolumeText}" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding RuntimeStateText}" Foreground="#1E3A3A" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
