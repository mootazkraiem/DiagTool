<UserControl
    x:Class="CANvision.Native.UI.AnomalyIntelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:conv="clr-namespace:CANvision.Native.Converters"
    Background="#060E0E">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1A1A" Offset="0"/>
                        <GradientStop Color="#0A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#28009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="CardActive" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="#4400C8C8"/>
        </Style>

        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="Background" Value="#08000000"/>
            <Setter Property="BorderBrush" Value="#182F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,8"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#3A6060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#2A4A4A"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#D0ECEC"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                    <Setter Property="Foreground" Value="#FFB84A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="HIGH">
                    <Setter Property="Foreground" Value="#FF8C3A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                    <Setter Property="Foreground" Value="#FF2626"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <conv:HexColorToBrushConverter x:Key="HexBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ScaleConverter x:Key="Scale"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Radial glow overlay (matches other views) -->
        <Rectangle Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.58" RadiusY="0.55">
                    <GradientStop Color="#08001818" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ── Row 0: KPI header strip ────────────────────────────────── -->
        <UniformGrid Grid.Row="0" Columns="6" Margin="12,10,12,8">
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOTAL ALERTS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding AlertCountText}" Foreground="#00C8C8"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="IDS events" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CRITICAL" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding CriticalCount}" Foreground="#FF2626"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Score ≥ 0.80" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="HIGH / WARNING" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding HighCount}" Foreground="#FF8C3A"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Score ≥ 0.55" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOP THREAT CAN ID" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedAlert.CanId, FallbackValue='--'}"
                               Foreground="#56F0AC" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Selected event" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELECTED SCORE" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedAlert.ScoreText, FallbackValue='--'}"
                               Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexBrush}, FallbackValue=#00C8C8}"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Fusion score" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AI ENGINE" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="ACTIVE" Foreground="#56F0AC"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="GPT-4o-mini ready" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ── Row 1: Main 3-column content ──────────────────────────── -->
        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- COL 0: Alert event list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IDS ALERT EVENTS" Style="{StaticResource Title}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Meta}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>

                    <!-- Empty state -->
                    <Border Grid.Row="1" Style="{StaticResource InnerCard}"
                            Visibility="{Binding HasAlerts, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="NO IDS EVENTS" FontFamily="Bahnschrift Condensed" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#1A5050" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Import a replay or start a live session to generate anomaly events."
                                       FontFamily="Bahnschrift" FontSize="8.5" Foreground="#1A3A3A"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Alert rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                  Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3" Padding="9,7" Cursor="Hand"
                                            BorderThickness="1" CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0D1818" Offset="0"/>
                                                <GradientStop Color="#090F0F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#1E008888"/>
                                        </Border.BorderBrush>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectAlertCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" Style="{StaticResource SeverityText}"
                                                       FontSize="8.5" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CanId}" Style="{StaticResource Mono}"
                                                           FontSize="10" Foreground="#00C8C8"/>
                                                <TextBlock Text="{Binding AttackType}" FontFamily="Bahnschrift" FontSize="7.5"
                                                           Foreground="#2A5050" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource Mono}"
                                                       FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Meta}"
                                                       FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- COL 1: Alert detail + Layer attribution -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- No selection placeholder -->
                <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Card}"
                        Visibility="{Binding HasSelectedAlert, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="SELECT AN EVENT" FontFamily="Bahnschrift Condensed" FontSize="15"
                                   FontWeight="SemiBold" Foreground="#1A5050" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click an alert in the list to inspect its AI layer analysis and generate an explanation."
                                   FontFamily="Bahnschrift" FontSize="8.5" Foreground="#1A3A3A"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                </Border>

                <!-- Alert detail header -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8"
                        Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}"
                        DataContext="{Binding SelectedAlert}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityText}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="SEVERITY" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CAN ID" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CanId}" Style="{StaticResource Mono}"
                                       Foreground="#00C8C8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="ATTACK TYPE" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AttackType}" Style="{StaticResource Mono}"
                                       Foreground="#D0ECEC" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="TIMESTAMP" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Mono}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScoreText}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="FUSION SCORE" Style="{StaticResource Meta}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Layer attribution -->
                <Border Grid.Row="1" Style="{StaticResource Card}"
                        Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}"
                        DataContext="{Binding SelectedAlert}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DETECTION LAYER ATTRIBUTION" Style="{StaticResource Title}" Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>

                            <!-- Timing -->
                            <TextBlock Text="TIMING" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Height="6" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#00C8C8" Opacity="0.85"
                                           Width="{Binding LayerTiming, Converter={StaticResource Scale}, ConverterParameter=300}"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding LayerTiming, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="9" Foreground="#00C8C8"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Payload -->
                            <TextBlock Grid.Row="2" Text="PAYLOAD" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="2" Grid.Column="1" Height="6" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#56F0AC" Opacity="0.85"
                                           Width="{Binding LayerPayload, Converter={StaticResource Scale}, ConverterParameter=300}"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LayerPayload, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="9" Foreground="#56F0AC"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- ML -->
                            <TextBlock Grid.Row="4" Text="ML MODEL" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="4" Grid.Column="1" Height="6" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#B46CFF" Opacity="0.85"
                                           Width="{Binding LayerMl, Converter={StaticResource Scale}, ConverterParameter=300}"/>
                            </Grid>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LayerMl, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="9" Foreground="#B46CFF"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Temporal -->
                            <TextBlock Grid.Row="6" Text="TEMPORAL" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="6" Grid.Column="1" Height="6" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#FF8C3A" Opacity="0.85"
                                           Width="{Binding LayerTemporal, Converter={StaticResource Scale}, ConverterParameter=300}"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LayerTemporal, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="9" Foreground="#FF8C3A"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Raw reason string -->
                            <Border Grid.Row="8" Grid.ColumnSpan="3" Style="{StaticResource InnerCard}"
                                    Padding="8,6" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="RAW DETECTION REASON" Style="{StaticResource Meta}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Reason}" FontFamily="Consolas" FontSize="8.5"
                                               Foreground="#3A6060" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- COL 2: AI Explanation -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AI EXPLANATION" Style="{StaticResource Title}"/>
                            <TextBlock Text="GPT-4o-mini · Anomaly Intel Engine" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="REFRESH"
                                Style="{StaticResource TinyButton}"
                                Command="{Binding SelectedAlert.ExplainCommand}"
                                Visibility="{Binding SelectedAlert.HasExplanation, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,0"/>
                    </Grid>

                    <!-- No selection state -->
                    <Border Grid.Row="1" Style="{StaticResource InnerCard}"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="No event selected." FontFamily="Bahnschrift" FontSize="9"
                                   Foreground="#1A4040" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Explanation content (alert selected) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}"
                                  DataContext="{Binding SelectedAlert}">
                        <StackPanel>

                            <!-- Loading -->
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                                    <Ellipse Width="7" Height="7" Fill="#00C8C8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="QUERYING AI ENGINE..." FontFamily="Bahnschrift Condensed"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#00A080" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Explain prompt -->
                            <StackPanel Visibility="{Binding CanExplain, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,8">
                                <TextBlock Text="No explanation generated yet." FontFamily="Bahnschrift"
                                           FontSize="9" Foreground="#2A5050" Margin="0,0,0,10"/>
                                <Button Content="⚡  EXPLAIN WITH AI"
                                        Style="{StaticResource HudActionButtonStyle}"
                                        Command="{Binding ExplainCommand}"
                                        Height="32" Padding="14,0" HorizontalAlignment="Left"
                                        FontFamily="Bahnschrift Condensed" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Explanation text blocks -->
                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8"
                                    Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="SUMMARY" Style="{StaticResource Meta}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ExplanationSummary}" FontFamily="Bahnschrift"
                                               FontSize="10" Foreground="#B0D8E8" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8"
                                    Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="ANALYSIS" Style="{StaticResource Meta}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ExplanationDetail}" FontFamily="Bahnschrift"
                                               FontSize="10" Foreground="#9AB8C8" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}"
                                    Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="RECOMMENDATION" Style="{StaticResource Meta}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ExplanationRecommendation}" FontFamily="Bahnschrift"
                                               FontSize="10" Foreground="#86C4B0" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Row 2: Action buttons bar ─────────────────────────────── -->
        <Border Grid.Row="2" BorderBrush="#18009999" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AI ACTIONS" Style="{StaticResource Title}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <UniformGrid Grid.Column="1" Columns="5">
                    <Button Content="⚡ EXPLAIN SELECTED" Style="{StaticResource TinyButton}"
                            Command="{Binding SelectedAlert.ExplainCommand}" Margin="2,0"/>
                    <Button Content="REFRESH ALERTS" Style="{StaticResource TinyButton}"
                            Command="{Binding RefreshCommand}" Margin="2,0"/>
                    <Button Content="SELECT FIRST" Style="{StaticResource TinyButton}"
                            Command="{Binding SelectAlertCommand}"
                            CommandParameter="{Binding Alerts[0]}" Margin="2,0"/>
                    <Button Content="EXPORT EVENTS" Style="{StaticResource TinyButton}"
                            Command="{Binding SaveSnapshotCommand}" Margin="2,0"/>
                    <Button Content="CLEAR EXPLANATIONS" Style="{StaticResource TinyButton}"
                            Command="{Binding RefreshCommand}" Margin="2,0" Foreground="#FF716C"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ── Row 3: Status bar ──────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="28"/>
