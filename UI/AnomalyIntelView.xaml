<UserControl
    x:Class="CANvision.Native.UI.AnomalyIntelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:conv="clr-namespace:CANvision.Native.Converters"
    Background="#060E0E">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1A1A" Offset="0"/>
                        <GradientStop Color="#0A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#28009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="Background" Value="#08000000"/>
            <Setter Property="BorderBrush" Value="#182F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,8"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#3A6060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#2A4A4A"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#D0ECEC"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                    <Setter Property="Foreground" Value="#FFB84A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="HIGH">
                    <Setter Property="Foreground" Value="#FF8C3A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                    <Setter Property="Foreground" Value="#FF2626"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <conv:HexColorToBrushConverter x:Key="HexBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ScaleConverter x:Key="Scale"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Radial glow overlay -->
        <Rectangle Grid.RowSpan="5" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.58" RadiusY="0.55">
                    <GradientStop Color="#08001818" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ── Row 0: KPI header strip ─────────────────────────────────────── -->
        <UniformGrid Grid.Row="0" Columns="6" Margin="12,10,12,8">
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOTAL ALERTS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding AlertCountText}" Foreground="#00C8C8"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="IDS events" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CRITICAL" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding CriticalCount}" Foreground="#FF2626"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Score ≥ 0.80" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="HIGH / WARNING" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding HighCount}" Foreground="#FF8C3A"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Score ≥ 0.55" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TOP THREAT CAN ID" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedAlert.CanId, FallbackValue='--'}"
                               Foreground="#56F0AC" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Selected event" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELECTED SCORE" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedAlert.ScoreText, FallbackValue='--'}"
                               Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexBrush}, FallbackValue=#00C8C8}"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Fusion score" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AI ENGINE" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="ACTIVE" Foreground="#56F0AC"
                               FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Gemini · Ollama · RAG" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ── Row 1: Threat Timeline ─────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="12,0,12,4" Padding="10,5"
                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TIMELINE" FontFamily="Bahnschrift" FontSize="8" FontWeight="SemiBold"
                           Foreground="#3A6060" VerticalAlignment="Center"/>
                <!-- Timeline track + markers -->
                <Canvas Grid.Column="1" Height="24" x:Name="TimelineCanvas">
                    <!-- Background track -->
                    <Rectangle Canvas.Top="10" Height="4" Fill="#0D1818" RadiusX="2" RadiusY="2"
                               Width="{Binding ActualWidth, ElementName=TimelineCanvas}"/>
                    <ItemsControl ItemsSource="{Binding TimelineMarkers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TimelineMarker}">
                                <Ellipse Width="7" Height="7" Cursor="Hand"
                                         Fill="{Binding Color, Converter={StaticResource HexBrush}}"
                                         Canvas.Left="{Binding X}" Canvas.Top="8.5"
                                         ToolTip="{Binding CanId}"
                                         Opacity="0.9">
                                    <Ellipse.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectMarkerAlertCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Ellipse.InputBindings>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
                <TextBlock Grid.Column="2" Text="{Binding Alerts.Count, StringFormat='{}{0} events'}"
                           FontFamily="Consolas" FontSize="8" Foreground="#2A5050"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── Row 2: 2-column layout ──────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.38*"/>
                <ColumnDefinition Width="0.62*"/>
            </Grid.ColumnDefinitions>

            <!-- ── COL 0: AI DETECTION ─────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="*"/>      <!-- alert list -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="Auto"/>   <!-- compact detail -->
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI DETECTION" Style="{StaticResource Title}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Meta}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </Grid>

                    <!-- Empty state -->
                    <Border Grid.Row="1" Style="{StaticResource InnerCard}"
                            Visibility="{Binding HasAlerts, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="NO IDS EVENTS" FontFamily="Bahnschrift Condensed" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#1A5050"
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Import a replay log to generate anomaly events."
                                       FontFamily="Bahnschrift" FontSize="8.5" Foreground="#1A3A3A"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Alert list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                  Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3" Padding="8,6" Cursor="Hand"
                                            BorderThickness="1" CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0D1818" Offset="0"/>
                                                <GradientStop Color="#090F0F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#1E008888"/>
                                        </Border.BorderBrush>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectAlertCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" Style="{StaticResource SeverityText}"
                                                       FontSize="8.5" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CanId}" Style="{StaticResource Mono}"
                                                           FontSize="10" Foreground="#00C8C8"/>
                                                <TextBlock Text="{Binding AttackType}" FontFamily="Bahnschrift" FontSize="7.5"
                                                           Foreground="#2A5050" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource Mono}"
                                                       FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Meta}"
                                                       FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Separator (only when an alert is selected) -->
                    <Border Grid.Row="2" Height="1" Background="#1A3030" Margin="0,6,0,6"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}"/>

                    <!-- Compact alert detail + layer bars (selected alert) -->
                    <Grid Grid.Row="3" Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Row 0: brief header -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>  <!-- Row 2: layer bars -->
                            <RowDefinition Height="Auto"/>  <!-- Row 3: KB badge -->
                            <RowDefinition Height="Auto"/>  <!-- Row 4: detection layer chips -->
                            <RowDefinition Height="Auto"/>  <!-- Row 5: plausibility violations -->
                            <RowDefinition Height="Auto"/>  <!-- Row 6: recommended response -->
                        </Grid.RowDefinitions>

                        <!-- Selected alert summary line -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedAlert.Severity}" Style="{StaticResource SeverityText}"
                                               FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " Foreground="#1A4040" FontFamily="Bahnschrift" FontSize="9"/>
                                    <TextBlock Text="{Binding SelectedAlert.CanId}" FontFamily="Consolas"
                                               FontSize="10" Foreground="#00C8C8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding SelectedAlert.AttackType}" FontFamily="Bahnschrift"
                                               FontSize="8" Foreground="#2A5050"/>
                                    <TextBlock Text=" · " Foreground="#1A3030" FontFamily="Bahnschrift" FontSize="8"/>
                                    <TextBlock Text="{Binding SelectedAlert.Time}" FontFamily="Consolas"
                                               FontSize="8" Foreground="#1A4040"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAlert.ScoreText}" FontFamily="Consolas"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexBrush}}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="fusion" Style="{StaticResource Meta}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Detection layer bars (compact) -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TIMING" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Height="4" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#00C8C8" Opacity="0.85"
                                           Width="{Binding SelectedAlert.LayerTiming, Converter={StaticResource Scale}, ConverterParameter=200}"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedAlert.LayerTiming, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="8" Foreground="#00C8C8"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="PAYLOAD" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="2" Grid.Column="1" Height="4" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#56F0AC" Opacity="0.85"
                                           Width="{Binding SelectedAlert.LayerPayload, Converter={StaticResource Scale}, ConverterParameter=200}"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedAlert.LayerPayload, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="8" Foreground="#56F0AC"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Text="ML MODEL" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="4" Grid.Column="1" Height="4" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#B46CFF" Opacity="0.85"
                                           Width="{Binding SelectedAlert.LayerMl, Converter={StaticResource Scale}, ConverterParameter=200}"/>
                            </Grid>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedAlert.LayerMl, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="8" Foreground="#B46CFF"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6" Text="TEMPORAL" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="6" Grid.Column="1" Height="4" Background="#0A1820" VerticalAlignment="Center">
                                <Rectangle HorizontalAlignment="Left" Fill="#FF8C3A" Opacity="0.85"
                                           Width="{Binding SelectedAlert.LayerTemporal, Converter={StaticResource Scale}, ConverterParameter=200}"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SelectedAlert.LayerTemporal, StringFormat=F3}"
                                       FontFamily="Consolas" FontSize="8" Foreground="#FF8C3A"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- KB match badge -->
                        <Border Grid.Row="3" Style="{StaticResource InnerCard}" Margin="0,6,0,0" Padding="8,5"
                                Visibility="{Binding SelectedAlert.HasKbMatch, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KB MATCH" Style="{StaticResource Meta}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedAlert.KbMatchLabel}"
                                           FontFamily="Bahnschrift Condensed" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#FFB84A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Detection layer chips row -->
                        <Border Grid.Row="4" Padding="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LAYERS" Style="{StaticResource Meta}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedAlert.DetectionLayersText}"
                                           FontFamily="Consolas" FontSize="8" Foreground="#00C8C8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Plausibility violation text -->
                        <Border Grid.Row="5" Padding="0,3,0,0"
                                Visibility="{Binding SelectedAlert.HasPlausibilityViolation, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PLAUSIBILITY" Style="{StaticResource Meta}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedAlert.PlausibilityText}"
                                           FontFamily="Consolas" FontSize="8" Foreground="#FF8C3A"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Recommended response (from incidents) -->
                        <Border Grid.Row="6" Padding="0,4,0,0"
                                Visibility="{Binding SelectedAlert.HasRecommendedResponse, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedAlert.RecommendedResponse}"
                                       FontFamily="Bahnschrift" FontSize="8" Foreground="#56F0AC"
                                       TextWrapping="Wrap" Opacity="0.85"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── COL 1: CHAT WITH AI ──────────────────────────────────────── -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="Auto"/>  <!-- alert context badge -->
                        <RowDefinition Height="Auto"/>  <!-- attack distribution -->
                        <RowDefinition Height="*"/>     <!-- chat messages / empty state -->
                        <RowDefinition Height="Auto"/>  <!-- input bar -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="CHAT WITH AI" Style="{StaticResource Title}"/>
                            <TextBlock Text="anomaly-grounded intel · Gemini · Ollama · RAG"
                                       Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Alert context badge (shows when alert selected) -->
                    <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="9,6"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONTEXT" Style="{StaticResource Meta}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAlert.CanId}" FontFamily="Consolas"
                                           FontSize="10" Foreground="#00C8C8" Margin="0,0,6,0"/>
                                <TextBlock Text="·" Foreground="#1A4040" FontFamily="Bahnschrift" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedAlert.Severity}" Style="{StaticResource SeverityText}" FontSize="9"/>
                                <TextBlock Text="·" Foreground="#1A4040" FontFamily="Bahnschrift" Margin="6,0"/>
                                <TextBlock Text="{Binding SelectedAlert.AttackType}" FontFamily="Bahnschrift"
                                           FontSize="9" Foreground="#2A5050"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedAlert.ScoreText}"
                                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexBrush}}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Attack type distribution -->
                    <Border Grid.Row="2" Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="9,7"
                            Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ATTACK DISTRIBUTION" Style="{StaticResource Meta}" Margin="0,0,0,6"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding AttackDistribution}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AttackTypeBarItem}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="8.5"
                                                       Foreground="#6E9090" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
                                                <Rectangle Height="6" HorizontalAlignment="Left"
                                                           Width="{Binding BarWidth}"
                                                           Fill="{Binding Color, Converter={StaticResource HexBrush}}"
                                                           Opacity="0.8" RadiusX="1" RadiusY="1"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontFamily="Consolas"
                                                       FontSize="8.5"
                                                       Foreground="{Binding Color, Converter={StaticResource HexBrush}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Empty state: no alert selected -->
                    <Border Grid.Row="3" Style="{StaticResource InnerCard}"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="SELECT AN ALERT" FontFamily="Bahnschrift Condensed" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#1A5050"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="The AI analyst will automatically explain the anomaly and answer your questions."
                                       FontFamily="Bahnschrift" FontSize="8.5" Foreground="#1A3A3A"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="280" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Chat message history (alert selected) -->
                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"
                                  Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}">
                        <ItemsControl x:Name="ChatList" ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <!-- User message (right-aligned) -->
                                        <Border HorizontalAlignment="Right" MaxWidth="400"
                                                Background="#0A1820" BorderBrush="#1A3850"
                                                BorderThickness="1" CornerRadius="2" Padding="10,7"
                                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontFamily="Bahnschrift" FontSize="10"
                                                           Foreground="#A0C0D8" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="7"
                                                           Foreground="#1E3A50" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- AI message (left-aligned) -->
                                        <Border HorizontalAlignment="Left" MaxWidth="500"
                                                BorderBrush="#1A4A4A" BorderThickness="1"
                                                CornerRadius="2" Padding="10,8"
                                                Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#0C1C1C" Offset="0"/>
                                                    <GradientStop Color="#081414" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ModeLabel}" FontFamily="Consolas" FontSize="8.5"
                                                           FontWeight="Bold" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Meta}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Mode}" Value="rule_based">
                                                                    <Setter Property="Foreground" Value="#C8A030"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Mode}" Value="gemini">
                                                                    <Setter Property="Foreground" Value="#56F0AC"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Mode}" Value="ollama">
                                                                    <Setter Property="Foreground" Value="#56F0AC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" FontFamily="Bahnschrift" FontSize="10"
                                                           Foreground="#90C8C0" TextWrapping="Wrap" LineHeight="16"/>
                                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="7"
                                                           Foreground="#1A3030" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chat input bar (alert selected) -->
                    <Grid Grid.Row="4" Margin="0,8,0,0"
                          Visibility="{Binding HasSelectedAlert, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#1E4050" BorderThickness="1" CornerRadius="2">
                            <TextBox Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0A1418" BorderThickness="0"
                                     Foreground="#B0D0D8" CaretBrush="#00C8C8"
                                     FontFamily="Bahnschrift" FontSize="10"
                                     Padding="10,7" VerticalContentAlignment="Center"
                                     MaxHeight="64" TextWrapping="Wrap" AcceptsReturn="False"/>
                        </Border>
                        <Button Grid.Column="1" Content="SEND" Style="{StaticResource TinyButton}"
                                Command="{Binding SendChatCommand}"
                                Margin="6,0,0,0" MinWidth="60" Height="32"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Row 3: Action bar ───────────────────────────────────────────── -->
        <Border Grid.Row="3" BorderBrush="#18009999" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="IDS INTEL" Style="{StaticResource Title}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="REFRESH ALERTS" Style="{StaticResource TinyButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                    <Button Content="SELECT FIRST" Style="{StaticResource TinyButton}"
                            Command="{Binding SelectAlertCommand}"
                            CommandParameter="{Binding Alerts[0]}" Margin="0,0,6,0"/>
                    <Button Content="EXPORT CSV" Style="{StaticResource TinyButton}"
                            Command="{Binding ExportAlertsCommand}" Margin="0,0,6,0"/>
                    <Button Content="EXPORT PDF" Style="{StaticResource TinyButton}"
                            Command="{Binding ExportPdfCommand}" Margin="0,0,6,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Row 4: Status bar ───────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ANOMALY INTELLIGENCE" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#56F0AC"
                       FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="LAYER FUSION 4-VECTOR" Foreground="#2A5050"
                       FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="timing · payload · ml · temporal"
                       Foreground="#1A3030" FontFamily="Consolas" FontSize="8" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="Gemini · Ollama · RAG" Foreground="#2A5050"
                       FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
