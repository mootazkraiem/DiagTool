<!--
  ===========================================================================
  ANOMALY INTEL  -  CANvision IDS
  ===========================================================================
  Composition rebuilt against the CANvision reference, in the visual language
  of the approved screens:

    [ TOTAL ALERTS | CRITICAL | HIGH / WARNING | AI ENGINE ]
    [ AI DETECTION                ] [ CHAT WITH AI                     ]
    [  threat timeline            ] [  context + attack distribution   ]
    [  alert list / selected      ] [  conversation                    ]
    [  refresh | first | csv | pdf] [  ask ...                  SEND   ]

  Presentation only: every binding and command is the view model's own.
  The threat timeline places each alert by its RelativePos (0-1) across the
  track's real width; the old canvas used a fixed 1000-unit X on a canvas of
  whatever width it had, which bunched the markers to one side.
  Named element ChatScrollViewer is used by the code-behind (auto-scroll).
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.AnomalyIntelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="AiLayerTrack" TargetType="Border">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource CvOverlay0EBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AiLayerValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ KPI STRIP ════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="11,12,11,0">
            <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                <Grid>
                    <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvTextBrightBrush}" Opacity="0.5"/>
                    <StackPanel Margin="12,11,10,0">
                        <cv:CvTrackedText Label="TOTAL ALERTS" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding Alerts.Count}" Style="{StaticResource CvTileValue}"/>
                        <cv:CvTrackedText Label="IDS EVENTS" Style="{StaticResource CvTileMeta}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                <Grid>
                    <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvDangerBrush}"/>
                    <StackPanel Margin="12,11,10,0">
                        <cv:CvTrackedText Label="CRITICAL" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource CvTileValue}"
                                   Foreground="{DynamicResource CvDangerBrush}" Effect="{DynamicResource CvDangerGlow}"/>
                        <cv:CvTrackedText Label="SCORE ≥ 0.80" Style="{StaticResource CvTileMeta}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                <Grid>
                    <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvWarnBrush}"/>
                    <StackPanel Margin="12,11,10,0">
                        <cv:CvTrackedText Label="HIGH / WARNING" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding HighCount}" Style="{StaticResource CvTileValue}"
                                   Foreground="{DynamicResource CvWarnBrush}"/>
                        <cv:CvTrackedText Label="SCORE ≥ 0.55" Style="{StaticResource CvTileMeta}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                <Grid>
                    <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvVioletBrush}"/>
                    <StackPanel Margin="12,11,10,0">
                        <cv:CvTrackedText Label="AI ENGINE" Style="{StaticResource CvCaps}"/>
                        <cv:CvTrackedText Label="{Binding EngineStatusText}" Style="{StaticResource CvTileValue}"
                                          FontSize="17" Foreground="{DynamicResource CvVioletSoftBrush}"
                                          Effect="{DynamicResource CvVioletGlow}"/>
                        <cv:CvTrackedText Label="{Binding EngineDetailText}" Style="{StaticResource CvTileMeta}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ═══ BODY ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*" MinWidth="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <!-- ── AI DETECTION ────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- threat timeline -->
                        <RowDefinition Height="*"/>      <!-- alert list -->
                        <RowDefinition Height="Auto"/>   <!-- selected alert -->
                        <RowDefinition Height="Auto"/>   <!-- actions -->
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                        <DockPanel>
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="AI DETECTION" Style="{StaticResource CvPanelTitle}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontFamily="{StaticResource CvMonoFont}" FontSize="9.5"
                                       Foreground="{DynamicResource CvTextSoftBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="12,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <!-- threat timeline: alerts across the session, click to select -->
                    <Grid Grid.Row="1" Margin="16,11,16,4"
                          Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <cv:CvTrackedText Label="TIMELINE" Style="{StaticResource CvCaps}" FontSize="9"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" x:Name="ThreatTrack" Height="20">
                            <Border Height="3" CornerRadius="1.5" Background="{DynamicResource CvOverlay14Brush}" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding TimelineMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="6.5"/>
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource PercentToOffsetConverter}" ConverterParameter="fraction">
                                                    <Binding Path="RelativePos"/>
                                                    <Binding Path="ActualWidth" ElementName="ThreatTrack"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TimelineMarker}">
                                        <!-- negative margin centres the dot on its position -->
                                        <Ellipse Width="7" Height="7" Margin="-3.5,0,0,0" Cursor="Hand"
                                                 Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                 ToolTip="{Binding CanId}">
                                            <Ellipse.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectMarkerAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Ellipse.InputBindings>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>

                    <!-- alert list -->
                    <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CvTableRow}" Height="Auto" MinHeight="42" Padding="16,6" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" Style="{StaticResource CvCell}"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CanId}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvAccentBrush}"/>
                                                <TextBlock Text="{Binding AttackType}" FontFamily="{StaticResource CvUiFont}" FontSize="10"
                                                           Foreground="{DynamicResource CvTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource CvCell}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource CvCell}"
                                                       FontSize="10" HorizontalAlignment="Right" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource CvTextSoftBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- empty state -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CvEmptyGlyph}">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/>
                        </Border>
                        <cv:CvTrackedText Label="NO IDS EVENTS" Style="{StaticResource CvCaps}"
                                          HorizontalAlignment="Center" Margin="0,11,0,0"/>
                        <TextBlock Text="Import a replay log to generate anomaly events for the analyst."
                                   Style="{StaticResource CvEmptyBody}"/>
                    </StackPanel>

                    <!-- selected alert: fusion score + per-layer contribution -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0" Padding="16,11,16,10"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedAlert.ScoreText}" FontFamily="{StaticResource CvDisplayFont}"
                                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                               Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                    <cv:CvTrackedText Label="FUSION" Style="{StaticResource CvCaps}" FontSize="9" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedAlert.Severity}" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource CvTextFaintBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedAlert.CanId}" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                                   Foreground="{DynamicResource CvAccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource CvMonoFont}" FontSize="10"
                                               Foreground="{DynamicResource CvTextSoftBrush}">
                                        <Run Text="{Binding SelectedAlert.AttackType, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedAlert.Time, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="17"/><RowDefinition Height="17"/>
                                    <RowDefinition Height="17"/><RowDefinition Height="17"/>
                                </Grid.RowDefinitions>

                                <cv:CvTrackedText Grid.Row="0" Label="TIMING" Style="{StaticResource CvCaps}" FontSize="9" VerticalAlignment="Center"/>
                                <Border Grid.Row="0" Grid.Column="1" x:Name="LayerTrack" Style="{StaticResource AiLayerTrack}" Margin="0,0,8,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource CvAccentBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToOffsetConverter}" ConverterParameter="fraction">
                                                <Binding Path="SelectedAlert.LayerTiming"/>
                                                <Binding Path="ActualWidth" ElementName="LayerTrack"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedAlert.LayerTiming, StringFormat=F3}"
                                           Style="{StaticResource AiLayerValue}" Foreground="{DynamicResource CvAccentBrush}"/>

                                <cv:CvTrackedText Grid.Row="1" Label="PAYLOAD" Style="{StaticResource CvCaps}" FontSize="9" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AiLayerTrack}" Margin="0,0,8,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource CvOkBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToOffsetConverter}" ConverterParameter="fraction">
                                                <Binding Path="SelectedAlert.LayerPayload"/>
                                                <Binding Path="ActualWidth" ElementName="LayerTrack"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedAlert.LayerPayload, StringFormat=F3}"
                                           Style="{StaticResource AiLayerValue}" Foreground="{DynamicResource CvOkBrush}"/>

                                <cv:CvTrackedText Grid.Row="2" Label="ML MODEL" Style="{StaticResource CvCaps}" FontSize="9" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AiLayerTrack}" Margin="0,0,8,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource CvVioletBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToOffsetConverter}" ConverterParameter="fraction">
                                                <Binding Path="SelectedAlert.LayerMl"/>
                                                <Binding Path="ActualWidth" ElementName="LayerTrack"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedAlert.LayerMl, StringFormat=F3}"
                                           Style="{StaticResource AiLayerValue}" Foreground="{DynamicResource CvVioletBrush}"/>

                                <cv:CvTrackedText Grid.Row="3" Label="TEMPORAL" Style="{StaticResource CvCaps}" FontSize="9" VerticalAlignment="Center"/>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource AiLayerTrack}" Margin="0,0,8,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource CvWarnBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToOffsetConverter}" ConverterParameter="fraction">
                                                <Binding Path="SelectedAlert.LayerTemporal"/>
                                                <Binding Path="ActualWidth" ElementName="LayerTrack"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedAlert.LayerTemporal, StringFormat=F3}"
                                           Style="{StaticResource AiLayerValue}" Foreground="{DynamicResource CvWarnBrush}"/>
                            </Grid>

                            <DockPanel Margin="0,8,0,0">
                                <cv:CvTrackedText Label="LAYERS" Style="{StaticResource CvCaps}" FontSize="9" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedAlert.DetectionLayersText}" FontFamily="{StaticResource CvMonoFont}"
                                           FontSize="10" Foreground="{DynamicResource CvAccentBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       Visibility="{Binding SelectedAlert.HasKbMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <cv:CvTrackedText Label="KB MATCH" Style="{StaticResource CvCaps}" FontSize="9" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedAlert.KbMatchLabel}" FontFamily="{StaticResource CvMonoFont}"
                                           FontSize="10" Foreground="{DynamicResource CvWarnBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       Visibility="{Binding SelectedAlert.HasPlausibilityViolation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <cv:CvTrackedText Label="PLAUSIBILITY" Style="{StaticResource CvCaps}" FontSize="9" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedAlert.PlausibilityText}" FontFamily="{StaticResource CvMonoFont}"
                                           FontSize="10" Foreground="{DynamicResource CvWarnBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedAlert.RecommendedResponse}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource CvUiFont}" FontSize="10.5" Foreground="{DynamicResource CvOkBrush}"
                                       Visibility="{Binding SelectedAlert.HasRecommendedResponse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- actions -->
                    <UniformGrid Grid.Row="4" Rows="1" Columns="4" Margin="12,6,12,12">
                        <Button Style="{StaticResource CvButtonGhost}" Height="32" Margin="4,0" Command="{Binding RefreshCommand}">
                            <cv:CvTrackedText Label="REFRESH ALERTS" FontFamily="{StaticResource CvDisplayFont}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource CvButtonGhost}" Height="32" Margin="4,0"
                                Command="{Binding SelectAlertCommand}" CommandParameter="{Binding FirstAlert}"
                                IsEnabled="{Binding HasAlerts}">
                            <cv:CvTrackedText Label="SELECT FIRST" FontFamily="{StaticResource CvDisplayFont}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource CvButtonGhost}" Height="32" Margin="4,0" Command="{Binding ExportAlertsCommand}">
                            <cv:CvTrackedText Label="EXPORT CSV" FontFamily="{StaticResource CvDisplayFont}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource CvButtonGhost}" Height="32" Margin="4,0" Command="{Binding ExportPdfCommand}">
                            <cv:CvTrackedText Label="EXPORT PDF" FontFamily="{StaticResource CvDisplayFont}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ── CHAT WITH AI ────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- context -->
                        <RowDefinition Height="Auto"/>   <!-- attack distribution -->
                        <RowDefinition Height="*"/>      <!-- conversation -->
                        <RowDefinition Height="Auto"/>   <!-- input -->
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                        <DockPanel>
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"
                                       Fill="{DynamicResource CvVioletBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="CHAT WITH AI" Style="{StaticResource CvPanelTitle}"/>
                            <TextBlock DockPanel.Dock="Left" Text="anomaly-grounded · Gemini · Ollama · RAG" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontFamily="{StaticResource CvMonoFont}" FontSize="9.5"
                                       Foreground="{DynamicResource CvTextDimBrush}"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource CvBadge}" HorizontalAlignment="Right" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource CvStatusDot}" Width="6" Height="6"/>
                                    <cv:CvTrackedText Label="{Binding EngineStatusText}" Margin="7,0,0,0"
                                                      FontFamily="{StaticResource CvMonoFont}" FontSize="9.5"
                                                      Foreground="{DynamicResource CvAccentDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- context of the selected alert -->
                    <Border Grid.Row="1" Style="{StaticResource CvInset}" Margin="16,12,16,0" Padding="12,8"
                            Visibility="{Binding HasSelectedAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="CONTEXT" Style="{StaticResource CvCaps}" FontSize="9"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAlert.ScoreText}" FontFamily="{StaticResource CvMonoFont}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding SelectedAlert.SeverityColor, Converter={StaticResource HexColorToBrushConverter}}"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SelectedAlert.CanId, Mode=OneWay}" Foreground="{DynamicResource CvAccentBrush}"/><Run Text="  ·  " Foreground="{DynamicResource CvTextFaintBrush}"/><Run Text="{Binding SelectedAlert.Severity, Mode=OneWay}" Foreground="{DynamicResource CvWarnBrush}"/><Run Text="  ·  " Foreground="{DynamicResource CvTextFaintBrush}"/><Run Text="{Binding SelectedAlert.AttackType, Mode=OneWay}" Foreground="{DynamicResource CvTextSoftBrush}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- attack distribution across all alerts -->
                    <Border Grid.Row="2" Style="{StaticResource CvInset}" Margin="16,10,16,0" Padding="12,9"
                            Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <cv:CvTrackedText Label="ATTACK DISTRIBUTION" Style="{StaticResource CvCaps}" FontSize="9" Margin="0,0,0,7"/>
                            <ItemsControl ItemsSource="{Binding AttackDistribution}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AttackTypeBarItem}">
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource CvMonoFont}" FontSize="10"
                                                       Foreground="{DynamicResource CvTextSoftBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Rectangle Grid.Column="1" Height="6" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"
                                                       Width="{Binding BarWidth}" Opacity="0.85" VerticalAlignment="Center"
                                                       Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontFamily="{StaticResource CvMonoFont}"
                                                       FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- no alert selected -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedAlert, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CvEmptyGlyph}">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource CvVioletBrush}" Opacity="0.6"/>
                        </Border>
                        <cv:CvTrackedText Label="SELECT AN ALERT" Style="{StaticResource CvCaps}"
                                          HorizontalAlignment="Center" Margin="0,11,0,0"/>
                        <TextBlock Text="The analyst explains the anomaly, the CAN IDs involved and the likely attack class, then answers follow-up questions."
                                   Style="{StaticResource CvEmptyBody}" MaxWidth="360"/>
                    </StackPanel>

                    <!-- conversation (x:Name used by the code-behind to auto-scroll) -->
                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="3" Margin="16,12,16,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelectedAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl x:Name="ChatList" ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Border HorizontalAlignment="Right" MaxWidth="440" CornerRadius="3" Padding="11,8"
                                                Background="#0F2FF0D6" BorderBrush="#332FF0D6" BorderThickness="1"
                                                Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CvUiFont}" FontSize="11.5"
                                                           Foreground="{DynamicResource CvTextBrightBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource CvMonoFont}" FontSize="9"
                                                           Foreground="{DynamicResource CvTextDimBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border HorizontalAlignment="Left" MaxWidth="560" CornerRadius="3" Padding="12,9"
                                                Background="{DynamicResource CvTileBrush}" BorderBrush="{DynamicResource CvBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ModeLabel}" FontFamily="{StaticResource CvMonoFont}" FontSize="9.5"
                                                           FontWeight="Bold" Margin="0,0,0,5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Mode}" Value="rule_based">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Mode}" Value="gemini">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Mode}" Value="ollama">
                                                                    <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource CvUiFont}" FontSize="11.5"
                                                           Foreground="{DynamicResource CvTextBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource CvMonoFont}" FontSize="9"
                                                           Foreground="{DynamicResource CvTextDimBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- input -->
                    <Grid Grid.Row="4" Margin="16,10,16,14"
                          Visibility="{Binding HasSelectedAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource CvTextBox}" MinHeight="36" MaxHeight="72"
                                 Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Center"
                                 ToolTip="Ask the analyst about the selected alert"/>
                        <Button Grid.Column="1" Style="{StaticResource CvButtonPrimary}" Command="{Binding SendChatCommand}"
                                MinWidth="84" Height="36" Margin="8,0,0,0">
                            <cv:CvTrackedText Label="SEND" FontFamily="{StaticResource CvDisplayFont}" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
