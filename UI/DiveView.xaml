<UserControl
    x:Class="CANvision.Native.UI.DiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#11161C">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                x:Name="LineOneText"
                x:FieldModifier="public"
                Margin="0,0,0,10"
                Foreground="#E6F3FF"
                FontSize="28"
                FontWeight="SemiBold"
                Text="" />
            <TextBlock
                x:Name="LineTwoText"
                x:FieldModifier="public"
                Margin="0,0,0,24"
                Foreground="#8CCFFF"
                FontSize="20"
                Text="" />
            <ProgressBar Width="360" Height="12" IsIndeterminate="True" />
        </StackPanel>
    </Grid>
</UserControl>
