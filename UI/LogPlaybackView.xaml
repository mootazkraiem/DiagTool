<UserControl
    x:Class="CANvision.Native.UI.LogPlaybackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    Background="#060E0E">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1A1A" Offset="0"/>
                        <GradientStop Color="#0A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#28009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#3A6060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#2A4A4A"/>
        </Style>

        <Style x:Key="HeaderPod" TargetType="Border">
            <Setter Property="BorderBrush" Value="#162F6666"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        </Style>

        <Style x:Key="SpeedButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="8.5"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#08000000"/>
            <Setter Property="BorderBrush" Value="#1A2F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Ambient radial glow -->
        <Rectangle Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.38" RadiusX="0.55" RadiusY="0.48">
                    <GradientStop Color="#08001818" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ── ROW 0: HEADER ─────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="#18009999" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transport controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource TransportButton}" Command="{Binding RewindCommand}" Content="⏮" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding PlayCommand}"   Content="▶"  Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding PauseCommand}" Content="⏸" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding StopCommand}"  Content="■"  Margin="0,0,4,0"/>
                    <Button Style="{StaticResource TransportButton}" Command="{Binding ForwardCommand}" Content="⏭"/>
                </StackPanel>

                <!-- Speed buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SpeedButton}" Command="{Binding SetSpeedCommand}" CommandParameter="1"  Content="1x"  Margin="0,0,3,0"/>
                    <Button Style="{StaticResource SpeedButton}" Command="{Binding SetSpeedCommand}" CommandParameter="2"  Content="2x"  Margin="0,0,3,0"/>
                    <Button Style="{StaticResource SpeedButton}" Command="{Binding SetSpeedCommand}" CommandParameter="4"  Content="4x"  Margin="0,0,3,0"/>
                    <Button Style="{StaticResource SpeedButton}" Command="{Binding SetSpeedCommand}" CommandParameter="8"  Content="8x"  Margin="0,0,3,0"/>
                    <Button Style="{StaticResource SpeedButton}" Command="{Binding SetSpeedCommand}" CommandParameter="32" Content="MAX"/>
                </StackPanel>

                <!-- Status pods — right side -->
                <Border Grid.Column="4" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FILE" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding LoadedFileName}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FRAMES" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding ProcessedFramesText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STATE" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding PlaybackMode}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="7" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SPEED" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding PlaybackSpeedText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource HeaderPod}" Padding="14,0,18,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ML ANALYSIS" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding MlAnalysisStateText}" Foreground="#FF8C3A" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── ROW 1: REPLAY TIMELINE ────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="14,12,14,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Title + import button -->
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource HudActionButtonStyle}"
                            Command="{Binding OpenLogCommand}"
                            Content="IMPORT SESSION"
                            Height="22" Padding="8,0" FontSize="8.5"/>
                    <TextBlock Text="REPLAY TIMELINE" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TimelineEmptyStateText}" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>

                <!-- 5-track timeline -->
                <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Playback"      Foreground="#00C8C8" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Detections"   Foreground="#FF8C3A" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Alerts"       Foreground="#FF5050" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="Ground Truth" Foreground="#B46CFF" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="Attack Wnd"   Foreground="#FF716C" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Grid.RowSpan="5" x:Name="TimelineGrid"
                          SizeChanged="TimelineGrid_SizeChanged"
                          Background="#05000000" ClipToBounds="True">

                        <UniformGrid Rows="5" IsHitTestVisible="False">
                            <Border BorderBrush="#142F6666" BorderThickness="0,0,0,1"/>
                            <Border BorderBrush="#142F6666" BorderThickness="0,0,0,1"/>
                            <Border BorderBrush="#142F6666" BorderThickness="0,0,0,1"/>
                            <Border BorderBrush="#142F6666" BorderThickness="0,0,0,1"/>
                            <Border BorderBrush="#142F6666" BorderThickness="0,0,0,1"/>
                        </UniformGrid>
                        <UniformGrid Columns="8" IsHitTestVisible="False">
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#102F6666" BorderThickness="1,0,0,1"/>
                        </UniformGrid>

                        <Canvas x:Name="TimelineCanvas" Width="920" Height="150"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                ClipToBounds="False" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="TimelineScale" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>

                            <!-- Axis labels -->
                            <TextBlock Canvas.Left="0"   Canvas.Top="2" Text="{Binding TimelineStartText}"        Foreground="#6E9090" FontFamily="Consolas" FontSize="8"/>
                            <TextBlock Canvas.Left="230" Canvas.Top="2" Text="{Binding TimelineQuarterText}"      Foreground="#6E9090" FontFamily="Consolas" FontSize="8"/>
                            <TextBlock Canvas.Left="460" Canvas.Top="2" Text="{Binding TimelineMidText}"          Foreground="#6E9090" FontFamily="Consolas" FontSize="8"/>
                            <TextBlock Canvas.Left="690" Canvas.Top="2" Text="{Binding TimelineThreeQuarterText}" Foreground="#6E9090" FontFamily="Consolas" FontSize="8"/>
                            <TextBlock Canvas.Left="876" Canvas.Top="2" Text="{Binding TimelineEndText}"          Foreground="#6E9090" FontFamily="Consolas" FontSize="8"/>

                            <!-- Progress fill -->
                            <Rectangle Canvas.Left="0" Canvas.Top="14" Width="920" Height="8" Fill="#1800C8C8"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="14" Width="{Binding PlaybackCursorLeft}" Height="8" Fill="#5500C8C8"/>

                            <!-- Attack windows -->
                            <ItemsControl ItemsSource="{Binding TimelineWindows}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="14" Fill="{Binding Color}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Markers: cursor + detection dots -->
                            <ItemsControl ItemsSource="{Binding TimelineMarkers}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Rectangle Width="1" Height="136" Fill="{Binding Color}" Opacity="0.8">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Border Background="#08000000" BorderBrush="{Binding Color}" BorderThickness="1" Padding="3,1" Margin="-7,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                            </Border>
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="-3,-3,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- Bottom: zoom controls + legend -->
                <Grid Grid.Row="2" Margin="96,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource HudActionButtonStyle}" Width="26" Height="20" FontSize="10" Content="⌕+" Padding="0"/>
                    <Button Grid.Column="1" Style="{StaticResource HudActionButtonStyle}" Width="26" Height="20" FontSize="10" Content="⌕-" Padding="0" Margin="4,0,0,0"/>
                    <Slider  Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding ReplayProgressPercent, Mode=OneWay}" IsHitTestVisible="False" Height="20" Margin="10,0"/>
                    <!-- Legend -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="8" Height="8" Fill="#FF8C3A" Margin="0,0,4,0"/>
                        <TextBlock Text="Detections" Style="{StaticResource Meta}" Margin="0,0,12,0"/>
                        <Rectangle Width="8" Height="8" Fill="#FF5050" Margin="0,0,4,0"/>
                        <TextBlock Text="Alerts" Style="{StaticResource Meta}" Margin="0,0,12,0"/>
                        <Rectangle Width="8" Height="8" Fill="#B46CFF" Margin="0,0,4,0"/>
                        <TextBlock Text="Ground Truth" Style="{StaticResource Meta}" Margin="0,0,12,0"/>
                        <Rectangle Width="14" Height="7" Fill="#AAFF5050" Margin="0,0,4,0"/>
                        <TextBlock Text="Attack Windows" Style="{StaticResource Meta}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ROW 2: DETECTION ANALYSIS ─────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="14,0,14,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title + live investigation inline -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DETECTION ANALYSIS" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- Live status inline -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SCORE" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentAnomalyScoreText}" Foreground="#FF716C" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="#1E3A3A" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDetectionText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="#1E3A3A" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentAttackTypeText}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="#1E3A3A" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTimestampText}" Foreground="#6E9090" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Chart — full width via Viewbox, legend overlaid in a Grid -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Border Background="#05000000" BorderBrush="#102F6666" BorderThickness="1" ClipToBounds="True">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="920" Height="126" ClipToBounds="True">
                                <UniformGrid Width="920" Height="126" Rows="4">
                                    <Border BorderBrush="#102F6666" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,1,0,0"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,1,0,1"/>
                                </UniformGrid>
                                <Polyline Points="{Binding DetectionThresholdPoints}" Stroke="#FF5050" StrokeDashArray="4 3" StrokeThickness="1.2"/>
                                <Polygon  Points="{Binding DetectionScorePoints}"     Fill="#551EC8DC" Stroke="#1EC8DC" StrokeThickness="1.4"/>
                                <Polyline Points="{Binding LiveScorePoints}"          Stroke="#00F0F0" StrokeThickness="2"/>
                                <Line X1="{Binding LiveChartCursorX}" Y1="0" X2="{Binding LiveChartCursorX}" Y2="130" Stroke="#B8C8D0" StrokeThickness="1" Opacity="0.7"/>
                                <ItemsControl ItemsSource="{Binding DetectionMarkers}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top"  Value="4"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="⬟" Foreground="#FF8C3A" FontFamily="Segoe UI Symbol" FontSize="10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <!-- Legend overlay -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,6,0,0" IsHitTestVisible="False">
                        <Rectangle Width="12" Height="2" Fill="#00C8C8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Anomaly Score"      Foreground="#D0ECEC" FontFamily="Consolas" FontSize="8" Margin="0,0,18,0"/>
                        <Rectangle Width="12" Height="2" Fill="#FF5050" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Detection Threshold" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="8" Margin="0,0,18,0"/>
                        <TextBlock Text="⬟" Foreground="#FF8C3A" FontFamily="Segoe UI Symbol" FontSize="9" Margin="0,0,5,0"/>
                        <TextBlock Text="Detections"         Foreground="#D0ECEC" FontFamily="Consolas" FontSize="8"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ROW 3: BOTTOM 4 KPI STRIP ─────────────────────────────── -->
        <Border Grid.Row="3" BorderBrush="#18009999" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <UniformGrid Columns="4" Margin="14,8">
                <!-- REPLAY PROGRESS -->
                <Border Style="{StaticResource KpiCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="REPLAY PROGRESS" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding ReplayProgressText}" Foreground="#00C8C8"
                                   FontFamily="Bahnschrift" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ProcessedFramesText}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- ANOMALY SCORE -->
                <Border Style="{StaticResource KpiCard}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="ANOMALY SCORE" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding CurrentAnomalyScoreText}" Foreground="#FF716C"
                                   FontFamily="Bahnschrift" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding CurrentDetectionText}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- TOTAL DETECTIONS -->
                <Border Style="{StaticResource KpiCard}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="DETECTIONS" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding TotalDetectionsText}" Foreground="#FF8C3A"
                                   FontFamily="Bahnschrift" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DetectionRateText, StringFormat='Rate: {0}'}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- ALERTS -->
                <Border Style="{StaticResource KpiCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ALERTS" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding AlertCountText}" Foreground="#FF5050"
                                   FontFamily="Bahnschrift" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding AttackCoverageText, StringFormat='Coverage: {0}'}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
