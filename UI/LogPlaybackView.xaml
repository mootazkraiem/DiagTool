<UserControl
    x:Class="CANvision.Native.UI.LogPlaybackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#050D0D">

    <UserControl.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D1717" Offset="0"/>
                        <GradientStop Color="#091010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#1E009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="CardHead" TargetType="Border">
            <Setter Property="BorderBrush" Value="#12009999"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,9"/>
        </Style>

        <Style x:Key="CardBody" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="7.5"/>
            <Setter Property="Foreground" Value="#254040"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#336666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HeaderPod" TargetType="Border">
            <Setter Property="BorderBrush" Value="#0F2F5050"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="TBtn" TargetType="Button"
               BasedOn="{StaticResource HudCommandButtonBaseStyle}">
            <Setter Property="Width"     Value="30"/>
            <Setter Property="Height"    Value="26"/>
            <Setter Property="MinWidth"  Value="30"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding"   Value="0"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        </Style>

        <Style x:Key="SBtn" TargetType="Button"
               BasedOn="{StaticResource HudCommandButtonBaseStyle}">
            <Setter Property="Height"    Value="22"/>
            <Setter Property="MinWidth"  Value="30"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding"   Value="7,0"/>
            <Setter Property="FontSize"  Value="8.5"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button"
               BasedOn="{StaticResource HudCommandButtonBaseStyle}">
            <Setter Property="Height"    Value="24"/>
            <Setter Property="MinWidth"  Value="80"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding"   Value="9,0"/>
            <Setter Property="FontSize"  Value="8"/>
        </Style>

        <!-- Card section title with icon chip -->
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Bahnschrift"/>
            <Setter Property="FontSize"     Value="11.5"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#C0D8D8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Stat box (ANOMALY SCORE / THRESHOLD / DETECTIONS / STATUS) -->
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0E1C1C" Offset="0"/>
                        <GradientStop Color="#091111" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#16294040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Side-panel metric tile -->
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="#0A1515"/>
            <Setter Property="BorderBrush" Value="#10203030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- Bottom card -->
        <Style x:Key="BottomCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D1717" Offset="0"/>
                        <GradientStop Color="#091010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#1E009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="TrackLbl" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- controls bar -->
            <RowDefinition Height="Auto"/> <!-- timeline -->
            <RowDefinition Height="*"/>    <!-- detection analysis + side panel -->
            <RowDefinition Height="Auto"/> <!-- offline results banner (collapses when not done) -->
            <RowDefinition Height="Auto"/> <!-- bottom cards -->
        </Grid.RowDefinitions>

        <!-- ambient glow -->
        <Rectangle Grid.RowSpan="5" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.3" Center="0.5,0.3"
                                     RadiusX="0.55" RadiusY="0.45">
                    <GradientStop Color="#08001515" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 — CONTROLS BAR
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" BorderBrush="#14009999" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A1414" Offset="0"/>
                    <GradientStop Color="#060C0C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- session/file info -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>  <!-- transport controls -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>  <!-- speed buttons -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>  <!-- CONNECTION pod -->
                    <ColumnDefinition Width="Auto"/>  <!-- FRAMES pod -->
                    <ColumnDefinition Width="Auto"/>  <!-- STATE pod -->
                    <ColumnDefinition Width="Auto"/>  <!-- SPEED pod -->
                    <ColumnDefinition Width="Auto"/>  <!-- ML ANALYSIS pod -->
                    <ColumnDefinition Width="Auto"/>  <!-- OPEN FILE -->
                    <ColumnDefinition Width="Auto"/>  <!-- RECORD pod -->
                </Grid.ColumnDefinitions>

                <!-- Session / File labels -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Session: " Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding SessionNameText}" Foreground="#B0CCCC"
                                   FontFamily="Consolas" FontSize="8.5"/>
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="5,0,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatusText}" Value="SIMULATION">
                                            <Setter Property="Fill" Value="#FF8C3A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Text="File: " Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding FileNameShortText}" Foreground="#3A5858"
                                   FontFamily="Consolas" FontSize="8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Transport controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TBtn}" Command="{Binding RewindCommand}"  Content="⏮" Margin="0,0,3,0" IsEnabled="{Binding HasReplayLoaded}" ToolTip="Import a replay log first"/>
                    <Button Style="{StaticResource TBtn}" Command="{Binding PlayCommand}"    Content="▶"  Margin="0,0,3,0" IsEnabled="{Binding HasReplayLoaded}" ToolTip="Import a replay log first"/>
                    <Button Style="{StaticResource TBtn}" Command="{Binding PauseCommand}"  Content="⏸" Margin="0,0,3,0" IsEnabled="{Binding HasReplayLoaded}" ToolTip="Import a replay log first"/>
                    <Button Style="{StaticResource TBtn}" Command="{Binding StopCommand}"   Content="■"  Margin="0,0,3,0" IsEnabled="{Binding HasReplayLoaded}" ToolTip="Import a replay log first"/>
                    <Button Style="{StaticResource TBtn}" Command="{Binding ForwardCommand}" Content="⏭" IsEnabled="{Binding HasReplayLoaded}" ToolTip="Import a replay log first"/>
                </StackPanel>

                <!-- Speed buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="0.5" Content="0.5x" Margin="0,0,2,0"/>
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="1"   Content="1x"   Margin="0,0,2,0"/>
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="2"   Content="2x"   Margin="0,0,2,0"/>
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="4"   Content="4x"   Margin="0,0,2,0"/>
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="8"   Content="8x"   Margin="0,0,2,0"/>
                    <Button Style="{StaticResource SBtn}" Command="{Binding SetSpeedCommand}" CommandParameter="32"  Content="MAX"/>
                </StackPanel>

                <!-- CONNECTION pod -->
                <Border Grid.Column="6" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Connection" Style="{StaticResource Meta}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionStatusText}" Value="SIMULATION">
                                                <Setter Property="Fill" Value="#FF8C3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionStatusText}" Value="SIMULATION">
                                                <Setter Property="Foreground" Value="#FF8C3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FRAMES pod -->
                <Border Grid.Column="7" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Frames" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding ProcessedFramesText}" Foreground="#B0CCCC"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- STATE pod -->
                <Border Grid.Column="8" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="State" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding PlaybackMode}" Foreground="#56F0AC"
                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding OfflineStatusText}"
                                   Foreground="#5AB4A4" FontFamily="Consolas" FontSize="7.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                   ToolTip="{Binding OfflineStatusText}"/>
                    </StackPanel>
                </Border>

                <!-- SPEED pod -->
                <Border Grid.Column="9" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Speed" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding PlaybackSpeedText}" Foreground="#B0CCCC"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- ML ANALYSIS pod -->
                <Border Grid.Column="10" Style="{StaticResource HeaderPod}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ML Analysis" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding MlAnalysisStateText}" Foreground="#FF8C3A"
                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- OPEN FILE + vehicle selector -->
                <Border Grid.Column="11" Style="{StaticResource HeaderPod}" Padding="10,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostBtn}"
                                Command="{Binding OpenLogCommand}"
                                Content="OPEN FILE"
                                Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding VehicleItems}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedVehicleId, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="140" Height="22"
                                  FontFamily="Consolas" FontSize="8"
                                  Foreground="#8AACAC" Background="#0A1414"
                                  BorderBrush="#1A3A3A"
                                  ToolTip="Select vehicle profile for DBC decode (used when opening MF4 files)"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="8"/>
                                    <Setter Property="Foreground" Value="#8AACAC"/>
                                    <Setter Property="Background" Value="#0D1818"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- RECORD pod -->
                <Border Grid.Column="12" Style="{StaticResource HeaderPod}" Padding="12,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostBtn}"
                                Command="{Binding StartRecordCommand}"
                                Margin="0,0,3,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#FF4444"
                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="REC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Style="{StaticResource GhostBtn}"
                                Command="{Binding InjectTestCommand}"
                                Content="REC+INJECT"
                                Margin="0,0,3,0"
                                ToolTip="Start recording and launch live attack simulator"/>
                        <Button Style="{StaticResource GhostBtn}"
                                Command="{Binding StopRecordCommand}"
                                Content="STOP"
                                Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecordStatusText}"
                                       FontFamily="Consolas" FontSize="8.5"
                                       Foreground="#FF4444"/>
                            <TextBlock Text="{Binding RecordingElapsedText}"
                                       FontFamily="Consolas" FontSize="8"
                                       Foreground="#336666"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 1 — REPLAY TIMELINE
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="10,8,10,4">

            <!-- Card header -->
            <StackPanel>
                <Border Style="{StaticResource CardHead}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="12" Background="#00C8C8"
                                CornerRadius="1" Margin="0,0,8,0"/>
                        <TextBlock Text="REPLAY TIMELINE" Style="{StaticResource SecTitle}"/>
                        <TextBlock Text="{Binding SessionDurationText, StringFormat='   Total Duration: {0}'}"
                                   Foreground="#2A4040"
                                   FontFamily="Consolas" FontSize="9"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Time axis row -->
                <Grid Margin="14,5,14,0" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimelineStartText}"
                                   Foreground="#3A5858" FontFamily="Consolas" FontSize="8"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineQuarterText}"
                                   Foreground="#3A5858" FontFamily="Consolas" FontSize="8"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimelineMidText}"
                                   Foreground="#3A5858" FontFamily="Consolas" FontSize="8"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="{Binding TimelineThreeQuarterText}"
                                   Foreground="#3A5858" FontFamily="Consolas" FontSize="8"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="4" Text="{Binding TimelineEndText}"
                                   Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                    </Grid>
                </Grid>

                <!-- 5 track rows -->
                <Grid Margin="14,2,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>  <!-- right gutter for "..." dots -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Labels with check-style accent -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" Background="#1800C8C8" BorderBrush="#00C8C8"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0">
                            <TextBlock Text="✓" Foreground="#00C8C8" FontSize="6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Playback"      Foreground="#00C8C8" Style="{StaticResource TrackLbl}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" Background="#18FF8C3A" BorderBrush="#FF8C3A"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0">
                            <TextBlock Text="✓" Foreground="#FF8C3A" FontSize="6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Detections"    Foreground="#FF8C3A" Style="{StaticResource TrackLbl}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" Background="#18FF5050" BorderBrush="#FF5050"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0">
                            <TextBlock Text="✓" Foreground="#FF5050" FontSize="6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alerts"        Foreground="#FF5050" Style="{StaticResource TrackLbl}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" Background="#18B46CFF" BorderBrush="#B46CFF"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0">
                            <TextBlock Text="✓" Foreground="#B46CFF" FontSize="6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ground Truth"  Foreground="#B46CFF" Style="{StaticResource TrackLbl}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="9" Height="9" Background="#18FF716C" BorderBrush="#FF716C"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0">
                            <TextBlock Text="✓" Foreground="#FF716C" FontSize="6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Attack Wind."  Foreground="#FF716C" Style="{StaticResource TrackLbl}"/>
                    </StackPanel>

                    <!-- Scaled canvas covering all 5 rows -->
                    <Grid Grid.Column="1" Grid.RowSpan="5"
                          x:Name="TimelineGrid" SizeChanged="TimelineGrid_SizeChanged"
                          ClipToBounds="True">

                        <!-- alternating row fills -->
                        <UniformGrid Rows="5" IsHitTestVisible="False">
                            <Border Background="#04001818"/>
                            <Border Background="#03FF8C3A" Opacity="0.3"/>
                            <Border Background="#03FF5050" Opacity="0.25"/>
                            <Border Background="#03B46CFF" Opacity="0.25"/>
                            <Border Background="#03FF716C" Opacity="0.28"/>
                        </UniformGrid>

                        <!-- vertical grid separators -->
                        <UniformGrid Columns="6" IsHitTestVisible="False">
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#09294040" BorderThickness="1,0,0,1"/>
                        </UniformGrid>

                        <!-- outer frame -->
                        <Border BorderBrush="#12294040" BorderThickness="1" IsHitTestVisible="False"/>

                        <!-- single coordinate space: 0-920 × 130 scaled to fill -->
                        <Canvas x:Name="TimelineCanvas" Width="920" Height="130"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                ClipToBounds="False" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="TimelineScale" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>

                            <!-- progress fill (track 0) -->
                            <Rectangle Canvas.Left="0" Canvas.Top="11"
                                       Width="920" Height="4" Fill="#0D00C8C8"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="11"
                                       Width="{Binding PlaybackCursorLeft}" Height="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3300B4B4" Offset="0"/>
                                        <GradientStop Color="#6600E0E0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- attack window dots -->
                            <ItemsControl ItemsSource="{Binding TimelineWindows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{Binding Color}" Opacity="0.9"
                                                 Margin="-3,-3,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- markers: cursor line + thin tick marks -->
                            <ItemsControl ItemsSource="{Binding TimelineMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- CURSOR: full-height line -->
                                            <Rectangle Width="1.5" Height="130"
                                                       Fill="{Binding Color}" Opacity="0.85">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <!-- CURSOR: floating label -->
                                            <Border Background="#CC060E0E" BorderBrush="{Binding Color}"
                                                    BorderThickness="1" Padding="4,1"
                                                    Margin="-10,-13,0,0" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{Binding Color}"
                                                           FontFamily="Consolas" FontSize="7"/>
                                            </Border>
                                            <!-- NON-CURSOR: dot -->
                                            <Ellipse Width="7" Height="7"
                                                     Fill="{Binding Color}" Opacity="0.85"
                                                     Margin="-3,-3,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Label}" Value="CURSOR">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>

                    <!-- right "..." density dots (decorative) -->
                    <StackPanel Grid.Column="2" Grid.RowSpan="5" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Ellipse Width="3" Height="3" Fill="#1E3A3A" Margin="2,2"/>
                        <Ellipse Width="3" Height="3" Fill="#1E3A3A" Margin="2,2"/>
                        <Ellipse Width="3" Height="3" Fill="#1E3A3A" Margin="2,2"/>
                    </StackPanel>
                </Grid>

                <!-- Scrub bar + legend -->
                <Grid Margin="14,3,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                            Value="{Binding ReplayProgressPercent, Mode=OneWay}"
                            IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <Rectangle Width="2" Height="8" Fill="#FF8C3A" RadiusX="1" RadiusY="1"/>
                        <TextBlock Text=" Det." Style="{StaticResource Meta}" Margin="0,0,8,0"/>
                        <Rectangle Width="2" Height="8" Fill="#FF5050" RadiusX="1" RadiusY="1"/>
                        <TextBlock Text=" Alerts" Style="{StaticResource Meta}" Margin="0,0,8,0"/>
                        <Rectangle Width="2" Height="8" Fill="#B46CFF" RadiusX="1" RadiusY="1"/>
                        <TextBlock Text=" GT" Style="{StaticResource Meta}" Margin="0,0,8,0"/>
                        <Rectangle Width="8" Height="6" Fill="#AAFF716C" RadiusX="1" RadiusY="1"/>
                        <TextBlock Text=" Atk Wind" Style="{StaticResource Meta}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 — DETECTION ANALYSIS (left) + METRICS PANEL (right)
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="10,0,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Detection Analysis card ── -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHead}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="12" Background="#00C8C8"
                                        CornerRadius="1" Margin="0,0,8,0"/>
                                <TextBlock Text="DETECTION ANALYSIS" Style="{StaticResource SecTitle}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Time Range" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border BorderBrush="#1A2F4040" BorderThickness="1"
                                        CornerRadius="3" Padding="8,3">
                                    <TextBlock Text="Full Session" Foreground="#4A7070"
                                               FontFamily="Consolas" FontSize="8.5"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4 stat boxes -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="12,8,12,0">
                        <!-- ANOMALY SCORE -->
                        <Border Style="{StaticResource StatBox}" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- mini sparkline overlay top-right -->
                                <Border Grid.Row="0" Grid.RowSpan="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="80" Height="22" ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="80" Height="22">
                                            <Polyline Points="{Binding AnomalyScoreSparkPoints}"
                                                      Stroke="#00C8C8" StrokeThickness="1.5" Opacity="0.5"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Row="0" Text="ANOMALY SCORE" Style="{StaticResource Lbl}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CurrentAnomalyScoreText}"
                                               Foreground="#00C8C8"
                                               FontFamily="Bahnschrift" FontSize="22"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text=" /1.00" Foreground="#254040"
                                               FontFamily="Consolas" FontSize="10"
                                               VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- THRESHOLD -->
                        <Border Style="{StaticResource StatBox}" Margin="2,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- static flat-line sparkline overlay top-right -->
                                <Border Grid.Row="0" Grid.RowSpan="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="80" Height="22" ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="80" Height="22">
                                            <Polyline Points="0,13 80,13"
                                                      Stroke="#CC3030" StrokeThickness="1.5"
                                                      StrokeDashArray="5 3" Opacity="0.55"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="⚠" Foreground="#FF5050" FontSize="8"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="THRESHOLD" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="0.60"
                                           Foreground="#FF5050"
                                           FontFamily="Bahnschrift" FontSize="22"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                        <!-- DETECTIONS -->
                        <Border Style="{StaticResource StatBox}" Margin="2,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="⬟" Foreground="#FF8C3A" FontSize="8"
                                               FontFamily="Segoe UI Symbol"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DETECTIONS" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding TotalDetectionsText}"
                                           Foreground="#FF8C3A"
                                           FontFamily="Bahnschrift" FontSize="22"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="Total" Style="{StaticResource Meta}"/>
                            </Grid>
                        </Border>
                        <!-- STATUS -->
                        <Border Style="{StaticResource StatBox}" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="STATUS" Style="{StaticResource Lbl}"/>
                                <TextBlock Grid.Row="1" Text="{Binding CurrentDetectionText}"
                                           Foreground="#56F0AC"
                                           FontFamily="Bahnschrift" FontSize="18"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="No anomalies detected"
                                           Style="{StaticResource Meta}"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Chart with Y-axis -->
                    <Grid Grid.Row="2" Margin="12,8,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/> <!-- Y-axis labels -->
                            <ColumnDefinition Width="*"/>  <!-- chart area -->
                        </Grid.ColumnDefinitions>

                        <!-- Y-axis -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="1.00" Foreground="#2A4040"
                                       FontFamily="Consolas" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="1" Text="0.75" Foreground="#2A4040"
                                       FontFamily="Consolas" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="2" Text="0.50" Foreground="#2A4040"
                                       FontFamily="Consolas" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="3" Text="0.25" Foreground="#2A4040"
                                       FontFamily="Consolas" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="4" Text="0.00" Foreground="#2A4040"
                                       FontFamily="Consolas" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                        </Grid>

                        <!-- chart canvas (Viewbox-scaled 540×126) -->
                        <Border Grid.Column="1"
                                Background="#04000000"
                                BorderBrush="#0D1E2E2E" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="540" Height="126" ClipToBounds="True">
                                        <UniformGrid Width="540" Height="126" Rows="4"
                                                     IsHitTestVisible="False">
                                            <Border BorderBrush="#0A1E2E2E" BorderThickness="0,1,0,0"/>
                                            <Border BorderBrush="#0A1E2E2E" BorderThickness="0,1,0,0"/>
                                            <Border BorderBrush="#0A1E2E2E" BorderThickness="0,1,0,0"/>
                                            <Border BorderBrush="#0A1E2E2E" BorderThickness="0,1,0,1"/>
                                        </UniformGrid>
                                        <!-- threshold -->
                                        <Polyline Points="{Binding DetectionThresholdPoints}"
                                                  Stroke="#CC3030" StrokeDashArray="5 3"
                                                  StrokeThickness="1.1" Opacity="0.65"/>
                                        <!-- ghost: full session score (dim) -->
                                        <Polygon Points="{Binding DetectionScorePoints}"
                                                 Stroke="#0DDFDF" StrokeThickness="0.8" Opacity="0.32">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#401EC8DC" Offset="0"/>
                                                    <GradientStop Color="#0A1EC8DC" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <!-- progressive fill: advances as replay plays -->
                                        <Polygon Points="{Binding LiveScorePoints}"
                                                 Stroke="#00E8E8" StrokeThickness="1.5">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#8A1EC8DC" Offset="0"/>
                                                    <GradientStop Color="#2A1EC8DC" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <!-- playback cursor line -->
                                        <Line X1="{Binding LiveChartCursorX}" Y1="0"
                                              X2="{Binding LiveChartCursorX}" Y2="126"
                                              Stroke="#FFFFFF" StrokeThickness="1.5" Opacity="0.75"/>
                                        <!-- detection dot markers -->
                                        <ItemsControl ItemsSource="{Binding DetectionMarkers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                    <Setter Property="Canvas.Top"  Value="118"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="5" Height="5"
                                                             Fill="#FF8C3A" Opacity="0.9"
                                                             Margin="-2,-2,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- X-axis time labels -->
                    <Grid Grid.Row="3" Margin="46,3,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimelineStartText}"
                                   Foreground="#2A4040" FontFamily="Consolas" FontSize="7.5"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineQuarterText}"
                                   Foreground="#2A4040" FontFamily="Consolas" FontSize="7.5"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimelineMidText}"
                                   Foreground="#2A4040" FontFamily="Consolas" FontSize="7.5"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="{Binding TimelineThreeQuarterText}"
                                   Foreground="#2A4040" FontFamily="Consolas" FontSize="7.5"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="4" Text="{Binding TimelineEndText}"
                                   Foreground="#2A4040" FontFamily="Consolas" FontSize="7.5"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Right: Live Metrics side panel ── -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Style="{StaticResource CardHead}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="12" Background="#56F0AC"
                                        CornerRadius="1" Margin="0,0,8,0"/>
                                <TextBlock Text="LIVE METRICS" Style="{StaticResource SecTitle}"
                                           FontSize="10.5"/>
                            </StackPanel>
                            <!-- LIVE badge -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#1056F0AC" BorderBrush="#3056F0AC"
                                    BorderThickness="1" CornerRadius="8" Padding="7,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#56F0AC"
                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="LIVE" Foreground="#56F0AC"
                                               FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 4 metric tiles (2×2): Messages/s | CAN TX Load / Error Frames | Bus Load -->
                    <UniformGrid Grid.Row="1" Columns="2" Margin="10,8,10,0">
                        <Border Style="{StaticResource MetricTile}" Margin="0,0,3,3">
                            <StackPanel>
                                <TextBlock Text="Messages/s" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding MessagesPerSecondText}"
                                           Foreground="#00C8C8"
                                           FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="frames/s" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Margin="3,0,0,3">
                            <StackPanel>
                                <TextBlock Text="CAN TX Load" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding CanTxLoadText}"
                                           Foreground="#56F0AC"
                                           FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="tx utilization" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Margin="0,3,3,0">
                            <StackPanel>
                                <TextBlock Text="Error Frames" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding ErrorFramesCountText}"
                                           Foreground="#FF8C3A"
                                           FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="total errors" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricTile}" Margin="3,3,0,0">
                            <StackPanel>
                                <TextBlock Text="Bus Load" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding BusLoadText}"
                                           Foreground="#B46CFF"
                                           FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="utilization" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- System Information block -->
                    <Border Grid.Row="2" BorderBrush="#0E2A3030" BorderThickness="0,1,0,0"
                            Margin="10,10,10,0" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="SESSION METADATA"
                                       Foreground="#1E3535"
                                       FontFamily="Bahnschrift" FontSize="8" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Vehicle Profile" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SelectedVehicleNameText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Duration" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SessionDurationText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Anomaly Rate" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SessionAnomalyRateText}"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas" FontSize="8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#3A5858"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOfflineDone}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF8C3A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="SYSTEM INFORMATION"
                                       Foreground="#1E3535"
                                       FontFamily="Bahnschrift" FontSize="8" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="CAN Interface" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding CanInterfaceText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Bitrate" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding BitrateText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Sample Point" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SamplePointText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mode" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding ReplayModeText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Last Update" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding LastUpdateText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#3A5858" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             ROW 3 — OFFLINE ANALYSIS RESULTS (collapses when not done)
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Visibility="{Binding IsOfflineDone, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#080F0F" BorderBrush="#1A006666" BorderThickness="0,1,0,1"
                Margin="10,0,10,4" Padding="0,8">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- accent bar + title -->
                    <ColumnDefinition Width="*"/>     <!-- stat tiles -->
                    <ColumnDefinition Width="220"/>   <!-- top threats -->
                </Grid.ColumnDefinitions>

                <!-- Section label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,20,0">
                    <Border Width="3" Background="#00C8C8" CornerRadius="1" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE RESULT" Foreground="#8ABCBC"
                                   FontFamily="Bahnschrift" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OfflineResult.VehicleId}"
                                   Foreground="#336666" FontFamily="Consolas" FontSize="8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stat tiles -->
                <UniformGrid Grid.Column="1" Rows="1" VerticalAlignment="Center">
                    <!-- Total Frames -->
                    <Border Background="#0A1818" BorderBrush="#0F2A3A" BorderThickness="1"
                            CornerRadius="3" Padding="12,6" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Frames" Foreground="#254040"
                                       FontFamily="Bahnschrift" FontSize="7.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OfflineResult.TotalFrames, StringFormat=N0}"
                                       Foreground="#B0CCCC" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Anomaly Count -->
                    <Border Background="#0A1818" BorderBrush="#0F2A3A" BorderThickness="1"
                            CornerRadius="3" Padding="12,6" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Anomalies" Foreground="#254040"
                                       FontFamily="Bahnschrift" FontSize="7.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OfflineResult.AnomalyCount, StringFormat=N0}"
                                       Foreground="#FF8C3A" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Anomaly Rate -->
                    <Border Background="#0A1818" BorderBrush="#0F2A3A" BorderThickness="1"
                            CornerRadius="3" Padding="12,6" Margin="2,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Anomaly Rate" Foreground="#254040"
                                       FontFamily="Bahnschrift" FontSize="7.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OfflineResult.AnomalyRate, StringFormat={}{0:F2}%}"
                                       FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#56F0AC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OfflineResult.AnomalyRate,
                                                Converter={StaticResource GreaterThanConverter}, ConverterParameter=5}"
                                                         Value="True">
                                                <Setter Property="Foreground" Value="#FF5050"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Top Threats table -->
                <Border Grid.Column="2" Background="#060E0E" BorderBrush="#0F2A3A" BorderThickness="1"
                        CornerRadius="3" Padding="10,6" Margin="4,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOP SUSPICIOUS CAN IDs" Foreground="#254040"
                                   FontFamily="Bahnschrift" FontSize="7.5" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding OfflineResult.TopThreats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CanId}"
                                                   Foreground="#00C8C8" FontFamily="Consolas" FontSize="8"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AvgScore, StringFormat=score {0:F2}}"
                                                   Foreground="#4A6868" FontFamily="Consolas" FontSize="7.5"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Count, StringFormat=×{0}}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#FF8C3A" FontFamily="Consolas" FontSize="7.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 4 — BOTTOM: PROGRESS | ALERTS | DISTRIBUTION
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4" Height="200" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- REPLAY PROGRESS -->
            <Border Grid.Column="0" Style="{StaticResource BottomCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHead}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="10" Background="#00C8C8"
                                    CornerRadius="1" Margin="0,0,7,0"/>
                            <TextBlock Text="REPLAY PROGRESS"
                                       Foreground="#8ABCBC"
                                       FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="12,6,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Circular progress ring -->
                        <Grid Grid.Column="0" Width="68" Height="68"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- track ring -->
                            <Ellipse Width="62" Height="62" StrokeThickness="5"
                                     Stroke="#0E2A3030" Fill="Transparent"/>
                            <!-- progress arc -->
                            <Ellipse Width="62" Height="62" StrokeThickness="5"
                                     Fill="Transparent"
                                     Stroke="#00C8C8"
                                     StrokeDashArray="{Binding ReplayProgressPercent,
                                         Converter={StaticResource ProgressToArcDashConverter}}"
                                     StrokeDashOffset="-48.75"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- center text -->
                            <TextBlock Text="{Binding ReplayProgressText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#00C8C8"
                                       FontFamily="Bahnschrift" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                        <!-- Stats table -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Current Time"    Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding CurrentTimestampText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Total Duration"  Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding SessionDurationText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Progress"        Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding ReplayProgressText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#00C8C8" FontFamily="Consolas" FontSize="8" FontWeight="Bold"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Frames Processed" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding ProcessedFramesText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- RECENT ALERTS -->
            <Border Grid.Column="2" Style="{StaticResource BottomCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHead}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="10" Background="#FF5050"
                                    CornerRadius="1" Margin="0,0,7,0"/>
                            <TextBlock Text="RECENT ALERTS"
                                       Foreground="#8ABCBC"
                                       FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <!-- empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasAlerts,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="No alerts detected"
                                       Foreground="#2A4040"
                                       FontFamily="Bahnschrift" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="System is monitoring for anomalies..."
                                       Foreground="#1A2E2E"
                                       FontFamily="Bahnschrift" FontSize="8.5"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- alert list -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      Visibility="{Binding HasAlerts,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentAlertItems}" Margin="10,4,10,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- severity chip -->
                                            <Border Grid.Column="0" CornerRadius="2" Padding="3,1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#20FF8C3A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                                <Setter Property="Background" Value="#22FF5050"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="INFO">
                                                                <Setter Property="Background" Value="#1856F0AC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Severity}" FontFamily="Consolas"
                                                           FontSize="7" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF8C3A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                                    <Setter Property="Foreground" Value="#FF5050"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="INFO">
                                                                    <Setter Property="Foreground" Value="#56F0AC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- attack type -->
                                            <TextBlock Grid.Column="1" Text="{Binding AttackType}"
                                                       Foreground="#6A9898" FontFamily="Consolas" FontSize="8"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- score -->
                                            <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat='F2'}"
                                                       Foreground="#00C8C8" FontFamily="Consolas" FontSize="8"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <!-- CAN ID -->
                                            <TextBlock Grid.Column="3" Text="{Binding CanId}"
                                                       Foreground="#3A5858" FontFamily="Consolas" FontSize="7.5"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ANOMALY DISTRIBUTION -->
            <Border Grid.Column="4" Style="{StaticResource BottomCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHead}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="10" Background="#B46CFF"
                                    CornerRadius="1" Margin="0,0,7,0"/>
                            <TextBlock Text="ANOMALY DISTRIBUTION"
                                       Foreground="#8ABCBC"
                                       FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="12,6,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Decorative donut ring -->
                        <Grid Grid.Column="0" Width="64" Height="64"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- outer track -->
                            <Ellipse Width="58" Height="58" StrokeThickness="8"
                                     Stroke="#0E2A3030" Fill="Transparent"/>
                            <!-- Normal segment (cyan ~100%) -->
                            <Ellipse Width="58" Height="58" StrokeThickness="8"
                                     Fill="Transparent" Stroke="#00C8C8" Opacity="0.7"
                                     StrokeDashArray="{Binding ReplayProgressPercent,
                                         Converter={StaticResource ProgressToArcDashConverter}}"
                                     StrokeDashOffset="-45.5"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <!-- Legend -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="10" Height="10" Fill="#00C8C8"
                                           RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Normal" Style="{StaticResource Meta}"
                                           Foreground="#3A5555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding NormalFramesPercentText}"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="10" Height="10" Fill="#FF8C3A"
                                           RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Warning" Style="{StaticResource Meta}"
                                           Foreground="#3A5555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DetectionRateText}"
                                           Foreground="#4A6868" FontFamily="Consolas" FontSize="8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" Fill="#FF5050"
                                           RadiusX="2" RadiusY="2" Margin="0,0,6,0"/>
                                <TextBlock Text="Critical" Style="{StaticResource Meta}"
                                           Foreground="#3A5555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="0%" Foreground="#4A6868" FontFamily="Consolas" FontSize="8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
