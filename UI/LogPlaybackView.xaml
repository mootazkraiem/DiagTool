<!--
  ===========================================================================
  LOG PLAYBACK  -  CANvision IDS
  ===========================================================================
  Composition rebuilt against the CANvision reference, in the visual language
  of the approved Dashboard, Telemetry and Diagnostics screens:

    [ session | transport | speed | frames/state/ml | open + record ]
    [ REPLAY TIMELINE - 5 lanes over the whole capture ............. ]
    [ DETECTION ANALYSIS (cards + trend) ......... ] [ LIVE METRICS  ]
    [ PROGRESS | RECENT ALERTS | DISTRIBUTION .... ] [ SESSION META  ]

  Presentation only. Every value binds to an existing LogPlaybackViewModel
  property and every control keeps its existing command, so playback, speed,
  file open, record and inject behave exactly as before. The detection trend
  is LiveCharts2 (CvSparkChart) over the view model's own 0-1 waveform, drawn
  against a fixed 0-1 axis so the dashed threshold line is meaningful.
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.LogPlaybackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Speed chip: highlighted when the view model reports that speed. -->
        <Style x:Key="LpSpeedChip" TargetType="Button" BasedOn="{StaticResource SBtn}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="PlaybackSpeedText"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource CvTextBrightBrush}"/>
                    <Setter Property="Background" Value="#242FF0D6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CvAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LpLaneLabel" TargetType="cv:CvTrackedText" BasedOn="{StaticResource CvCaps}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LpRulerText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource CvTextDimBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- transport ribbon -->
            <RowDefinition Height="Auto"/>   <!-- replay timeline -->
            <RowDefinition Height="*"/>      <!-- analysis body -->
        </Grid.RowDefinitions>

        <!-- Ambient wash, as on the other screens -->
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ TRANSPORT RIBBON ═════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CvRibbon}" Margin="16,12,16,0" Padding="14,8" Height="Auto" MinHeight="54">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- session -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>   <!-- transport -->
                    <ColumnDefinition Width="Auto"/>   <!-- speeds -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>      <!-- readouts -->
                    <ColumnDefinition Width="Auto"/>   <!-- actions -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="220">
                    <cv:CvTrackedText Label="SESSION" Style="{StaticResource CvCaps}"/>
                    <TextBlock Text="{Binding FileNameShortText}" FontFamily="{StaticResource CvMonoFont}"
                               FontSize="12.5" Foreground="{DynamicResource CvTextBrightBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               ToolTip="{Binding FileNameShortText}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="26" Margin="16,0" Fill="{DynamicResource CvBorderAccentBrush}"/>

                <!-- Transport: the real replay controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CvButtonTransport}" Command="{Binding RewindCommand}"
                            Content="⏮" ToolTip="Step back / rewind the replay"/>
                    <Button Style="{StaticResource CvButtonTransport}" Command="{Binding PlayCommand}"
                            Content="▶" Margin="4,0,0,0" ToolTip="Play the loaded capture"/>
                    <Button Style="{StaticResource CvButtonTransport}" Command="{Binding PauseCommand}"
                            Content="⏸" Margin="4,0,0,0" ToolTip="Pause the replay"/>
                    <Button Style="{StaticResource CvButtonTransport}" Command="{Binding StopCommand}"
                            Content="■" Margin="4,0,0,0" ToolTip="Stop and rewind to the first frame"/>
                    <Button Style="{StaticResource CvButtonTransport}" Command="{Binding ForwardCommand}"
                            Content="⏭" Margin="4,0,0,0" ToolTip="Step forward / fast-forward"/>

                    <!-- End of capture. Appears only once the last frame has been
                         replayed, so the readouts stopping is explained rather than
                         looking like the replay has hung. Play already restarts from
                         the first frame, so this is that command with a name. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                Visibility="{Binding IsReplayComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlow}"/>
                        <cv:CvTrackedText Label="{Binding ReplayCompleteText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                          FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                          Foreground="{DynamicResource CvAccentBrush}"/>
                        <Button Command="{Binding PlayCommand}" Margin="12,0,0,0"
                                Style="{StaticResource CvButtonGhost}" Padding="12,5"
                                AutomationProperties.Name="REPLAY AGAIN"
                                ToolTip="Replay this capture from the first frame">
                            <cv:CvTrackedText Label="REPLAY AGAIN" FontFamily="{StaticResource CvMonoFont}"
                                              FontSize="11.5" Tracking="1"
                                              Foreground="{DynamicResource CvAccentBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Speed -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="0.5" Content="0.5x" Tag="0.5x"/>
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="1"   Content="1x"   Tag="1x"/>
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="2"   Content="2x"   Tag="2x"/>
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="4"   Content="4x"   Tag="4x"/>
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="8"   Content="8x"   Tag="8x"/>
                    <Button Style="{StaticResource LpSpeedChip}" Command="{Binding SetSpeedCommand}" CommandParameter="32"  Content="MAX"  Tag="MAX" Margin="0"/>
                </StackPanel>

                <Rectangle Grid.Column="4" Width="1" Height="26" Margin="16,0" Fill="{DynamicResource CvBorderAccentBrush}"/>

                <!-- Live readouts -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,26,0">
                        <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvCaps}"/>
                        <TextBlock Text="{Binding PlaybackPositionText}" FontFamily="{StaticResource CvMonoFont}"
                                   FontSize="12.5" Foreground="{DynamicResource CvTextBrightBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <cv:CvTrackedText Label="STATE" Style="{StaticResource CvCaps}"/>
                        <cv:CvTrackedText Label="{Binding PlaybackMode}" FontFamily="{StaticResource CvMonoFont}"
                                          FontSize="12.5" Foreground="{DynamicResource CvAccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <cv:CvTrackedText Label="ML ANALYSIS" Style="{StaticResource CvCaps}"/>
                        <cv:CvTrackedText Label="{Binding MlAnalysisStateText}" FontFamily="{StaticResource CvMonoFont}"
                                          FontSize="12.5" Foreground="{DynamicResource CvTextBrightBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- File + capture actions -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CvButtonGhost}" Command="{Binding OpenLogCommand}"
                            Height="30" Padding="14,0" ToolTip="Open a CAN log for replay">
                        <cv:CvTrackedText Label="OPEN FILE" FontFamily="{StaticResource CvDisplayFont}"
                                          FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource CvButtonGhost}" Command="{Binding StartRecordCommand}"
                            Height="30" Padding="12,0" Margin="6,0,0,0" ToolTip="Start recording the bus to a new log">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource CvDangerBrush}" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="REC" FontFamily="{StaticResource CvDisplayFont}" FontSize="12"
                                              FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CvButtonGhost}" Command="{Binding StopRecordCommand}"
                            Height="30" Padding="12,0" Margin="6,0,0,0" ToolTip="Stop the recording and close the file">
                        <cv:CvTrackedText Label="STOP REC" FontFamily="{StaticResource CvDisplayFont}"
                                          FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource CvButtonDanger}" Command="{Binding InjectTestCommand}"
                            Height="30" Padding="12,0" Margin="6,0,0,0" ToolTip="Inject a test frame onto the bus">
                        <cv:CvTrackedText Label="INJECT" FontFamily="{StaticResource CvDisplayFont}"
                                          FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ REPLAY TIMELINE ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardFlush}" Margin="16,12,16,0"
                BorderBrush="{DynamicResource CvBorderAccentBrush}">
            <StackPanel Margin="16,11,16,10">
                <DockPanel Margin="0,0,0,8">
                    <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"/>
                    <cv:CvTrackedText DockPanel.Dock="Left" Label="REPLAY TIMELINE" Style="{StaticResource CvPanelTitle}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <cv:CvTrackedText Label="CURSOR (LOG TIME)" Style="{StaticResource CvCaps}" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentTimestampText}" FontFamily="{StaticResource CvMonoFont}" FontSize="12"
                                   Foreground="{DynamicResource CvAccentBrush}" Margin="6,0,16,0"/>
                        <cv:CvTrackedText Label="SPEED" Style="{StaticResource CvCaps}" FontSize="11"/>
                        <TextBlock Text="{Binding PlaybackSpeedText}" FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                   Foreground="{DynamicResource CvTextSoftBrush}" Margin="6,0,16,0"/>
                        <cv:CvTrackedText Label="SYNC" Style="{StaticResource CvCaps}" FontSize="11"/>
                        <cv:CvTrackedText Label="{Binding SyncStateText}" FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                          Foreground="{DynamicResource CvTextSoftBrush}" Margin="6,0,16,0"/>
                        <cv:CvTrackedText Label="TOTAL" Style="{StaticResource CvCaps}" FontSize="11"/>
                        <TextBlock Text="{Binding SessionDurationText}" FontFamily="{StaticResource CvMonoFont}" FontSize="12"
                                   Foreground="{DynamicResource CvAccentBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lane labels, positioned to match the view model's lane offsets -->
                    <Canvas Grid.Column="0" Height="134">
                        <StackPanel Canvas.Top="9" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#00C8C8" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="PLAYBACK" Style="{StaticResource LpLaneLabel}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="34" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#FF8C3A" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="DETECTIONS" Style="{StaticResource LpLaneLabel}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="60" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#FF5050" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="ALERTS" Style="{StaticResource LpLaneLabel}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="86" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#B46CFF" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="GROUND TRUTH" Style="{StaticResource LpLaneLabel}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Canvas.Top="112" Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#FF5050" VerticalAlignment="Center"/>
                            <cv:CvTrackedText Label="FLAGGED SPANS" Style="{StaticResource LpLaneLabel}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Canvas>

                    <!-- Track area: authored in the view model's 920-unit space and scaled
                         horizontally to the available width (X only, so markers keep height). -->
                    <Grid Grid.Column="1" x:Name="TimelineGrid" Height="134" ClipToBounds="True"
                          SizeChanged="TimelineGrid_SizeChanged">
                        <Grid.Background>
                            <DynamicResource ResourceKey="CvOverlay08Brush"/>
                        </Grid.Background>

                        <Canvas Width="920" Height="134" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="TimelineScale" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>

                            <!-- lane rules -->
                            <Line X1="0" Y1="26"  X2="920" Y2="26"  Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>
                            <Line X1="0" Y1="52"  X2="920" Y2="52"  Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>
                            <Line X1="0" Y1="78"  X2="920" Y2="78"  Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>
                            <Line X1="0" Y1="104" X2="920" Y2="104" Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>

                            <!-- ground-truth lane note when the log has no _gt.csv -->
                            <TextBlock Canvas.Left="8" Canvas.Top="84" Text="{Binding GroundTruthNoteText}"
                                       FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource CvTextFaintBrush}"/>

                            <!-- attack / ground-truth windows -->
                            <ItemsControl ItemsSource="{Binding TimelineWindows}" Canvas.Left="0" Canvas.Top="0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="14" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                   Opacity="0.55"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- detection / alert / ground-truth marks -->
                            <ItemsControl ItemsSource="{Binding TimelineMarkers}" Canvas.Left="0" Canvas.Top="0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="2.5" Height="13" RadiusX="1" RadiusY="1"
                                                   Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                   ToolTip="{Binding Label}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- playback cursor -->
                            <Rectangle Canvas.Left="{Binding PlaybackCursorLeft}" Canvas.Top="0"
                                       Width="1.5" Height="128" Fill="{DynamicResource CvTextBrightBrush}" Opacity="0.85"
                                       Visibility="{Binding HasReplayLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Canvas>

                        <!-- empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasReplayLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <cv:CvTrackedText Label="NO CAPTURE LOADED" Style="{StaticResource CvCaps}"
                                              HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TimelineEmptyStateText}" Style="{StaticResource CvEmptyBody}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ruler -->
                <Grid Margin="108,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimelineStartText}"        Style="{StaticResource LpRulerText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TimelineQuarterText}"      Style="{StaticResource LpRulerText}"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimelineMidText}"          Style="{StaticResource LpRulerText}"/>
                    <TextBlock Grid.Column="3" Text="{Binding TimelineThreeQuarterText}" Style="{StaticResource LpRulerText}"/>
                    <TextBlock Grid.Column="4" Text="{Binding TimelineEndText}"          Style="{StaticResource LpRulerText}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ═══ ANALYSIS BODY ════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.28*" MinWidth="290" MaxWidth="360"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── DETECTION ANALYSIS ──────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFlush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                        <DockPanel>
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="DETECTION ANALYSIS" Style="{StaticResource CvPanelTitle}"/>
                            <cv:CvTrackedText DockPanel.Dock="Right" Label="FULL SESSION" Style="{StaticResource CvCaps}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- four readout cards -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="11,12,11,4">
                        <Border Style="{StaticResource CvTile}" Margin="5,0" Padding="12,10">
                            <StackPanel>
                                <cv:CvTrackedText Label="ANOMALY SCORE" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding CurrentAnomalyScoreText}" Style="{StaticResource CvTileValue}"
                                           Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                                <cv:CvTrackedText Label="{Binding DetectionScoreCeilingText}" Style="{StaticResource CvTileMeta}" Upper="False"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CvTile}" Margin="5,0" Padding="12,10">
                            <StackPanel>
                                <cv:CvTrackedText Label="THRESHOLD" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding DetectionThresholdText}" Style="{StaticResource CvTileValue}"
                                           Foreground="{DynamicResource CvDangerBrush}"/>
                                <cv:CvTrackedText Label="{Binding DetectionThresholdMetaText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CvTile}" Margin="5,0" Padding="12,10">
                            <StackPanel>
                                <cv:CvTrackedText Label="DETECTIONS" Style="{StaticResource CvCaps}"/>
                                <TextBlock Text="{Binding TotalDetectionsText}" Style="{StaticResource CvTileValue}"
                                           Foreground="{DynamicResource CvWarnBrush}"/>
                                <cv:CvTrackedText Label="WHOLE SESSION" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CvTile}" Margin="5,0" Padding="12,10">
                            <StackPanel>
                                <cv:CvTrackedText Label="STATUS AT CURSOR" Style="{StaticResource CvCaps}"/>
                                <cv:CvTrackedText Label="{Binding CurrentDetectionText}" Style="{StaticResource CvTileValue}"/>
                                <cv:CvTrackedText Label="{Binding CurrentAttackTypeText}" Style="{StaticResource CvTileMeta}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- detection trend: flagged-frame scores on a fixed 0-1 axis, the model's
                         0.50 cut-off (vehicle models only) and the playback cursor -->
                    <Grid Grid.Row="2" x:Name="ScoreChartHost" Margin="16,6,16,0" MinHeight="112" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <!-- gridlines -->
                        <Line Grid.Row="0" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Center"
                              Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>
                        <Line Grid.Row="1" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Center"
                              Stroke="{DynamicResource CvSeparatorBrush}" StrokeThickness="1"/>

                        <cv:CvSparkChart Grid.RowSpan="2" Values="{Binding DetectionScoreValues}"
                                         MaxValue="1" FillWidth="True" StrokeHex="#2FF0D6" ShowArea="True" LineThickness="1.6"/>

                        <!-- threshold: the score a frame must cross to be flagged -->
                        <Line Grid.Row="0" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Bottom"
                              Stroke="{DynamicResource CvDangerBrush}" StrokeThickness="1" StrokeDashArray="6 7" Opacity="0.55"
                              Visibility="{Binding HasScoreThreshold, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Canvas Grid.RowSpan="2" ClipToBounds="True"
                                Visibility="{Binding HasReplayLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Rectangle Width="1.5" Fill="{DynamicResource CvTextBrightBrush}" Opacity="0.8"
                                       Height="{Binding ActualHeight, ElementName=ScoreChartHost}">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource PercentToOffsetConverter}">
                                        <Binding Path="ReplayProgressPercent"/>
                                        <Binding Path="ActualWidth" ElementName="ScoreChartHost"/>
                                    </MultiBinding>
                                </Canvas.Left>
                            </Rectangle>
                        </Canvas>

                        <!-- empty state -->
                        <StackPanel Style="{StaticResource CvEmptyWhenZero}" Grid.RowSpan="2"
                                    Tag="{Binding DetectionScorePoints.Count}">
                            <Border Style="{StaticResource CvEmptyGlyph}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding DetectionAnalysisEmptyStateText}" Style="{StaticResource CvEmptyBody}"/>
                        </StackPanel>
                    </Grid>

                    <!-- chart ruler -->
                    <Grid Grid.Row="3" Margin="16,6,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimelineStartText}"        Style="{StaticResource LpRulerText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineQuarterText}"      Style="{StaticResource LpRulerText}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimelineMidText}"          Style="{StaticResource LpRulerText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding TimelineThreeQuarterText}" Style="{StaticResource LpRulerText}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TimelineEndText}"          Style="{StaticResource LpRulerText}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── PROGRESS | RECENT ALERTS | DISTRIBUTION ─────────────── -->
            <Grid Grid.Row="2" Grid.Column="0" Height="158">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardFlush}">
                    <StackPanel Margin="16,13,16,12">
                        <cv:CvTrackedText Label="REPLAY PROGRESS" Style="{StaticResource CvCaps}" Margin="0,0,0,9"/>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="LOG TIME AT CURSOR" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding CurrentTimestampText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="TOTAL DURATION" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding SessionDurationText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="PROGRESS" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding ReplayProgressText}" Style="{StaticResource CvKvValue}"
                                       Foreground="{DynamicResource CvAccentBrush}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}">
                            <cv:CvTrackedText Label="FRAMES PROCESSED" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding PlaybackPositionText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>

                        <Border Height="4" CornerRadius="2" Background="{DynamicResource CvOverlay0EBrush}" Margin="0,11,0,0">
                            <Border HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{DynamicResource CvAccentBrush}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToOffsetConverter}">
                                        <Binding Path="ReplayProgressPercent"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,13,16,8">
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="RECENT ALERTS" Style="{StaticResource CvCaps}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AlertCountText}" FontFamily="{StaticResource CvMonoFont}"
                                           FontSize="11.5" Foreground="{DynamicResource CvDangerBrush}"/>
                                <cv:CvTrackedText Label="IN SESSION" Style="{StaticResource CvCaps}" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentAlertItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CvTableRow}" Padding="16,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource CvCell}" FontSize="12"
                                                           Foreground="{DynamicResource CvTextSoftBrush}"
                                                           Text="{Binding TimestampUtc, Converter={StaticResource UtcToLocalTimeConverter}, ConverterParameter=HH:mm:ss}"/>
                                                <TextBlock x:Name="Sev" Grid.Column="1" Text="{Binding Severity}"
                                                           Style="{StaticResource CvCell}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CvTextMutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CanId}" Style="{StaticResource CvCell}"
                                                           FontSize="12" Foreground="{DynamicResource CvAccentBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AttackType}" Style="{StaticResource CvCell}"
                                                           FontSize="12" Foreground="{DynamicResource CvTextBrush}"
                                                           ToolTip="{Binding Reason}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="HIGH">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Style="{StaticResource CvEmptyWhenZero}"
                                    Tag="{Binding RecentAlertItems.Count}">
                            <Border Style="{StaticResource CvEmptyGlyph}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/>
                            </Border>
                            <cv:CvTrackedText Label="NO ALERTS YET" Style="{StaticResource CvCaps}"
                                              HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="No alerts before the playback cursor yet." Style="{StaticResource CvEmptyBody}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardFlush}">
                    <StackPanel Margin="16,13,16,12">
                        <cv:CvTrackedText Label="ANOMALY DISTRIBUTION" Style="{StaticResource CvCaps}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="66" Height="66" VerticalAlignment="Center">
                                <Ellipse Width="58" Height="58" StrokeThickness="8" Fill="Transparent" Stroke="{DynamicResource CvRingTrackBrush}"/>
                                <!-- Normal share of frames. The dash array is in multiples of the
                                     stroke thickness, so the ring passes its circumference in those
                                     units: pi * 58 / 8 = 22.78. -->
                                <Ellipse Width="58" Height="58" StrokeThickness="8" Fill="Transparent"
                                         Stroke="{DynamicResource CvAccentBrush}" Opacity="0.8"
                                         StrokeDashArray="{Binding NormalFramesPercent, Converter={StaticResource ProgressToArcDashConverter}, ConverterParameter=22.78}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource CvAccentBrush}" VerticalAlignment="Center"/>
                                    <cv:CvTrackedText Label="NORMAL" Style="{StaticResource CvCaps}" Margin="7,0,0,0"/>
                                    <TextBlock Text="{Binding NormalFramesPercentText}" FontFamily="{StaticResource CvMonoFont}"
                                               FontSize="12" Foreground="{DynamicResource CvTextBrightBrush}" Margin="7,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource CvWarnBrush}" VerticalAlignment="Center"/>
                                    <cv:CvTrackedText Label="DETECTED" Style="{StaticResource CvCaps}" Margin="7,0,0,0"/>
                                    <TextBlock Text="{Binding DetectionRateText}" FontFamily="{StaticResource CvMonoFont}"
                                               FontSize="12" Foreground="{DynamicResource CvWarnBrush}" Margin="7,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DetectionRateBasisText}" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                   Foreground="{DynamicResource CvTextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetectionRateBasisText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── RIGHT RAIL ──────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>

                <Border Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                    <StackPanel Margin="16,13,16,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Style="{StaticResource CvSectionMarker}"/>
                            <cv:CvTrackedText Label="LIVE METRICS" Style="{StaticResource CvPanelTitle}"/>
                        </StackPanel>

                        <UniformGrid Rows="2" Columns="2" Margin="-4,0">
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="11,9">
                                <StackPanel>
                                    <cv:CvTrackedText Label="MESSAGES / S" Style="{StaticResource CvCaps}"/>
                                    <TextBlock Text="{Binding MessagesPerSecondText}" Style="{StaticResource CvTileValue}"
                                               FontSize="17" Foreground="{DynamicResource CvAccentBrush}"/>
                                    <cv:CvTrackedText Label="FRAMES / S" Style="{StaticResource CvTileMeta}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="11,9">
                                <StackPanel>
                                    <cv:CvTrackedText Label="CAN TX LOAD" Style="{StaticResource CvCaps}"/>
                                    <TextBlock Text="{Binding CanTxLoadText}" Style="{StaticResource CvTileValue}"
                                               FontSize="17" Foreground="{DynamicResource CvAccentSoftBrush}"/>
                                    <cv:CvTrackedText Label="TX UTILIZATION" Style="{StaticResource CvTileMeta}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="11,9">
                                <StackPanel>
                                    <cv:CvTrackedText Label="ERROR FRAMES" Style="{StaticResource CvCaps}"/>
                                    <TextBlock Text="{Binding ErrorFramesCountText}" Style="{StaticResource CvTileValue}" FontSize="17"/>
                                    <cv:CvTrackedText Label="TOTAL ERRORS" Style="{StaticResource CvTileMeta}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="11,9">
                                <StackPanel>
                                    <cv:CvTrackedText Label="BUS LOAD" Style="{StaticResource CvCaps}"/>
                                    <TextBlock Text="{Binding BusLoadText}" Style="{StaticResource CvTileValue}"
                                               FontSize="17" Foreground="{DynamicResource CvVioletSoftBrush}"/>
                                    <cv:CvTrackedText Label="UTILIZATION" Style="{StaticResource CvTileMeta}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Vehicle / AI model: the shared selection. The backend replay and the
                     MF4 offline analysis both run with it. -->
                <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0">
                    <StackPanel Margin="16,13,16,14">
                        <DockPanel Margin="0,0,0,8">
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="VEHICLE / AI MODEL" Style="{StaticResource CvCaps}"/>
                            <cv:CvTrackedText DockPanel.Dock="Right" HorizontalAlignment="Right"
                                              Label="{Binding ModelSelection.SelectedModel.StatusText}"
                                              Style="{StaticResource CvCaps}" FontSize="11"
                                              Foreground="{DynamicResource CvOkBrush}"/>
                        </DockPanel>
                        <ComboBox Style="{StaticResource CvComboBox}" Height="32" IsSynchronizedWithCurrentItem="False"
                                  ItemsSource="{Binding ModelSelection.Models}"
                                  SelectedItem="{Binding ModelSelection.SelectedModel, Mode=TwoWay}"
                                  ToolTip="Model used by the backend replay and the offline analysis">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TrainedModelInfo}">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CvUiFont}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel Style="{StaticResource CvKvRowTight}" Margin="0,9,0,0">
                            <cv:CvTrackedText Label="MODEL" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding ModelSelection.SelectedModel.ModelLabel}" Style="{StaticResource CvKvValue}"
                                       Foreground="{DynamicResource CvAccentBrush}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding OfflineStatusText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                   Foreground="{DynamicResource CvTextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Offline analysis result (MF4 sessions); collapsed until one finishes -->
                <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0" BorderBrush="{DynamicResource CvBorderAccentBrush}"
                        Visibility="{Binding IsOfflineDone, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="16,13,16,14">
                        <DockPanel Margin="0,0,0,10">
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"
                                       Fill="{DynamicResource CvVioletBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                            <cv:CvTrackedText DockPanel.Dock="Left" Label="OFFLINE RESULT" Style="{StaticResource CvPanelTitle}"/>
                            <cv:CvTrackedText DockPanel.Dock="Right" HorizontalAlignment="Right"
                                              Label="{Binding OfflineResult.VehicleId}" Style="{StaticResource CvCaps}" FontSize="11"/>
                        </DockPanel>

                        <UniformGrid Rows="1" Columns="3" Margin="-4,0">
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="10,8">
                                <StackPanel>
                                    <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvCaps}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding OfflineResult.TotalFrames, StringFormat=N0}"
                                               Style="{StaticResource CvTileValue}" FontSize="15"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="10,8">
                                <StackPanel>
                                    <cv:CvTrackedText Label="ANOMALIES" Style="{StaticResource CvCaps}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding OfflineResult.AnomalyCount, StringFormat=N0}"
                                               Style="{StaticResource CvTileValue}" FontSize="15"
                                               Foreground="{DynamicResource CvWarnBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CvTile}" Margin="4" Padding="10,8">
                                <StackPanel>
                                    <cv:CvTrackedText Label="RATE" Style="{StaticResource CvCaps}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding OfflineResult.AnomalyRate, StringFormat={}{0:F2}%}"
                                               FontSize="15">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CvTileValue}">
                                                <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OfflineResult.AnomalyRate, Converter={StaticResource GreaterThanConverter}, ConverterParameter=5}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <cv:CvTrackedText Label="TOP SUSPICIOUS CAN IDS" Style="{StaticResource CvCaps}" Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding OfflineResult.TopThreats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding CanId}" Width="76"
                                                   FontFamily="{StaticResource CvMonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource CvAccentBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat=x{0}}"
                                                   HorizontalAlignment="Right" FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                                   Foreground="{DynamicResource CvTextMutedBrush}"/>
                                        <TextBlock Text="{Binding AvgScore, StringFormat=score {0:F2}}"
                                                   FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                                   Foreground="{DynamicResource CvTextSoftBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0">
                    <StackPanel Margin="16,13,16,14">
                        <cv:CvTrackedText Label="SESSION METADATA" Style="{StaticResource CvCaps}" Margin="0,0,0,9"/>

                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="DATASET" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding DatasetText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="DURATION" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding SessionDurationText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="CAPTURED" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding CaptureDateText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="FRAMES" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding PlaybackPositionText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="PROGRESS" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding ReplayProgressText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRow}">
                            <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding ReplayLatencyText}" Style="{StaticResource CvKvValue}"
                                       Foreground="{DynamicResource CvWarnBrush}"
                                       ToolTip="Backend ML analysis time for the loaded capture."/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource CvKvRowTight}" Margin="0,4,0,0">
                            <cv:CvTrackedText Label="VEHICLE" Style="{StaticResource CvKvKey}"/>
                            <TextBlock Text="{Binding SelectedVehicleNameText}" Style="{StaticResource CvKvValue}"/>
                        </DockPanel>

                        <Border Style="{StaticResource CvBadge}" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="11,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource CvStatusDot}" Width="6" Height="6"/>
                                <cv:CvTrackedText Label="{Binding RecordStatusText}" Margin="8,0,0,0"
                                                  FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                                  Foreground="{DynamicResource CvAccentDimBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
