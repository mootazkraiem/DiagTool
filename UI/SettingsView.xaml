<!--
  ===========================================================================
  SETTINGS  -  CANvision IDS
  ===========================================================================
  Composition rebuilt against the CANvision reference, in the visual language
  of the approved screens:

    [ HARDWARE INTERFACE (quick connect)              ] [ LINK STATUS  ]
    [ NEURAL CORE CONFIG: model | api key, threshold  ] [ DANGER ZONE  ]
    [ VEHICLE PROFILES (from the backend's DBC list)  ] [              ]

  Presentation only: every binding and command is the view model's own.
  VEHICLE PROFILES now lists the backend's real DBC vehicle profiles
  (HardwareVehicleItems, marked ACTIVE when it is the selected one) instead
  of ProfileCards, which is three hardcoded demo entries with nothing behind
  them. ProfileCards is left untouched in the view model.
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="StHeading" TargetType="cv:CvTrackedText">
            <Setter Property="FontFamily" Value="{StaticResource CvDisplayFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Tracking" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CvTextBrightBrush}"/>
        </Style>
        <Style x:Key="StLede" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CvUiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,12,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.3*" MinWidth="280" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ MAIN COLUMN ═══════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- HARDWARE INTERFACE -->
                    <Border Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                        <StackPanel Margin="22,18,22,20">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CvSectionMarker}" Height="16"/>
                                <cv:CvTrackedText Label="HARDWARE INTERFACE" Style="{StaticResource StHeading}"/>
                            </StackPanel>
                            <TextBlock Text="Quick connect and disconnect for testing. The full setup opens from the Home screen when a live session starts."
                                       Style="{StaticResource StLede}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CvButtonPrimary}" Command="{Binding ConnectHardwareCommand}"
                                        Height="36" MinWidth="130" Padding="18,0">
                                    <cv:CvTrackedText Label="CONNECT" FontFamily="{StaticResource CvDisplayFont}" FontSize="12.5" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource CvButtonGhost}" Command="{Binding DisconnectHardwareCommand}"
                                        Height="36" MinWidth="130" Padding="18,0" Margin="10,0,0,0">
                                    <cv:CvTrackedText Label="DISCONNECT" FontFamily="{StaticResource CvDisplayFont}" FontSize="12.5" FontWeight="SemiBold"/>
                                </Button>
                                <Border Style="{StaticResource CvBadge}" Margin="16,0,0,0" Padding="12,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource CvStatusDot}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HwStatusText}" Value="DISCONNECTED">
                                                            <Setter Property="Fill" Value="{DynamicResource CvTextDimBrush}"/>
                                                            <Setter Property="Effect" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <cv:CvTrackedText Label="{Binding HwStatusText}" Margin="8,0,0,0"
                                                          FontFamily="{StaticResource CvMonoFont}" FontSize="11.5">
                                            <cv:CvTrackedText.Style>
                                                <Style TargetType="cv:CvTrackedText">
                                                    <Setter Property="Foreground" Value="{DynamicResource CvAccentDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HwStatusText}" Value="DISCONNECTED">
                                                            <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </cv:CvTrackedText.Style>
                                        </cv:CvTrackedText>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- NEURAL CORE CONFIG -->
                    <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0">
                        <StackPanel Margin="22,18,22,20">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource CvSectionMarker}" Height="16"
                                           Fill="{DynamicResource CvVioletBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                                <cv:CvTrackedText Label="NEURAL CORE CONFIG" Style="{StaticResource StHeading}"/>
                            </StackPanel>
                            <TextBlock Text="Anomaly detection with one model per CAN identifier for each vehicle, explained by Gemini or a local language model."
                                       Style="{StaticResource StLede}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- model state, read from the backend's health endpoint -->
                                <Border Grid.Column="0" Style="{StaticResource CvInset}" Padding="16,10">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CvKvRow}">
                                            <cv:CvTrackedText Label="DETECTION MODEL" Style="{StaticResource CvKvKey}"/>
                                            <TextBlock Text="{Binding DetectionModelText}" Style="{StaticResource CvKvValue}"
                                                       Foreground="{DynamicResource CvAccentBrush}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource CvKvRow}">
                                            <cv:CvTrackedText Label="MODEL TYPE" Style="{StaticResource CvKvKey}"/>
                                            <TextBlock Text="{Binding ModelClustersText}" Style="{StaticResource CvKvValue}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource CvKvRow}">
                                            <cv:CvTrackedText Label="STATUS" Style="{StaticResource CvKvKey}"/>
                                            <TextBlock Text="{Binding ModelStatusText}" Style="{StaticResource CvKvValue}"
                                                       Foreground="{DynamicResource CvAccentBrush}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource CvKvRow}">
                                            <cv:CvTrackedText Label="LLM PROVIDER" Style="{StaticResource CvKvKey}"/>
                                            <TextBlock Text="{Binding LlmProviderText}" Style="{StaticResource CvKvValue}"
                                                       Foreground="{DynamicResource CvVioletSoftBrush}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource CvKvRowTight}">
                                            <cv:CvTrackedText Label="LAST TRAINING" Style="{StaticResource CvKvKey}"/>
                                            <TextBlock Text="{Binding TrainingDateText}" Style="{StaticResource CvKvValue}"
                                                       Foreground="{DynamicResource CvTextMutedBrush}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- editable configuration -->
                                <StackPanel Grid.Column="2">
                                    <cv:CvTrackedText Label="GOOGLE API KEY (GEMINI)" Style="{StaticResource CvCaps}"/>
                                    <TextBox Style="{StaticResource CvTextBox}" Margin="0,6,0,0" MinHeight="34"
                                             Text="{Binding GoogleApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Required for Gemini LLM explanations. Saved to AppData\CANvision\config.json"/>

                                    <DockPanel Margin="0,16,0,0">
                                        <cv:CvTrackedText DockPanel.Dock="Left" Label="ALERT THRESHOLD" Style="{StaticResource CvCaps}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AlertThresholdText}" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource CvMonoFont}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CvAccentBrush}"/>
                                    </DockPanel>
                                    <Slider Style="{StaticResource CvSlider}" Margin="0,8,0,0"
                                            Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding AlertThreshold, Mode=TwoWay}"/>

                                    <Button Style="{StaticResource CvButtonDanger}" Command="{Binding LaunchSimulatorCommand}"
                                            Height="36" Margin="0,18,0,0"
                                            ToolTip="Start the attack simulator; watch it on Telemetry">
                                        <cv:CvTrackedText Label="LAUNCH ATTACK TEST" FontFamily="{StaticResource CvDisplayFont}"
                                                          FontSize="12.5" FontWeight="SemiBold"/>
                                    </Button>
                                    <TextBlock Text="{Binding SaveStatusText}" Margin="0,8,0,0" MinHeight="14"
                                               FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                               Foreground="{DynamicResource CvOkBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- VEHICLE PROFILES: the backend's DBC vehicle list -->
                    <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0">
                        <StackPanel Margin="22,16,22,18">
                            <DockPanel Margin="0,0,0,12">
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="VEHICLE PROFILES" Style="{StaticResource CvCaps}"/>
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource CvMonoFont}" FontSize="11.5" Foreground="{DynamicResource CvTextSoftBrush}">
                                    <Run Text="{Binding HardwareVehicleItems.Count, Mode=OneWay}"/><Run Text=" VEHICLE PROFILES"/>
                                </TextBlock>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding HardwareVehicleItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VehicleProfileItem}">
                                        <Border x:Name="Card" Style="{StaticResource CvTile}" Margin="0,0,10,10" Padding="14,11">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border x:Name="Badge" DockPanel.Dock="Right" Style="{StaticResource CvBadge}"
                                                            Padding="8,2" Visibility="Collapsed" VerticalAlignment="Top">
                                                        <cv:CvTrackedText Label="ACTIVE" FontFamily="{StaticResource CvMonoFont}" FontSize="11"
                                                                          Foreground="{DynamicResource CvAccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CvUiFont}" FontSize="12.5"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource CvTextBrightBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource CvMonoFont}" FontSize="11.5"
                                                           Foreground="{DynamicResource CvTextSoftBrush}">
                                                    <Run Text="{Binding Bitrate, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" bps"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <cv:CvTrackedText x:Name="RawDbc" Label="RAW DBC" Style="{StaticResource CvCaps}"
                                                                      FontSize="10.5" Margin="0,0,10,0" Opacity="0.35"/>
                                                    <cv:CvTrackedText x:Name="UdsDbc" Label="UDS DBC" Style="{StaticResource CvCaps}"
                                                                      FontSize="10.5" Margin="0,0,10,0" Opacity="0.35"/>
                                                    <cv:CvTrackedText x:Name="TxList" Label="TX LIST" Style="{StaticResource CvCaps}"
                                                                      FontSize="10.5" Opacity="0.35"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasRawDbc}" Value="True">
                                                <Setter TargetName="RawDbc" Property="Opacity" Value="1"/>
                                                <Setter TargetName="RawDbc" Property="Foreground" Value="{DynamicResource CvAccentDimBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasUdsDbc}" Value="True">
                                                <Setter TargetName="UdsDbc" Property="Opacity" Value="1"/>
                                                <Setter TargetName="UdsDbc" Property="Foreground" Value="{DynamicResource CvAccentDimBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasTransmitList}" Value="True">
                                                <Setter TargetName="TxList" Property="Opacity" Value="1"/>
                                                <Setter TargetName="TxList" Property="Foreground" Value="{DynamicResource CvAccentDimBrush}"/>
                                            </DataTrigger>
                                            <!-- the profile currently selected for hardware decode -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.SelectedHwVehicleId"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Style="{StaticResource CvEmptyWhenZero}" Tag="{Binding HardwareVehicleItems.Count}" Margin="0,6,0,4">
                                <cv:CvTrackedText Label="NO VEHICLE PROFILES YET" Style="{StaticResource CvCaps}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Profiles load from the backend's DBC library once it is reachable."
                                           Style="{StaticResource CvEmptyBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ RIGHT RAIL ═══════════════════════════════════════ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                        <StackPanel Margin="18,15,18,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Style="{StaticResource CvSectionMarker}"/>
                                <cv:CvTrackedText Label="LINK STATUS" Style="{StaticResource CvPanelTitle}"/>
                            </StackPanel>
                            <cv:CvTrackedText Label="{Binding RuntimeMode}" FontFamily="{StaticResource CvDisplayFont}" FontSize="17"
                                              FontWeight="Bold" Foreground="{DynamicResource CvAccentBrush}"
                                              Effect="{DynamicResource CvAccentGlowSoft}" Margin="0,0,0,10"/>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="MODE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding UnitNameText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvWarnBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="REFRESH" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding RefreshIntervalText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRowTight}">
                                <cv:CvTrackedText Label="API" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding ApiEndpoint}" Style="{StaticResource CvKvValue}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ApiEndpoint}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardFlush}" Margin="0,12,0,0" BorderBrush="#40FF4D5E">
                        <StackPanel Margin="18,15,18,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Style="{StaticResource CvSectionMarker}" Fill="{DynamicResource CvDangerBrush}"
                                           Effect="{DynamicResource CvDangerGlow}"/>
                                <cv:CvTrackedText Label="DANGER ZONE" Style="{StaticResource CvPanelTitle}"/>
                            </StackPanel>
                            <Button Style="{StaticResource CvButtonDanger}" Command="{Binding RestoreDefaultsCommand}" Height="36">
                                <cv:CvTrackedText Label="RESTORE DEFAULTS" FontFamily="{StaticResource CvDisplayFont}"
                                                  FontSize="12.5" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource CvButtonPrimary}" Command="{Binding SaveSettingsCommand}"
                                    Height="36" Margin="0,8,0,0">
                                <cv:CvTrackedText Label="SAVE SETTINGS" FontFamily="{StaticResource CvDisplayFont}"
                                                  FontSize="12.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
