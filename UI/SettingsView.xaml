<UserControl
    x:Class="CANvision.Native.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    xmlns:conv="clr-namespace:CANvision.Native.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://siteoforigin:,,,/assets/6k+-D+copy+-+High+Contrast.webp" Stretch="UniformToFill" Opacity="0.23" />
        </Grid.Background>
        <Rectangle Fill="#E0080C0F" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <Grid Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="2" Padding="12" Background="#AA0A0F11" BorderBrush="#253A41" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="10" Text="SYSTEM NODES" />
                    <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding SettingsCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8" Padding="10,6" HorizontalContentAlignment="Left" Command="{Binding DataContext.SelectSettingsCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
                                            <Setter Property="Background" Value="#7F0A0E10" />
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Padding="8" Background="#780A0E10" BorderBrush="#1E2F363C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="LINK STATUS" />
                            <TextBlock Margin="0,3,0,0" Foreground="#DDF1F6" FontFamily="Consolas" FontSize="10" Text="{Binding RuntimeMode}" />
                            <TextBlock Margin="0,3,0,0" Foreground="#7B9CA6" FontFamily="Consolas" FontSize="9">
                                <Run Text="LATENCY: "/>
                                <Run Text="{Binding LatencyText, Mode=OneWay}" Foreground="#A0CCCC"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.Row="0" Margin="16,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14" Background="#AA0A0F11" BorderBrush="#253A41" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Left column: interface type + vehicle profile -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Foreground="#11EDFF" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Text="HARDWARE INTERFACE" />
                            <TextBlock Margin="0,2,0,8" Foreground="#6A909A" FontFamily="Consolas" FontSize="10" Text="LIVE CAN BUS CONNECTION VIA PYTHON-CAN" />
                            <!-- python-can not installed warning -->
                            <Border Padding="8,5" Margin="0,0,0,8" Background="#CC1A0505" BorderBrush="#3A2010" BorderThickness="1"
                                    Visibility="{Binding PythonCanAvailable, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="{Binding PythonCanWarning}" Foreground="#FF8C3A"
                                           FontFamily="Consolas" FontSize="9" TextWrapping="Wrap"/>
                            </Border>
                            <!-- python-can ready indicator -->
                            <Border Padding="8,5" Margin="0,0,0,8" Background="#CC041510" BorderBrush="#1A3A20" BorderThickness="1"
                                    Visibility="{Binding PythonCanAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PythonCanWarning}" Foreground="#56F0AC"
                                           FontFamily="Consolas" FontSize="9"/>
                            </Border>
                            <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="INTERFACE TYPE" />
                            <ComboBox Margin="0,4,0,10"
                                      ItemsSource="{Binding HardwareInterfaceItems}"
                                      SelectedValue="{Binding SelectedHwInterface, Mode=TwoWay}"
                                      FontFamily="Consolas" FontSize="10" Height="24"
                                      ToolTip="python-can interface driver"/>
                            <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="VEHICLE PROFILE (DBC DECODE)" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding HardwareVehicleItems}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedHwVehicleId, Mode=TwoWay}"
                                      FontFamily="Consolas" FontSize="10" Height="24"
                                      ToolTip="Select vehicle to enable DBC signal decode on live frames"/>
                        </StackPanel>
                        <!-- Right column: channel, bitrate, connect -->
                        <StackPanel Grid.Column="1" Margin="12,34,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="CHANNEL" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="SCAN" Height="16" Padding="5,0"
                                                FontFamily="Consolas" FontSize="7.5"
                                                Style="{StaticResource HudActionButtonStyle}"
                                                Command="{Binding RefreshPortsCommand}"
                                                ToolTip="Scan for available serial/COM ports"/>
                                    </Grid>
                                    <ComboBox Margin="0,4,0,0" IsEditable="True"
                                              ItemsSource="{Binding HardwareChannelItems}"
                                              Text="{Binding HwChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              FontFamily="Consolas" FontSize="10" Height="24"
                                              ToolTip="e.g. 0 for PCAN, /dev/can0 for SocketCAN, PCAN_USBBUS1 for PEAK, COM3 for ELM327"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="BITRATE (BPS)" />
                                    <TextBox Margin="0,4,0,0" Style="{StaticResource HudLineTextBoxStyle}"
                                             Text="{Binding HwBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Standard CAN bitrates: 250000, 500000, 1000000"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Width="110" Margin="0,0,8,0" Style="{StaticResource HudActionButtonStyle}"
                                        Command="{Binding ConnectHardwareCommand}"
                                        Content="CONNECT"/>
                                <Button Width="110" Style="{StaticResource HudActionButtonStyle}"
                                        Command="{Binding DisconnectHardwareCommand}"
                                        Content="DISCONNECT"/>
                            </StackPanel>
                            <Border Margin="0,10,0,0" Padding="8,6" Background="#780A0E10" BorderBrush="#1E2F363C" BorderThickness="1">
                                <TextBlock Foreground="#56F0AC" FontFamily="Consolas" FontSize="9"
                                           Text="{Binding HwStatusText}" MinHeight="14"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,12,0,12" Padding="14" Background="#AA0A0F11" BorderBrush="#253A41" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="#11EDFF" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Text="NEURAL CORE CONFIG" />
                            <TextBlock Margin="0,2,0,12" Foreground="#6A909A" FontFamily="Consolas" FontSize="10" Text="AUTONOMOUS ANOMALY DETECTION" />
                            <TextBlock Foreground="#DFF2F6" FontFamily="Consolas" FontSize="11" Text="ENABLE ANOMALY DETECTION" />
                            <TextBlock Margin="0,4,0,12" Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="Real-time telemetry pattern matching and fault prediction" />
                            <Border Padding="10" Background="#780A0E10" BorderBrush="#1E2F363C" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="DETECTION MODEL" />
                                    <TextBlock Margin="0,6,0,0" Foreground="#11EDFF" FontFamily="Consolas" FontSize="11" Text="{Binding DetectionModelText}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#7D9EA8" FontFamily="Consolas" FontSize="9">
                                        <Run Text="Clusters: "/>
                                        <Run Text="{Binding ModelClustersText, Mode=OneWay}" Foreground="#A0CCCC"/>
                                        <Run Text="  |  Status: "/>
                                        <Run Text="{Binding ModelStatusText, Mode=OneWay}" Foreground="#56F0AC"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Foreground="#7D9EA8" FontFamily="Consolas" FontSize="9">
                                        <Run Text="LLM Provider: "/>
                                        <Run Text="{Binding LlmProviderText, Mode=OneWay}" Foreground="#FFD94A"/>
                                        <Run Text="  |  Training: "/>
                                        <Run Text="{Binding TrainingDateText, Mode=OneWay}" Foreground="#A0CCCC"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <Border Padding="8" Background="#2300F6FF" BorderBrush="#2A8CE4F8" BorderThickness="1">
                                <TextBlock Foreground="#11EDFF" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Text="CORE ACTIVE" />
                            </Border>

                            <!-- Google API Key -->
                            <TextBlock Margin="0,16,0,0" Foreground="#6A909A" FontFamily="Consolas" FontSize="9" Text="GOOGLE API KEY (GEMINI)" />
                            <TextBox Margin="0,4,0,0" Style="{StaticResource HudLineTextBoxStyle}"
                                     Text="{Binding GoogleApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Required for Gemini LLM explanations. Saved to AppData\CANvision\config.json"/>

                            <!-- Alert Threshold -->
                            <TextBlock Margin="0,10,0,0" Foreground="#6A909A" FontFamily="Consolas" FontSize="9">
                                <Run Text="ALERT THRESHOLD: "/>
                                <Run Text="{Binding AlertThresholdText, Mode=OneWay}" Foreground="#00C8C8"/>
                            </TextBlock>
                            <Slider Margin="0,6,0,0" Minimum="0.1" Maximum="1.0" SmallChange="0.05"
                                    Value="{Binding AlertThreshold, Mode=TwoWay}"/>

                            <!-- Inject test button -->
                            <Button Margin="0,14,0,0" Style="{StaticResource HudActionButtonStyle}"
                                    Command="{Binding LaunchSimulatorCommand}"
                                    Content="LAUNCH ATTACK TEST"/>

                            <!-- Status feedback -->
                            <TextBlock Margin="0,8,0,0" Foreground="#56F0AC" FontFamily="Consolas" FontSize="9"
                                       Text="{Binding SaveStatusText}" MinHeight="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="12" Background="#AA0A0F11" BorderBrush="#253A41" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Foreground="#6A909A" FontFamily="Consolas" FontSize="10" Text="VEHICLE PROFILES" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ProfileCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileItem}">
                                    <Border Margin="0,0,0,8" Padding="10" Background="#760A0E10" BorderBrush="#1E2F363C" BorderThickness="1">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock Foreground="#DFF2F6" FontFamily="Consolas" FontSize="11" Text="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="#7D9EA8" FontFamily="Consolas" FontSize="9" Text="{Binding Description}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Foreground="#11EDFF" FontFamily="Consolas" FontSize="10" Text="{Binding State}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140" Margin="0,0,10,0" Style="{StaticResource HudActionButtonStyle}"
                        Command="{Binding RestoreDefaultsCommand}" Content="RESTORE DEFAULTS" />
                <Button Width="130" Style="{StaticResource HudActionButtonStyle}"
                        Command="{Binding SaveSettingsCommand}" Content="SAVE SETTINGS" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
