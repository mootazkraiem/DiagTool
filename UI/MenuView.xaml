<UserControl
    x:Class="CANvision.Native.UI.MenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#151A20">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,18"
            Foreground="White"
            FontSize="34"
            FontWeight="Bold"
            Text="CANvisionNative Menu" />

        <WrapPanel Grid.Row="1" ItemHeight="180" ItemWidth="260" HorizontalAlignment="Center">
            <Button x:Name="DashboardCardButton" x:FieldModifier="public" Width="260" Height="180" Margin="10" Background="#232A33" BorderBrush="#3A4452" Foreground="White">
                <StackPanel>
                    <TextBlock FontSize="28" Text="◻" Foreground="#79C8FF" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="Dashboard" />
                    <TextBlock Foreground="#C9D3DD" Text="Session overview and key metrics." TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button x:Name="LiveTelemetryCardButton" x:FieldModifier="public" Width="260" Height="180" Margin="10" Background="#232A33" BorderBrush="#3A4452" Foreground="White">
                <StackPanel>
                    <TextBlock FontSize="28" Text="◻" Foreground="#79C8FF" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="Live Telemetry" />
                    <TextBlock Foreground="#C9D3DD" Text="Real-time CAN stream monitoring." TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button x:Name="AnalysisCardButton" x:FieldModifier="public" Width="260" Height="180" Margin="10" Background="#232A33" BorderBrush="#3A4452" Foreground="White">
                <StackPanel>
                    <TextBlock FontSize="28" Text="◻" Foreground="#79C8FF" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="Analysis" />
                    <TextBlock Foreground="#C9D3DD" Text="Deep anomaly analysis workspace." TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button x:Name="LogsCardButton" x:FieldModifier="public" Width="260" Height="180" Margin="10" Background="#232A33" BorderBrush="#3A4452" Foreground="White">
                <StackPanel>
                    <TextBlock FontSize="28" Text="◻" Foreground="#79C8FF" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="Logs / Diagnostics" />
                    <TextBlock Foreground="#C9D3DD" Text="Operational logs and troubleshooting." TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsCardButton" x:FieldModifier="public" Width="260" Height="180" Margin="10" Background="#232A33" BorderBrush="#3A4452" Foreground="White">
                <StackPanel>
                    <TextBlock FontSize="28" Text="◻" Foreground="#79C8FF" />
                    <TextBlock FontSize="20" FontWeight="Bold" Text="Settings" />
                    <TextBlock Foreground="#C9D3DD" Text="Models, thresholds, and UI options." TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
