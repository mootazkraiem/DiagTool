<!--
  CANvision palette - DARK (default).
  Every colour the design system uses lives here, referenced with DynamicResource,
  so ThemeService can swap this dictionary for Palette.Light.xaml at runtime.
  Values are exactly the ones the approved screens were built with.
  Palette.Light.xaml must define the same keys.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- raw colours (for animations/effects) -->
    <Color x:Key="CvGroundColor">#04070A</Color>
    <Color x:Key="CvCyanColor">#2FF0D6</Color>
    <Color x:Key="CvCyanSoftColor">#7EF7E4</Color>
    <Color x:Key="CvGreenColor">#35E6A1</Color>
    <Color x:Key="CvAmberColor">#FFB245</Color>
    <Color x:Key="CvRedColor">#FF4D5E</Color>
    <Color x:Key="CvVioletColor">#B07BFF</Color>

    <!-- surfaces -->
    <SolidColorBrush x:Key="CvGroundBrush" Color="#04070A" />
    <SolidColorBrush x:Key="CvChromeBrush" Color="#070D10" />
    <LinearGradientBrush x:Key="CvPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1416" Offset="0" />
        <GradientStop Color="#050B0D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CvTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C1619" Offset="0" />
        <GradientStop Color="#060C0E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CvInsetBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="CvTableHeadBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CvRowHoverBrush" Color="#0D2FF0D6" />
    <SolidColorBrush x:Key="CvScrimBrush" Color="#CC04070A" />

    <!-- borders -->
    <SolidColorBrush x:Key="CvBorderBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="CvBorderStrongBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CvBorderAccentBrush" Color="#292FF0D6" />
    <SolidColorBrush x:Key="CvBorderAccentStrongBrush" Color="#732FF0D6" />
    <SolidColorBrush x:Key="CvBorderDangerBrush" Color="#29FF4D5E" />
    <SolidColorBrush x:Key="CvBorderWarnBrush" Color="#33FFB245" />
    <SolidColorBrush x:Key="CvBorderVioletBrush" Color="#33B07BFF" />
    <SolidColorBrush x:Key="CvSeparatorBrush" Color="#0CFFFFFF" />

    <!-- text -->
    <SolidColorBrush x:Key="CvTextBrightBrush" Color="#EAFFFB" />
    <SolidColorBrush x:Key="CvTextBrush" Color="#DBE9E7" />
    <SolidColorBrush x:Key="CvTextSoftBrush" Color="#A9C2BE" />
    <SolidColorBrush x:Key="CvTextMutedBrush" Color="#95ABA8" />
    <SolidColorBrush x:Key="CvTextDimBrush" Color="#7F9693" />
    <SolidColorBrush x:Key="CvTextFaintBrush" Color="#556B68" />

    <!-- accent / semantic -->
    <SolidColorBrush x:Key="CvAccentBrush" Color="#2FF0D6" />
    <SolidColorBrush x:Key="CvAccentSoftBrush" Color="#7EF7E4" />
    <SolidColorBrush x:Key="CvAccentDimBrush" Color="#8FD8CD" />
    <SolidColorBrush x:Key="CvOkBrush" Color="#35E6A1" />
    <SolidColorBrush x:Key="CvWarnBrush" Color="#FFB245" />
    <SolidColorBrush x:Key="CvDangerBrush" Color="#FF4D5E" />
    <SolidColorBrush x:Key="CvVioletBrush" Color="#B07BFF" />
    <SolidColorBrush x:Key="CvVioletSoftBrush" Color="#C9A6FF" />

    <!-- translucent washes -->
    <SolidColorBrush x:Key="CvAccentWashBrush" Color="#102FF0D6" />
    <SolidColorBrush x:Key="CvWarnWashBrush" Color="#0DFFB245" />
    <SolidColorBrush x:Key="CvDangerWashBrush" Color="#0FFF4D5E" />
    <SolidColorBrush x:Key="CvVioletWashBrush" Color="#1AB07BFF" />

    <!-- glows -->
    <DropShadowEffect x:Key="CvAccentGlow" BlurRadius="12" ShadowDepth="0" Color="#2FF0D6" Opacity="0.45" />
    <DropShadowEffect x:Key="CvAccentGlowSoft" BlurRadius="8" ShadowDepth="0" Color="#2FF0D6" Opacity="0.3" />
    <DropShadowEffect x:Key="CvDangerGlow" BlurRadius="10" ShadowDepth="0" Color="#FF4D5E" Opacity="0.4" />
    <DropShadowEffect x:Key="CvWarnGlow" BlurRadius="10" ShadowDepth="0" Color="#FFB245" Opacity="0.35" />
    <DropShadowEffect x:Key="CvVioletGlow" BlurRadius="12" ShadowDepth="0" Color="#B07BFF" Opacity="0.4" />

    <!-- charts -->
    <SolidColorBrush x:Key="CvChartGridBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CvChartPlotBrush" Color="#06000000" />
    <LinearGradientBrush x:Key="CvChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#572FF0D6" Offset="0" />
        <GradientStop Color="#002FF0D6" Offset="1" />
    </LinearGradientBrush>

    <!-- OVERLAYS (generated): white-alpha fills/lines that were hardcoded in templates -->
    <SolidColorBrush x:Key="CvOverlay05Brush" Color="#05FFFFFF" />
    <SolidColorBrush x:Key="CvOverlay06Brush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="CvOverlay08Brush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CvOverlay0DBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CvOverlay0EBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="CvOverlay12Brush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CvOverlay14Brush" Color="#14FFFFFF" />

    <!-- component surfaces (popups, overlays, special cards) -->
    <SolidColorBrush x:Key="CvPopupBrush" Color="#F2070D10" />
    <SolidColorBrush x:Key="CvToolTipBrush" Color="#F5060F12" />
    <SolidColorBrush x:Key="CvThreatTitleBrush" Color="#FFD7DB" />
    <SolidColorBrush x:Key="CvRingTrackBrush" Color="#141F1F" />
    <SolidColorBrush x:Key="CvEmptyScrimBrush" Color="#CC071520" />
    <SolidColorBrush x:Key="CvEmptyLabelBrush" Color="#2A5A5A" />
    <SolidColorBrush x:Key="CvEmptyTitleBrush" Color="#3A7070" />
    <SolidColorBrush x:Key="CvEmptySubtitleBrush" Color="#255050" />
    <SolidColorBrush x:Key="CvBannerBrush" Color="#E0071520" />
    <SolidColorBrush x:Key="CvBannerBorderBrush" Color="#4000C8C8" />
    <SolidColorBrush x:Key="CvBannerTrackBrush" Color="#08001818" />
    <SolidColorBrush x:Key="CvBannerProgressBrush" Color="#509090" />
    <LinearGradientBrush x:Key="CvThreatCardBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1A2A1215" Offset="0" />
        <GradientStop Color="#F0070B0D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CvRuntimeCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A2A1E0C" Offset="0" />
        <GradientStop Color="#F0070B0D" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
