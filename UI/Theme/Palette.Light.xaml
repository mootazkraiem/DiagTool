<!--
  CANvision palette - LIGHT.
  Same keys as Palette.Dark.xaml. A cool off-white ground with white panels,
  near-black teal text, and the brand accent darkened to a teal that stays
  readable on white. Semantic hues are deepened for the same reason. Glows are
  switched off: a coloured halo reads as blur on a light background.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- raw colours (for animations/effects) -->
    <Color x:Key="CvGroundColor">#EEF3F2</Color>
    <Color x:Key="CvCyanColor">#08907F</Color>
    <Color x:Key="CvCyanSoftColor">#0DA894</Color>
    <Color x:Key="CvGreenColor">#13925F</Color>
    <Color x:Key="CvAmberColor">#B06E06</Color>
    <Color x:Key="CvRedColor">#CC2536</Color>
    <Color x:Key="CvVioletColor">#6F43CC</Color>

    <!-- surfaces -->
    <SolidColorBrush x:Key="CvGroundBrush" Color="#EEF3F2" />
    <SolidColorBrush x:Key="CvChromeBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="CvPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7FAF9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CvTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8FBFA" Offset="0" />
        <GradientStop Color="#F1F5F4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CvInsetBrush" Color="#0A0B2F2B" />
    <SolidColorBrush x:Key="CvTableHeadBrush" Color="#0D0B2F2B" />
    <SolidColorBrush x:Key="CvRowHoverBrush" Color="#1408907F" />
    <SolidColorBrush x:Key="CvScrimBrush" Color="#CCEEF3F2" />

    <!-- borders -->
    <SolidColorBrush x:Key="CvBorderBrush" Color="#1F0B2F2B" />
    <SolidColorBrush x:Key="CvBorderStrongBrush" Color="#330B2F2B" />
    <SolidColorBrush x:Key="CvBorderAccentBrush" Color="#5208907F" />
    <SolidColorBrush x:Key="CvBorderAccentStrongBrush" Color="#A608907F" />
    <SolidColorBrush x:Key="CvBorderDangerBrush" Color="#52CC2536" />
    <SolidColorBrush x:Key="CvBorderWarnBrush" Color="#5CB06E06" />
    <SolidColorBrush x:Key="CvBorderVioletBrush" Color="#5C6F43CC" />
    <SolidColorBrush x:Key="CvSeparatorBrush" Color="#170B2F2B" />

    <!-- text -->
    <SolidColorBrush x:Key="CvTextBrightBrush" Color="#0B1F1D" />
    <SolidColorBrush x:Key="CvTextBrush" Color="#1B302D" />
    <SolidColorBrush x:Key="CvTextSoftBrush" Color="#3A534F" />
    <SolidColorBrush x:Key="CvTextMutedBrush" Color="#516B67" />
    <SolidColorBrush x:Key="CvTextDimBrush" Color="#6A8480" />
    <SolidColorBrush x:Key="CvTextFaintBrush" Color="#98ACA9" />

    <!-- accent / semantic -->
    <SolidColorBrush x:Key="CvAccentBrush" Color="#08907F" />
    <SolidColorBrush x:Key="CvAccentSoftBrush" Color="#0DA894" />
    <SolidColorBrush x:Key="CvAccentDimBrush" Color="#2C7D72" />
    <SolidColorBrush x:Key="CvOkBrush" Color="#13925F" />
    <SolidColorBrush x:Key="CvWarnBrush" Color="#B06E06" />
    <SolidColorBrush x:Key="CvDangerBrush" Color="#CC2536" />
    <SolidColorBrush x:Key="CvVioletBrush" Color="#6F43CC" />
    <SolidColorBrush x:Key="CvVioletSoftBrush" Color="#5E36B8" />

    <!-- translucent washes -->
    <SolidColorBrush x:Key="CvAccentWashBrush" Color="#1408907F" />
    <SolidColorBrush x:Key="CvWarnWashBrush" Color="#14B06E06" />
    <SolidColorBrush x:Key="CvDangerWashBrush" Color="#14CC2536" />
    <SolidColorBrush x:Key="CvVioletWashBrush" Color="#146F43CC" />

    <!-- glows: off in light mode -->
    <DropShadowEffect x:Key="CvAccentGlow" BlurRadius="0" ShadowDepth="0" Color="#08907F" Opacity="0" />
    <DropShadowEffect x:Key="CvAccentGlowSoft" BlurRadius="0" ShadowDepth="0" Color="#08907F" Opacity="0" />
    <DropShadowEffect x:Key="CvDangerGlow" BlurRadius="0" ShadowDepth="0" Color="#CC2536" Opacity="0" />
    <DropShadowEffect x:Key="CvWarnGlow" BlurRadius="0" ShadowDepth="0" Color="#B06E06" Opacity="0" />
    <DropShadowEffect x:Key="CvVioletGlow" BlurRadius="0" ShadowDepth="0" Color="#6F43CC" Opacity="0" />

    <!-- charts -->
    <SolidColorBrush x:Key="CvChartGridBrush" Color="#170B2F2B" />
    <SolidColorBrush x:Key="CvChartPlotBrush" Color="#050B2F2B" />
    <LinearGradientBrush x:Key="CvChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4008907F" Offset="0" />
        <GradientStop Color="#0008907F" Offset="1" />
    </LinearGradientBrush>

    <!-- OVERLAYS (generated): the light counterpart of each dark white-alpha overlay -->
    <SolidColorBrush x:Key="CvOverlay05Brush" Color="#080B2F2B" />
    <SolidColorBrush x:Key="CvOverlay06Brush" Color="#0A0B2F2B" />
    <SolidColorBrush x:Key="CvOverlay08Brush" Color="#0D0B2F2B" />
    <SolidColorBrush x:Key="CvOverlay0DBrush" Color="#150B2F2B" />
    <SolidColorBrush x:Key="CvOverlay0EBrush" Color="#160B2F2B" />
    <SolidColorBrush x:Key="CvOverlay12Brush" Color="#1D0B2F2B" />
    <SolidColorBrush x:Key="CvOverlay14Brush" Color="#200B2F2B" />

    <!-- component surfaces (popups, overlays, special cards) -->
    <SolidColorBrush x:Key="CvPopupBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="CvToolTipBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="CvThreatTitleBrush" Color="#9E1F2D" />
    <SolidColorBrush x:Key="CvRingTrackBrush" Color="#DDE6E5" />
    <SolidColorBrush x:Key="CvEmptyScrimBrush" Color="#D9EEF3F2" />
    <SolidColorBrush x:Key="CvEmptyLabelBrush" Color="#6A8480" />
    <SolidColorBrush x:Key="CvEmptyTitleBrush" Color="#3A534F" />
    <SolidColorBrush x:Key="CvEmptySubtitleBrush" Color="#516B67" />
    <SolidColorBrush x:Key="CvBannerBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="CvBannerBorderBrush" Color="#5208907F" />
    <SolidColorBrush x:Key="CvBannerTrackBrush" Color="#140B2F2B" />
    <SolidColorBrush x:Key="CvBannerProgressBrush" Color="#516B67" />
    <LinearGradientBrush x:Key="CvThreatCardBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#FFFBEFF0" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CvRuntimeCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDF5E8" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
