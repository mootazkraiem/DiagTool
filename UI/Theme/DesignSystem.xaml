<!--
    ============================================================
    CANvision IDS — CENTRAL DESIGN SYSTEM
    ============================================================
    Single source of truth for the application's visual language.
    Derived from the CANvision IDS reference mockup:
    dark technical instrument console, hairline borders,
    near-square geometry, compact uppercase labels, mono numerics.

    NAMING: every key is prefixed "Cv" so it never collides with
    the legacy Hud*/CanVision* keys in ThemeResources.xaml.

    RULES THIS FILE ENCODES
      - Ground is near-black (#04070A family), never grey/white.
      - Borders are 1px, low-opacity white or low-opacity cyan.
      - Corner radius 0-3px. This is an instrument panel, not a
        consumer app.
      - Accent colour is spent sparingly: it marks live state,
        selection, and severity — never decoration.
      - Hierarchy comes from weight/spacing/uppercase/accent,
        not from large type.
    ============================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         1. COLOURS  (raw Color values, for animations/effects)
         ============================================================ -->


    <!-- ============================================================
         2. SURFACES
         Progressively lighter as elements stack toward the viewer.
         ============================================================ -->

    <!-- Application ground -->
    <!-- Chrome: nav bar, title bar, footer strips -->
    <!-- Standard panel / card fill -->
    <!-- Metric tile fill (very slightly lifted vs panel) -->
    <!-- Nested block inside a panel -->
    <!-- Table header band -->
    <!-- Row hover -->
    <!-- Modal / overlay scrim -->

    <!-- ============================================================
         3. BORDERS  — hairline, low opacity
         ============================================================ -->


    <!-- ============================================================
         4. TEXT
         ============================================================ -->


    <!-- ============================================================
         5. ACCENT / SEMANTIC
         Semantic colour is SEPARATE from the cyan brand accent:
         good / warn / critical must read at a glance.
         ============================================================ -->


    <!-- Translucent accent washes for pills / active states -->

    <!-- ============================================================
         6. TYPOGRAPHY
         Display face carries UI chrome; mono carries every
         technical value (CAN IDs, hex, timestamps, numerics).
         ============================================================ -->

    <FontFamily x:Key="CvDisplayFont">/CANvisionNative;component/assets/fonts/#Space Grotesk, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="CvUiFont">/CANvisionNative;component/assets/fonts/#Space Grotesk, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="CvMonoFont">/CANvisionNative;component/assets/fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="CvFontMicro">9</sys:Double>
    <sys:Double x:Key="CvFontLabel">10.5</sys:Double>
    <sys:Double x:Key="CvFontBody">12</sys:Double>
    <sys:Double x:Key="CvFontSection">13</sys:Double>
    <sys:Double x:Key="CvFontValue">20</sys:Double>
    <sys:Double x:Key="CvFontValueLg">26</sys:Double>

    <!-- Uppercase micro-label that sits above a value -->
    <Style x:Key="CvLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Even quieter caption -->
    <Style x:Key="CvMetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextFaintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Panel / section heading -->
    <Style x:Key="CvSectionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvDisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrightBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Primary metric number -->
    <Style x:Key="CvValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrightBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CvValueLargeText" TargetType="TextBlock" BasedOn="{StaticResource CvValueText}">
        <Setter Property="FontSize" Value="26" />
    </Style>

    <!-- Technical value: CAN IDs, hex payloads, timestamps, numerics -->
    <Style x:Key="CvMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CvMonoAccentText" TargetType="TextBlock" BasedOn="{StaticResource CvMonoText}">
        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
    </Style>

    <Style x:Key="CvBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextSoftBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================================================
         7. GLOWS
         Restrained. Only live/active elements glow.
         ============================================================ -->


    <!-- ============================================================
         8. PANELS
         ============================================================ -->

    <Style x:Key="CvPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Panel carrying the brand accent: used for the focused/live panel -->
    <Style x:Key="CvPanelAccent" TargetType="Border" BasedOn="{StaticResource CvPanel}">
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}" />
    </Style>

    <Style x:Key="CvPanelDanger" TargetType="Border" BasedOn="{StaticResource CvPanel}">
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderDangerBrush}" />
    </Style>

    <Style x:Key="CvPanelViolet" TargetType="Border" BasedOn="{StaticResource CvPanel}">
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderVioletBrush}" />
    </Style>

    <!-- Metric tile. Pair with CvTileAccentBar for the top accent line. -->
    <Style x:Key="CvTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 2px coloured rule pinned to the top edge of a metric tile -->
    <Style x:Key="CvTileAccentBar" TargetType="Rectangle">
        <Setter Property="Height" Value="2" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Fill" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Nested block inside a panel (quiet, borderless-looking) -->
    <Style x:Key="CvInset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="11,9" />
    </Style>

    <!-- The 3px vertical accent tick that prefixes a section heading -->
    <Style x:Key="CvSectionMarker" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="13" />
        <Setter Property="RadiusX" Value="1" />
        <Setter Property="RadiusY" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Effect" Value="{DynamicResource CvAccentGlowSoft}" />
    </Style>

    <!-- Horizontal hairline rule -->
    <Style x:Key="CvRule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource CvSeparatorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============================================================
         9. STATUS INDICATORS
         ============================================================ -->

    <!-- Small round state dot. Set Fill per severity at the call site. -->
    <Style x:Key="CvStatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{DynamicResource CvAccentGlowSoft}" />
    </Style>

    <!-- Same dot, but breathing: marks a genuinely LIVE stream. -->
    <Style x:Key="CvStatusDotPulse" TargetType="Ellipse" BasedOn="{StaticResource CvStatusDot}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="Opacity"
                            From="1.0" To="0.35" Duration="0:0:1.1"
                            AutoReverse="True" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pill container for "● SECURE LINK" style badges -->
    <Style x:Key="CvBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvAccentWashBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="CvBadgeWarn" TargetType="Border" BasedOn="{StaticResource CvBadge}">
        <Setter Property="Background" Value="{DynamicResource CvWarnWashBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderWarnBrush}" />
    </Style>

    <Style x:Key="CvBadgeDanger" TargetType="Border" BasedOn="{StaticResource CvBadge}">
        <Setter Property="Background" Value="{DynamicResource CvDangerWashBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderDangerBrush}" />
    </Style>

    <!-- Square status chip used inside table rows (severity tag) -->
    <Style x:Key="CvChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Background" Value="{DynamicResource CvAccentWashBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         10. BUTTONS
         Templated — the default WPF chrome is replaced entirely.
         ============================================================ -->

    <Style x:Key="CvButtonGhost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CvTextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource CvOverlay05Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource CvDisplayFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CvAccentWashBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CvBorderAccentStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1A2FF0D6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource CvTextFaintBrush}" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The affirmative action on a screen. Use ONE per view. -->
    <Style x:Key="CvButtonPrimary" TargetType="Button" BasedOn="{StaticResource CvButtonGhost}">
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderAccentStrongBrush}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2E2FF0D6" Offset="0" />
                    <GradientStop Color="#0A2FF0D6" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CvButtonDanger" TargetType="Button" BasedOn="{StaticResource CvButtonGhost}">
        <Setter Property="Foreground" Value="{DynamicResource CvDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderDangerBrush}" />
        <Setter Property="Background" Value="{DynamicResource CvDangerWashBrush}" />
    </Style>

    <!-- Compact transport / icon button (playback controls) -->
    <Style x:Key="CvButtonTransport" TargetType="Button" BasedOn="{StaticResource CvButtonGhost}">
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- ============================================================
         11. INPUTS
         ============================================================ -->

    <Style x:Key="CvTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CvOverlay0DBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CvBorderAccentStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CvPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource CvOverlay0DBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ComboBox: fully retemplated, including its popup and items. -->
    <Style x:Key="CvComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CvAccentWashBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CvComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource CvOverlay0DBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CvComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Background>
                                <SolidColorBrush Color="#0DFFFFFF" />
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <SolidColorBrush Color="#1AFFFFFF" />
                            </ToggleButton.BorderBrush>
                        </ToggleButton>

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <!-- Chevron -->
                        <Path Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{DynamicResource CvTextDimBrush}"
                              StrokeThickness="1.3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource CvPopupBrush}"
                                    BorderBrush="{DynamicResource CvBorderAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox as a small square technical toggle -->
    <Style x:Key="CvCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource CvTextSoftBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="14" Height="14"
                                CornerRadius="2"
                                Background="{DynamicResource CvOverlay0DBrush}"
                                BorderBrush="{DynamicResource CvBorderStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Data="M 0 3 L 2.5 5.5 L 7 0.5"
                                  Stroke="{DynamicResource CvAccentBrush}"
                                  StrokeThickness="1.6"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CvBorderAccentStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CvBorderAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin technical track with a square-ish thumb -->
    <Style x:Key="CvSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="18">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource CvOverlay12Brush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource CvAccentBrush}"
                                                    Opacity="0.85"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="12" Height="12" CornerRadius="2"
                                                    Background="{DynamicResource CvTextBrightBrush}"
                                                    Effect="{DynamicResource CvAccentGlowSoft}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         12. PROGRESS
         ============================================================ -->

    <Style x:Key="CvProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource CvOverlay12Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================================================
         13. TABLES
         Dense technical rows: mono cells, hairline separators,
         compact vertical rhythm. Never a default DataGrid look.
         ============================================================ -->

    <Style x:Key="CvTableHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CvTableHeaderBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvTableHeadBrush}" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="CvTableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CvSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CvRowHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CvTableCell" TargetType="TextBlock" BasedOn="{StaticResource CvMonoText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CvTableCellAccent" TargetType="TextBlock" BasedOn="{StaticResource CvTableCell}">
        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}" />
    </Style>

    <Style x:Key="CvTableCellDim" TargetType="TextBlock" BasedOn="{StaticResource CvTableCell}">
        <Setter Property="Foreground" Value="{DynamicResource CvTextDimBrush}" />
    </Style>

    <!-- ============================================================
         14. SCROLLBAR  — thin, unobtrusive, no arrows
         Applied globally (no x:Key) so every scrollable surface
         inherits it and no default WPF scrollbar ever appears.
         ============================================================ -->

    <Style x:Key="CvScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#332FF0D6" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CvScrollHiddenButton" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource CvScrollHiddenButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CvScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource CvScrollHiddenButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource CvScrollHiddenButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource CvScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource CvScrollHiddenButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         15. TOOLTIP
         ============================================================ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource CvTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource CvPopupBrush}"
                            BorderBrush="{DynamicResource CvBorderAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         16. CHART PRIMITIVES
         ============================================================ -->


    <!-- Area fill under a trend line -->

    <Style x:Key="CvChartFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CvChartPlotBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CvBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="CvChartAxisText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvMonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextFaintBrush}" />
    </Style>

    <!-- ============================================================
         17. EMPTY / LOADING STATE
         ============================================================ -->

    <Style x:Key="CvEmptyTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvDisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextDimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CvEmptyBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CvUiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource CvTextFaintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
