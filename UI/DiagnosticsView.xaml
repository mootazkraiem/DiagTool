<!--
  ===========================================================================
  DIAGNOSTICS  -  CANvision IDS
  ===========================================================================
  Composition rebuilt against the CANvision reference, in the visual language
  of the approved Dashboard and Telemetry screens:

    [ status ribbon .......................................... clock ]
    [ 6 KPI tiles: adapter / bus / fps / events / score / reliability ]
    [ adapter health  ] [ IDS event log ............................. ]
    [ recovery actions] [                                            ]

  Presentation only. Every value binds to an existing DiagnosticsViewModel or
  SectionViewModel property, and the three recovery actions keep their existing
  commands. Event rows use the real RuntimeAlertEvent fields; with no events the
  table shows an explicit empty state instead of placeholder rows.
  ===========================================================================
-->
<UserControl
    x:Class="CANvision.Native.UI.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:cv="clr-namespace:CANvision.Native.UI.Controls"
    Background="{DynamicResource CvGroundBrush}"
    UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- status ribbon -->
            <RowDefinition Height="*"/>      <!-- body -->
        </Grid.RowDefinitions>

        <!-- Ambient wash, as on Dashboard / Telemetry -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,-0.05" GradientOrigin="0.18,-0.05" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#16145654" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ STATUS RIBBON ════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CvRibbon}" Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                    <cv:CvTrackedText Label="{Binding ConnectivityText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      FontFamily="{StaticResource CvMonoFont}" FontSize="11" FontWeight="SemiBold"
                                      Foreground="{DynamicResource CvAccentBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="14" Margin="18,0" Fill="{DynamicResource CvBorderAccentBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="STATUS"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonValue}" Label="{Binding DiagnosticsStatus}"
                                      Foreground="{DynamicResource CvAccentBrush}"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="DATASET" Margin="26,0,0,0"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonValue}" Label="{Binding WorkspaceText}" Upper="False"
                                      MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    <cv:CvTrackedText Style="{StaticResource CvRibbonKey}" Label="BUS" Margin="26,0,0,0"/>
                    <cv:CvTrackedText Label="{Binding SignalHealthText}" Margin="8,0,0,0">
                        <cv:CvTrackedText.Style>
                            <Style TargetType="cv:CvTrackedText" BasedOn="{StaticResource CvRibbonKey}">
                                <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SignalHealthText}" Value="STABLE">
                                        <Setter Property="Foreground" Value="{DynamicResource CvAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cv:CvTrackedText.Style>
                    </cv:CvTrackedText>
                </StackPanel>

                <cv:CvTrackedText Grid.Column="3" Label="{Binding UpdatedText}" VerticalAlignment="Center"
                                  FontFamily="{StaticResource CvMonoFont}" FontSize="12" FontWeight="SemiBold"
                                  Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KPI strip -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="6" Margin="-5,0">
                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="ADAPTER STATUS" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding ConnectivityText}" Style="{StaticResource CvTileValue}" FontSize="17"
                                       Foreground="{DynamicResource CvAccentBrush}" Effect="{DynamicResource CvAccentGlowSoft}"/>
                            <cv:CvTrackedText Label="{Binding UnitNameText}" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentSoftBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="BUS HEALTH" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding SignalHealthText}" FontSize="17">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CvTileValue}">
                                        <Setter Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignalHealthText}" Value="STABLE">
                                                <Setter Property="Foreground" Value="{DynamicResource CvOkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <cv:CvTrackedText Label="MOTOR / SIGNAL STATE" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvAccentBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="RUNTIME FPS" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding DiagPacketRateText}" Style="{StaticResource CvTileValue}"/>
                            <cv:CvTrackedText Label="FRAMES / SEC" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvWarnBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="IDS EVENTS" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding TotalEventsText}" Style="{StaticResource CvTileValue}"/>
                            <cv:CvTrackedText Label="IN EVENT LOG" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvDangerBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="FUSION SCORE" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding CurrentRiskText}" Style="{StaticResource CvTileValue}"/>
                            <cv:CvTrackedText Label="{Binding CurrentAttackText}" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CvKpiTile}" Margin="5,0">
                    <Grid>
                        <Rectangle Style="{StaticResource CvTileRule}" Fill="{DynamicResource CvVioletBrush}"/>
                        <StackPanel Margin="12,11,10,0">
                            <cv:CvTrackedText Label="RELIABILITY" Style="{StaticResource CvCaps}"/>
                            <TextBlock Text="{Binding ReliabilityScoreText}" Style="{StaticResource CvTileValue}"
                                       Foreground="{DynamicResource CvVioletSoftBrush}" Effect="{DynamicResource CvVioletGlow}"/>
                            <cv:CvTrackedText Label="MODEL CONFIDENCE" Style="{StaticResource CvTileMeta}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- adapter health + recovery | IDS event log -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*" MinWidth="320" MaxWidth="400"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── ADAPTER HEALTH + RECOVERY ACTIONS ───────────────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardFlush}" BorderBrush="{DynamicResource CvBorderAccentBrush}">
                        <StackPanel Margin="18,15,18,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Style="{StaticResource CvSectionMarker}"/>
                                <cv:CvTrackedText Label="ADAPTER HEALTH" Style="{StaticResource CvPanelTitle}"/>
                            </StackPanel>

                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="ADAPTER TYPE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding UnitNameText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="CONNECTION" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding ConnectivityText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvAccentBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="SOURCE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="RUNTIME" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding ModelText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="DATASET" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding WorkspaceText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="UPTIME" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding SessionTimerText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="LAST UPDATE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource CvKvValue}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRow}">
                                <cv:CvTrackedText Label="LATENCY" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding DiagLatencyText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvWarnBrush}"
                                           ToolTip="Runtime latency. Offline replay: total backend ML analysis time for the loaded log. Live session: measured round-trip of each /vehicle poll."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource CvKvRowTight}" Margin="0,4,0,0">
                                <cv:CvTrackedText Label="CONFIDENCE" Style="{StaticResource CvKvKey}"/>
                                <TextBlock Text="{Binding DiagConfidenceText}" Style="{StaticResource CvKvValue}"
                                           Foreground="{DynamicResource CvVioletSoftBrush}"/>
                            </DockPanel>

                            <!-- live status pill -->
                            <Border Style="{StaticResource CvBadge}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="11,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                                    <cv:CvTrackedText Label="{Binding DiagnosticsStatus}" Margin="8,0,0,0"
                                                      FontFamily="{StaticResource CvMonoFont}" FontSize="10"
                                                      Foreground="{DynamicResource CvAccentDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardFlush}">
                        <StackPanel Margin="18,15,18,16">
                            <cv:CvTrackedText Label="RECOVERY ACTIONS" Style="{StaticResource CvCaps}" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource CvButtonGhost}" Height="38" Command="{Binding RunFullScanCommand}"
                                    ToolTip="Reload the IDS event log from the runtime alert history">
                                <cv:CvTrackedText Label="RELOAD EVENT LOG" FontFamily="{StaticResource CvDisplayFont}"
                                                  FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource CvButtonPrimary}" Height="38" Margin="0,8,0,0"
                                    Command="{Binding RestartAllServicesCommand}"
                                    ToolTip="Restart the backend services (asks for confirmation)">
                                <cv:CvTrackedText Label="RESTART ALL SERVICES" FontFamily="{StaticResource CvDisplayFont}"
                                                  FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource CvButtonDanger}" Height="38" Margin="0,8,0,0"
                                    Command="{Binding ClearAlertsCommand}"
                                    ToolTip="Clear the event view (asks for confirmation)">
                                <cv:CvTrackedText Label="CLEAR ERROR LOG" FontFamily="{StaticResource CvDisplayFont}"
                                                  FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── IDS EVENT LOG ───────────────────────────────────── -->
                <Border Grid.Column="2" Style="{StaticResource CardFlush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{DynamicResource CvBorderAccentBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Style="{StaticResource CvSectionMarker}"
                                           Fill="{DynamicResource CvWarnBrush}" Effect="{DynamicResource CvWarnGlow}"/>
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="IDS EVENT LOG" Style="{StaticResource CvPanelTitle}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalEventsText}" FontFamily="{StaticResource CvMonoFont}" FontSize="10.5"
                                               Foreground="{DynamicResource CvTextSoftBrush}"/>
                                    <cv:CvTrackedText Label="ENTRIES" Style="{StaticResource CvCaps}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- column heads -->
                        <Border Grid.Row="1" Background="{DynamicResource CvTableHeadBrush}" Padding="16,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/><ColumnDefinition Width="72"/><ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <cv:CvTrackedText Grid.Column="0" Label="TIME" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText Grid.Column="1" Label="SEVERITY" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText Grid.Column="2" Label="ATTACK" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText Grid.Column="3" Label="CAN ID" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText Grid.Column="4" Label="SCORE" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText Grid.Column="5" Label="REASON" Style="{StaticResource CvCaps}" FontSize="9"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredIdsEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RuntimeAlertEvent}">
                                        <Border Style="{StaticResource CvTableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/><ColumnDefinition Width="72"/><ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource CvCell}" FontSize="11"
                                                           Foreground="{DynamicResource CvTextSoftBrush}"
                                                           Text="{Binding TimestampUtc, Converter={StaticResource UtcToLocalTimeConverter}}"/>
                                                <TextBlock x:Name="Sev" Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource CvCell}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CvTextMutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AttackType}" Style="{StaticResource CvCell}"
                                                           FontSize="10.5" Foreground="{DynamicResource CvTextBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CanId}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvAccentBrush}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Score, StringFormat=F2}" Style="{StaticResource CvCell}"
                                                           Foreground="{DynamicResource CvTextBrush}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Reason}" Style="{StaticResource CvCell}"
                                                           FontSize="10.5" Foreground="{DynamicResource CvTextSoftBrush}"
                                                           ToolTip="{Binding Reason}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvDangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="WARN">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvWarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="INFO">
                                                <Setter TargetName="Sev" Property="Foreground" Value="{DynamicResource CvAccentDimBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- empty state -->
                        <StackPanel Grid.Row="2" Style="{StaticResource CvEmptyWhenZero}" Tag="{Binding FilteredIdsEvents.Count}">
                            <Border Style="{StaticResource CvEmptyGlyph}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CvTextFaintBrush}"/>
                            </Border>
                            <cv:CvTrackedText Label="NO IDS EVENTS" Style="{StaticResource CvCaps}"
                                              HorizontalAlignment="Center" Margin="0,11,0,0"/>
                            <TextBlock Text="Detections appear here as the IDS scores a replay or live session."
                                       Style="{StaticResource CvEmptyBody}"/>
                        </StackPanel>

                        <Border Grid.Row="3" BorderBrush="{DynamicResource CvSeparatorBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                            <DockPanel LastChildFill="False">
                                <cv:CvTrackedText DockPanel.Dock="Left" Label="END OF BUFFER" Style="{StaticResource CvCaps}" FontSize="9"/>
                                <cv:CvTrackedText DockPanel.Dock="Right" Label="{Binding CurrentAttackText}" Style="{StaticResource CvCaps}" FontSize="9"
                                                  Foreground="{DynamicResource CvTextSoftBrush}"/>
                                <cv:CvTrackedText DockPanel.Dock="Right" Label="DETECTED ATTACK" Style="{StaticResource CvCaps}" FontSize="9"
                                                  Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
