<UserControl
    x:Class="CANvision.Native.UI.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:CANvision.Native.Models"
    xmlns:vm="clr-namespace:CANvision.Native.ViewModels"
    Background="#060E0E">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F1A1A" Offset="0"/>
                        <GradientStop Color="#0A1212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#28009999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="InnerCard" TargetType="Border">
            <Setter Property="Background" Value="#08000000"/>
            <Setter Property="BorderBrush" Value="#182F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,8"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="#3A6060"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#2A4A4A"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#D0ECEC"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#56F0AC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource HudActionButtonStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="Foreground" Value="#00C8C8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="WARNING">
                    <Setter Property="Foreground" Value="#FFB84A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="#FFB84A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="INFO">
                    <Setter Property="Foreground" Value="#00C8C8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="Foreground" Value="#00C8C8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="ERROR">
                    <Setter Property="Foreground" Value="#FF5050"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="#FF5050"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                    <Setter Property="Foreground" Value="#FF2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Foreground" Value="#FF2626"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.58" RadiusY="0.55">
                    <GradientStop Color="#08001818" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <UniformGrid Grid.Row="0" Columns="6" Margin="12,10,12,8">
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ADAPTER STATUS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding ConnectivityText}" Foreground="#56F0AC" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding AgeText, StringFormat='Heartbeat {0}'}" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BUS HEALTH" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding SignalHealthText}" Foreground="#56F0AC" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding DiagnosticsStatus}" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RUNTIME FPS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding DiagPacketRateText}" Foreground="#00C8C8" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Frames per second" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="IDS EVENTS" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding TotalEventsText}" Foreground="#FF8C3A" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="Total alerts fired" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="FUSION SCORE" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding CurrentRiskText}" Foreground="#FF5050" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding CurrentAttackText}" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LAST HEARTBEAT" Style="{StaticResource Lbl}"/>
                    <TextBlock Grid.Row="1" Text="{Binding AgeText}" Foreground="#56F0AC" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding UpdatedText, StringFormat='Last check {0}'}" Style="{StaticResource Meta}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ADAPTER HEALTH" Style="{StaticResource Title}"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ADAPTER TYPE" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UnitNameText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="1" Text="CONNECTION" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectivityText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="2" Text="PORT" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="3" Text="FIRMWARE" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="4" Text="DRIVER" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WorkspaceText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="5" Text="LAST HEARTBEAT" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AgeText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="6" Text="IDS EVENTS" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalEventsText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="7" Text="UPTIME" Style="{StaticResource Meta}"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                        <TextBlock Grid.Row="8" Text="STATUS" Style="{StaticResource Meta}"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"/>
                            <TextBlock Text="ADAPTER READY" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CAN BUS HEALTH" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="RUNTIME FPS" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiagPacketRateText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="70" Fill="#56F0AC" HorizontalAlignment="Left"/></Grid>
                            <TextBlock Grid.Row="1" Text="LATENCY (ms)" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagLatencyText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="1" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="12" Fill="#00C8C8" HorizontalAlignment="Left"/></Grid>
                            <TextBlock Grid.Row="2" Text="FUSION SCORE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentRiskText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="2" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="20" Fill="#FF8C3A" HorizontalAlignment="Left"/></Grid>
                            <TextBlock Grid.Row="3" Text="CONFIDENCE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagConfidenceText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="3" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="46" Fill="#B46CFF" HorizontalAlignment="Left"/></Grid>
                            <TextBlock Grid.Row="4" Text="TOTAL ALERTS" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalEventsText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="4" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="28" Fill="#FF5050" HorizontalAlignment="Left"/></Grid>
                            <TextBlock Grid.Row="5" Text="DETECTED ATTACK" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentAttackText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="#FF8C3A"/>
                            <Grid Grid.Row="5" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/></Grid>
                            <TextBlock Grid.Row="6" Text="PACKET AGE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AgeText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="6" Grid.Column="2" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"><Rectangle Fill="#183333"/><Rectangle Width="28" Fill="#56F0AC" HorizontalAlignment="Left"/></Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SYSTEM SERVICES" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="SERVICE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="2" Text="UPTIME" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Text="Telemetry Service" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectivityText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="2" Text="Detection Engine" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignalHealthText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="3" Text="Replay Engine" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticsStatus}" Foreground="#00C8C8" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="4" Text="Validation Engine" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SignalHealthText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="5" Text="Model Runtime" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ModelText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="6" Text="Navigation Service" Style="{StaticResource Mono}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="READY" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CONNECTION MONITOR" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><Rectangle Width="3" Fill="#56F0AC" Margin="0,2,7,2"/><TextBlock Text="CONNECTED" Foreground="#56F0AC" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal"><Rectangle Width="3" Fill="#FF8C3A" Margin="0,2,7,2"/><TextBlock Text="RECONNECTING" Foreground="#FF8C3A" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal"><Rectangle Width="3" Fill="#FF5050" Margin="0,2,7,2"/><TextBlock Text="DISCONNECTED" Foreground="#FF5050" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/></StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal"><Rectangle Width="3" Fill="#B46CFF" Margin="0,2,7,2"/><TextBlock Text="LOCAL FALLBACK" Foreground="#B46CFF" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/></StackPanel>
                            <Canvas Grid.Column="1" Grid.RowSpan="4" Height="72" ClipToBounds="True">
                                <UniformGrid Rows="4" Width="620" Height="72">
                                    <Border BorderBrush="#102F6666" BorderThickness="0,0,0,1"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,0,0,1"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,0,0,1"/>
                                    <Border BorderBrush="#102F6666" BorderThickness="0,0,0,1"/>
                                </UniformGrid>
                                <Polyline Points="0,9 110,9 110,28 168,28 168,9 300,9 300,47 322,47 322,9 620,9" Stroke="#56F0AC" StrokeThickness="2.2"/>
                                <Line X1="110" Y1="9" X2="110" Y2="28" Stroke="#FF8C3A" StrokeThickness="2"/>
                                <Line X1="168" Y1="28" X2="168" Y2="9" Stroke="#56F0AC" StrokeThickness="2"/>
                                <Line X1="300" Y1="9" X2="300" Y2="47" Stroke="#FF5050" StrokeThickness="2"/>
                                <Line X1="322" Y1="47" X2="322" Y2="9" Stroke="#56F0AC" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="106" Canvas.Top="24" Width="8" Height="8" Fill="#FF8C3A"/>
                                <Ellipse Canvas.Left="296" Canvas.Top="43" Width="8" Height="8" Fill="#FF5050"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="ERROR CONSOLE" Style="{StaticResource Title}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalEventsText, StringFormat='{}{0} EVENTS'}" Style="{StaticResource Meta}"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIME" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="SEVERITY" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="3" Text="CODE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="4" Text="MESSAGE" Style="{StaticResource Meta}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredIdsEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RuntimeAlertEvent}">
                                        <Border BorderBrush="#102F6666" BorderThickness="0,0,0,1" Padding="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#6E9090" FontFamily="Consolas" FontSize="9"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource SeverityText}" FontSize="9"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CanId}" Foreground="#00C8C8" FontFamily="Consolas" FontSize="9"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AttackType}" Foreground="#B46CFF" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Reason}" Foreground="#D0ECEC" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="RESOURCE MONITOR" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="RISK SCORE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentRiskText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,13 18,12 36,13 54,10 72,12 90,11 108,12" Stroke="#00C8C8" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                            <TextBlock Grid.Row="1" Text="PRECISION" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReliabilityScoreText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="1" Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,13 18,14 36,13 54,8 72,13 90,9 108,12" Stroke="#B46CFF" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                            <TextBlock Grid.Row="2" Text="IDS EVENTS" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalEventsText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="2" Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,14 18,13 36,14 54,11 72,14 90,10 108,12" Stroke="#FF8C3A" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                            <TextBlock Grid.Row="3" Text="CONFIDENCE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagConfidenceText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="3" Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,13 18,13 36,13 54,13 72,11 90,12 108,11" Stroke="#56F0AC" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                            <TextBlock Grid.Row="4" Text="PACKET RATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiagPacketRateText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="4" Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,13 18,13 36,13 54,7 72,12 90,11 108,12" Stroke="#00C8C8" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                            <TextBlock Grid.Row="5" Text="LATENCY" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DiagLatencyText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="5" Grid.Column="2" Height="18" ClipToBounds="True"><Polyline Points="0,14 18,14 36,14 54,9 72,13 90,14 108,13" Stroke="#FF8C3A" StrokeThickness="1" VerticalAlignment="Center"/></Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="COMMUNICATION MONITOR" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="IDS FRAME RATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiagPacketRateText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="#56F0AC"/>
                            <TextBlock Grid.Row="1" Text="DETECTION LATENCY" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagLatencyText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="UI REFRESH RATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="2 / sec" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="#3A6060"/>
                            <TextBlock Grid.Row="3" Text="TOTAL ALERTS FIRED" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalEventsText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SYSTEM OVERVIEW" Style="{StaticResource Title}"/>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CURRENT RUNTIME" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SessionTimerText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="DIAGNOSTICS STATE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticsStatus}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="DETECTED ATTACK" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentAttackText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="#FF8C3A"/>
                            <TextBlock Grid.Row="3" Text="HEALTH SCORE" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReliabilityScoreText}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="4" Text="LAST RECOVERY ACTION" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiagnosticsStatus}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="5" Text="LAST CHECK" Style="{StaticResource Meta}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#18009999" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0C1616" Offset="0"/>
                    <GradientStop Color="#080E0E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RECOVERY ACTIONS" Style="{StaticResource Title}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <UniformGrid Grid.Column="1" Columns="6">
                    <Button Content="RECONNECT ADAPTER" Style="{StaticResource TinyButton}" Command="{Binding QuickScanCommand}" Margin="2,0"/>
                    <Button Content="RESTART TELEMETRY SERVICE" Style="{StaticResource TinyButton}" Command="{Binding RunFullScanCommand}" Margin="2,0"/>
                    <Button Content="RESTART DETECTION ENGINE" Style="{StaticResource TinyButton}" Command="{Binding StopScanCommand}" Margin="2,0"/>
                    <Button Content="RESTART ALL SERVICES" Style="{StaticResource TinyButton}" Command="{Binding RunFullScanCommand}" Margin="2,0"/>
                    <Button Content="RELOAD MODEL" Style="{StaticResource TinyButton}" Command="{Binding SaveSnapshotCommand}" Margin="2,0"/>
                    <Button Content="CLEAR ERROR LOG" Style="{StaticResource TinyButton}" Command="{Binding ClearAlertsCommand}" Margin="2,0" Foreground="#FF716C"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DIAGNOSTICS STATUS" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding DiagnosticsStatus}" Foreground="#56F0AC" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="{Binding UpdatedText, StringFormat='LAST CHECK {0}'}" Foreground="#2A5050" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="{Binding AgeText, StringFormat='NEXT CHECK {0}'}" Foreground="#2A5050" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="AUTO REFRESH ON" Foreground="#2A5050" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
