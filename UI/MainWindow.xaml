<Window
    x:Class="CANvision.Native.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:CANvision.Native.UI"
    Title="CANvision IDS"
    Width="1600"
    Height="940"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    Background="#0A1212">
    <Grid ClipToBounds="False">
        <Grid
            x:Name="HubLayer"
            Panel.ZIndex="995"
            Visibility="{Binding IsHubVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Content="{Binding HubSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <Grid
            x:Name="InterfaceLayer"
            Panel.ZIndex="999"
            Background="Transparent"
            Visibility="{Binding IsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Thumb">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#4D00FFFF" CornerRadius="3" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="RepeatButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Rectangle Fill="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ScrollBar">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Width" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <!-- Top navigation bar -->
            <Border Grid.Row="0" Background="#D0071520" BorderBrush="#40069FC4" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App title -->
                    <TextBlock Grid.Column="0" Margin="16,0,20,0" VerticalAlignment="Center"
                               Text="CANvision" FontFamily="Bahnschrift" FontSize="15"
                               FontWeight="SemiBold" Foreground="#00D7F8" />

                    <!-- ⌂ HOME button -->
                    <Button Grid.Column="1" Margin="0,0,6,0"
                            Padding="10,0" Height="26"
                            FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                            Foreground="#00C8C8" Background="#0A001818"
                            BorderBrush="#2800C8C8" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="{Binding IsGarageButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding NavigateToGarageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="HOME" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ← BACK TO CARDS button -->
                    <Button Grid.Column="2" Margin="0,0,0,0"
                            Padding="10,0" Height="26"
                            FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                            Foreground="#6E9090" Background="Transparent"
                            BorderBrush="#18009999" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="{Binding IsBackToCardsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding BackToCardsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="CARDS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Section tabs -->
                    <ItemsControl Grid.Column="4" ItemsSource="{Binding NavigationService.Tabs}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="2,0" Padding="14,0"
                                        Height="34"
                                        Content="{Binding Title}"
                                        FontFamily="Bahnschrift Condensed"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#A0D8E8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        IsEnabled="{Binding IsUnlocked}"
                                        Command="{Binding DataContext.NavigationService.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Backend status -->
                    <TextBlock Grid.Column="5" Margin="0,0,16,0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="10" Foreground="#507080"
                               Text="CANvision IDS" />
                </Grid>
            </Border>

            <ContentControl
                x:Name="SectionContentHost"
                Grid.Row="1"
                Margin="0"
                Content="{Binding CurrentSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!-- ── Empty State Overlay ──────────────────────────────────────────
                 Shown whenever a section is visible but analysis is not complete.
                 Sits above section content so no screen shows fake data.
                 ──────────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1"
                  Background="#CC071520"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO DATA"
                               FontFamily="Bahnschrift" FontSize="11" FontWeight="SemiBold"
                               Foreground="#2A5A5A" HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Waiting for dataset analysis."
                               FontFamily="Bahnschrift" FontSize="18" FontWeight="Light"
                               Foreground="#3A7070" HorizontalAlignment="Center"/>
                    <TextBlock Text="Import a replay file in Garage to begin."
                               FontFamily="Bahnschrift" FontSize="11"
                               Foreground="#255050" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── Global Analysis Status Banner ───────────────────────────────
                 Shown while analysis is running. Disappears on completion.
                 ──────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#E0071520" BorderBrush="#4000C8C8" BorderThickness="0,1,0,0"
                    Padding="16,4"
                    Visibility="{Binding ShowAnalysisBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding AnalysisBannerText}"
                               FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                               Foreground="#00C8C8" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1"
                                 Height="2" Margin="16,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding NavigationService.HomeSection.AnalysisProgressPercent, Mode=OneWay}"
                                 Background="#08001818" BorderThickness="0"
                                 Foreground="#00C8C8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AnalysisBannerProgress}"
                               FontFamily="Bahnschrift" FontSize="10"
                               Foreground="#509090" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>


