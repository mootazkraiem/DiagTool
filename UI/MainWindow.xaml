<Window
    x:Class="CANvision.Native.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:CANvision.Native.UI"
    Title="CANvision IDS"
    Width="1600"
    Height="940"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    Background="#0A1212">
    <Grid ClipToBounds="False">
        <Grid
            x:Name="HubLayer"
            Panel.ZIndex="995"
            Visibility="{Binding IsHubVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Content="{Binding HubSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <Grid
            x:Name="InterfaceLayer"
            Panel.ZIndex="999"
            Background="Transparent"
            Visibility="{Binding IsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Thumb">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#4D00FFFF" CornerRadius="3" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="RepeatButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Rectangle Fill="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ScrollBar">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Width" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <!-- Top navigation bar — hidden on Home screen -->
            <Border Grid.Row="0" Height="48" Background="#E5040C0C" BorderBrush="#2200FFFF"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsTopBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left nav: CANvision | HOME | tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- App title with cyan glow -->
                        <TextBlock Text="CANvision" FontFamily="Space Grotesk"
                                   FontSize="15" FontWeight="Bold" Foreground="#00FFFF"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00ffff" BlurRadius="14" Opacity="0.55" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- | HOME -->
                        <TextBlock Text=" |" FontFamily="Manrope" FontSize="11"
                                   Foreground="#1E3A3A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Margin="6,0,0,0" Padding="0" VerticalAlignment="Center"
                                Command="{Binding NavigateToGarageCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontFamily" Value="Space Grotesk"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#7AACAC"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#AADDDD"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="HOME" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Section tabs — each preceded by | separator -->
                        <ItemsControl ItemsSource="{Binding NavigationService.Tabs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text=" |" FontFamily="Manrope" FontSize="11"
                                                   Foreground="#1E3A3A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Button Margin="6,0,0,0" Padding="0" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsUnlocked}"
                                                Command="{Binding DataContext.NavigationService.NavigateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="FontFamily" Value="Space Grotesk"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#7AACAC"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#00FFFF"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00ffff" BlurRadius="10" Opacity="0.5" ShadowDepth="0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#253A3A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#AADDDD"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Right dim label -->
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               FontFamily="Manrope" FontSize="9" Foreground="#1E3A3A"
                               Text="CANvision IDS"/>
                </Grid>
            </Border>

            <ContentControl
                x:Name="SectionContentHost"
                Grid.Row="1"
                Margin="0"
                Content="{Binding CurrentSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!-- ── Empty State Overlay ──────────────────────────────────────────
                 Shown whenever a section is visible but analysis is not complete.
                 Sits above section content so no screen shows fake data.
                 ──────────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1"
                  Background="#CC071520"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO DATA"
                               FontFamily="Space Grotesk" FontSize="11" FontWeight="SemiBold"
                               Foreground="#2A5A5A" HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock FontFamily="Space Grotesk" FontSize="18" FontWeight="Light"
                               Foreground="#3A7070" HorizontalAlignment="Center"
                               Text="{Binding EmptyStateTitle}"/>
                    <TextBlock FontFamily="Manrope" FontSize="11"
                               Foreground="#255050" HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Text="{Binding EmptyStateSubtitle}"/>
                </StackPanel>
            </Grid>

            <!-- ── Global Analysis Status Banner ───────────────────────────────
                 Shown while analysis is running. Disappears on completion.
                 ──────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#E0071520" BorderBrush="#4000C8C8" BorderThickness="0,1,0,0"
                    Padding="16,4"
                    Visibility="{Binding ShowAnalysisBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding AnalysisBannerText}"
                               FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                               Foreground="#00C8C8" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1"
                                 Height="2" Margin="16,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding NavigationService.HomeSection.AnalysisProgressPercent, Mode=OneWay}"
                                 Background="#08001818" BorderThickness="0"
                                 Foreground="#00C8C8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AnalysisBannerProgress}"
                               FontFamily="Bahnschrift" FontSize="10"
                               Foreground="#509090" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>


