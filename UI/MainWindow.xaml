<Window
    x:Class="CANvision.Native.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="clr-namespace:CANvision.Native.UI"
    Title="CANvision IDS"
    Width="1728"
    Height="900"
    MinWidth="1280"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Background="{DynamicResource CvGroundBrush}">

    <!-- Frameless shell. CaptionHeight 0 because the nav bar handles dragging
         itself; WindowChrome is still what preserves Aero snap, maximize to
         the work area, and the resize borders. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid ClipToBounds="False">
        <Grid
            x:Name="HubLayer"
            Panel.ZIndex="995"
            Visibility="{Binding IsHubVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl
                Content="{Binding HubSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <Grid
            x:Name="InterfaceLayer"
            Panel.ZIndex="999"
            Background="Transparent"
            Visibility="{Binding IsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Opacity="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══ TOP NAVIGATION ═══════════════════════════════════════════
                 Frameless shell chrome: doubles as the window drag handle and
                 carries the module tabs plus the link-state badge, per the
                 CANvision reference. Hidden on the Home screen. -->
            <Border Grid.Row="0" Height="46"
                    Background="{DynamicResource CvChromeBrush}"
                    BorderBrush="{DynamicResource CvBorderAccentBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnChromeDrag"
                    Visibility="{Binding IsTopBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand mark: outlined square + live dot -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,18,0">
                        <Border Width="21" Height="21" CornerRadius="5"
                                BorderBrush="{DynamicResource CvBorderAccentStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource CvAccentBrush}"
                                     Effect="{DynamicResource CvAccentGlow}"/>
                        </Border>
                        <TextBlock Text="CANvision" Margin="9,0,0,0"
                                   FontFamily="{StaticResource CvDisplayFont}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource CvTextBrightBrush}"
                                   VerticalAlignment="Center"
                                   Effect="{DynamicResource CvAccentGlowSoft}"/>
                        <Rectangle Width="1" Height="20" Margin="18,0,0,0"
                                   Fill="{DynamicResource CvBorderAccentBrush}"/>
                    </StackPanel>

                    <!-- Module tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource CvNavTab}"
                                Content="HOME"
                                Command="{Binding NavigateToGarageCommand}"/>
                        <ItemsControl ItemsSource="{Binding NavigationService.Tabs}" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CvNavTab}"
                                            Content="{Binding Title}"
                                            IsEnabled="{Binding IsUnlocked}"
                                            Tag="{Binding IsActive}"
                                            Command="{Binding DataContext.NavigationService.NavigateCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Link state badge -->
                    <Border Grid.Column="2" Style="{StaticResource CvBadge}"
                            VerticalAlignment="Center" Margin="12,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource CvStatusDotPulse}" Width="6" Height="6"/>
                            <TextBlock Text="SECURE LINK" Margin="7,0,0,0"
                                       FontFamily="{StaticResource CvMonoFont}"
                                       FontSize="10" Foreground="{DynamicResource CvAccentDimBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Window controls (the native caption bar is gone) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- Light / dark mode: sun offers light, moon offers dark -->
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource CvCaptionButton}" Content="&#xE706;"
                                Click="OnToggleTheme" Loaded="OnThemeButtonLoaded"
                                AutomationProperties.Name="THEME" ToolTip="Switch to light mode"/>
                        <Button Style="{StaticResource CvCaptionButton}" Content="&#xE921;" Click="OnMinimize"/>
                        <Button Style="{StaticResource CvCaptionButton}" Content="&#xE922;" Click="OnMaximize"/>
                        <Button Style="{StaticResource CvCaptionCloseButton}" Content="&#xE8BB;" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl
                x:Name="SectionContentHost"
                Grid.Row="1"
                Margin="0"
                Content="{Binding CurrentSection}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!-- ── Empty State Overlay ──────────────────────────────────────────
                 Shown whenever a section is visible but analysis is not complete.
                 Sits above section content so no screen shows fake data.
                 ──────────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1"
                  Background="{DynamicResource CvEmptyScrimBrush}"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO DATA"
                               FontFamily="Space Grotesk" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource CvEmptyLabelBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock FontFamily="Space Grotesk" FontSize="18" FontWeight="Light"
                               Foreground="{DynamicResource CvEmptyTitleBrush}" HorizontalAlignment="Center"
                               Text="{Binding EmptyStateTitle}"/>
                    <TextBlock FontFamily="Manrope" FontSize="11"
                               Foreground="{DynamicResource CvEmptySubtitleBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Text="{Binding EmptyStateSubtitle}"/>
                </StackPanel>
            </Grid>

            <!-- ── Global Analysis Status Banner ───────────────────────────────
                 Shown while analysis is running. Disappears on completion.
                 ──────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CvBannerBrush}" BorderBrush="{DynamicResource CvBannerBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,4"
                    Visibility="{Binding ShowAnalysisBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding AnalysisBannerText}"
                               FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource CvAccentBrush}" VerticalAlignment="Center"/>
                    <!-- IsIndeterminate switches to WPF's built-in scrolling
                         animation instead of sitting frozen at 90% during the
                         AI-explanation phase, which has no real progress to report. -->
                    <ProgressBar Grid.Column="1"
                                 Height="2" Margin="16,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding NavigationService.HomeSection.AnalysisProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding NavigationService.HomeSection.IsAnalysisIndeterminate}"
                                 Background="{DynamicResource CvBannerTrackBrush}" BorderThickness="0"
                                 Foreground="{DynamicResource CvAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AnalysisBannerProgress}"
                               Visibility="{Binding NavigationService.HomeSection.IsAnalysisIndeterminate, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                               FontFamily="Bahnschrift" FontSize="10"
                               Foreground="{DynamicResource CvBannerProgressBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>


