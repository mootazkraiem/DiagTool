@startuml
!include style.iuml
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 40

rectangle "M1\nlive foundation" as M1
rectangle "M3\ntraining per\ndriving state" as M3
rectangle "M4\nexplanation\nengine" as M4
rectangle "M5\nreal time\ncharts" as M5
rectangle "M6\nsession\nrecording" as M6
rectangle "M8 and M7\ndecoding and\nintegration" as M8
rectangle "M2\nhardware layer" as M2
rectangle "Iteration 1\nvalidation and\nsix corrections" as V1
rectangle "Iteration 2\nmodel rebuild and\nholdout evaluation" as V2
rectangle "Final release" as End

M1 -right-> M3
M3 -right-> M4
M4 -right-> M5
M5 -right-> M6
M6 -down-> M8
M8 -left-> M2
M2 -left-> V1
V1 -left-> V2
V2 -left-> End
@enduml
