@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 6
skinparam component {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

component "Desktop Client\n(WPF)" as Client
component "Backend\n(FastAPI)" as Backend
component "Machine Learning" as ML
component "SQLite" as DB
component "CAN Interface" as CAN

Client --> Backend
Backend --> ML
Backend --> DB
Backend --> CAN
@enduml
