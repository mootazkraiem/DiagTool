@startuml
!include style.iuml
skinparam roundCorner 14

start
:Alert list shown in Anomaly Intel;
if (which export?) then (EXPORT CSV)
  :One row per alert: time, CAN ID,
  severity, pattern, score, reason,
  knowledge base match, explanation;
  :Numbers written in a fixed format
  (independent of the Windows language);
  :alerts_<date>.csv;
else (EXPORT PDF)
  :PdfReportBuilder.Build();
  :A4 report: header, summary
  by severity, table of the alerts;
  :CANvision_AlertReport_<date>.pdf;
endif
stop
@enduml
