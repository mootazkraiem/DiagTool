@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam node {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #C77800
}
skinparam artifact {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

node "Windows workstation" {
  artifact "CANvisionNative.exe\n(WPF process)" as WPF
  artifact "uvicorn / FastAPI\n(Python process, port 8765)" as API
  database "SQLite DB,\nmodel store,\nDBC files" as DB
}

cloud "LLM API (Gemini)" as Gemini
node "Ollama\n(localhost, optional)" as Ollama
node "ELM327 / SocketCAN\nadapter + vehicle" as HW

WPF <--> API : HTTP :8765
API <--> DB
API <--> Gemini : HTTPS
API <--> Ollama : localhost
API <--> HW : serial / SocketCAN
@enduml
