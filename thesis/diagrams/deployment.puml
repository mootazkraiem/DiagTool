@startuml
!include style.iuml
skinparam nodesep 45
skinparam ranksep 50

node "Analyst workstation (Windows 10/11)" as PC {
  artifact "CANvisionNative.exe\n(.NET Framework 4.8)" as Exe
  node "Python process (uvicorn)" as Py {
    artifact "backend.api.server\n(port 8765)" as Server
  }
  database "SQLite file\n(sessions, alerts)" as Db
  folder "assets/models\n(manifests, models)" as Models
  node "Ollama (optional)" as Ollama
}

cloud "Google Gemini API" as Gemini
node "USB CAN adapter\n(slcan bridge, PCAN)" as Adapter
node "Vehicle or bench rig\n(CAN bus, 500 kbit/s)" as Bus

Exe -down-> Server : HTTP
Server -down-> Db
Server -down-> Models
Server -down-> Ollama : HTTP
Server -right-> Gemini : HTTPS
Server -down-> Adapter : USB (python-can)
Adapter -down- Bus : CAN
@enduml
