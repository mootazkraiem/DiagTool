@startuml
!include style.iuml
left to right direction
skinparam linetype polyline
skinparam usecase {
  BackgroundColor white
  BorderColor black
}

actor "Analyst" as Analyst

rectangle "CANvisionNative" {
  usecase "Import log" as Import
  usecase "Select vehicle" as Select
  usecase "Configure settings" as Configure
  usecase "Export report" as Export
  usecase "Replay log" as Replay
  usecase "Start live simulation" as Simulate
  usecase "Review alerts" as Review
  usecase "Connect hardware" as Connect
  usecase "Detect anomaly" as Detect
  usecase "Request explanation" as Explain
}

actor "Vehicle /\nCAN bus" as Bus
actor "LLM provider\n(Gemini, Ollama)" as LLM

Analyst --> Import
Analyst --> Select
Analyst --> Configure
Analyst --> Export
Analyst --> Replay
Analyst --> Simulate
Analyst --> Review
Analyst --> Connect

Replay ..> Detect : <<include>>
Simulate ..> Detect : <<include>>
Connect ..> Detect : <<include>>
Review <.. Explain : <<extend>>

Bus -- Connect
Explain -- LLM
@enduml
