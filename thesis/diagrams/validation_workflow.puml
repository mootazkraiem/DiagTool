@startuml
!include style.iuml
skinparam roundCorner 14

start
partition "Pass 1: interface audit" {
  :Use every screen and control, also in
  the wrong order, and fix the problems found;
}
partition "Pass 2: root causes" {
  :Replay the Kia EV6 recording
  (97,741 frames);
  repeat
    :Take an unexplained alert and find
    the layer that dominates its score;
  repeat while (alerts left
  unexplained?) is (yes)
  ->no;
}
partition "Pass 3: correction" {
  repeat
    :Reproduce a suspected
    defect on demand;
    :Find its cause in the code
    and fix it;
    :Run the same test again;
  repeat while (defects left?) is (yes)
  ->no;
  :Full run: import, replay, detection,
  explanation, export;
}
stop
@enduml
