@startuml
!include style.iuml
skinparam linetype ortho
left to right direction

[Desktop client\nPythonApiClient] as Client

package "REST API (server.py)" {
  [/analyze\n/api/offline/*] as EOffline
  [/api/replay/*] as EReplay
  [/api/live/*\n/api/live/hardware/*] as ELive
  [/api/explain/{index}\n/api/chat] as EExplain
  [/api/models\n/api/vehicles] as EModels
  [/api/signals/discover\n/api/dataset/describe] as ECapture
  [/api/session/*\n/api/settings\n/api/db/stats] as EData
}

package "Backend components" {
  [Offline analysis\nvehicle_scoring, session_analyzer] as COffline
  [Replay process\nreplay_runner] as CReplay
  [RealtimeEngine] as CEngine
  [Hardware\ncan_interface] as CHw
  [Explanation\nexplainer/llm.py] as CExplain
  [Model status\nmodel_status, vehicle_profiles] as CModels
  [Capture description\nsignal_discovery, dataset_facts] as CCapture
  [SQLite store\nand settings] as CData
}

Client --> EOffline
Client --> EReplay
Client --> ELive
Client --> EExplain
Client --> EModels
Client --> ECapture
Client --> EData

EOffline --> COffline
EReplay --> CReplay
CReplay --> CEngine
ELive --> CHw
CHw --> CEngine
EExplain --> CExplain
EModels --> CModels
ECapture --> CCapture
EData --> CData
@enduml
