@startuml
!include style.iuml
skinparam roundCorner 14

start
:Analyst selects an alert:
GET /api/explain/{index};
if (index in the alert list of the
last analysis or replay?) then (yes)
  :Take that alert;
else (no)
  if (live alert buffer empty?) then (yes)
    :404, no alert to explain;
    stop
  else (no)
    :Take the alert from the live
    buffer (newest first);
  endif
endif
if (explanation already
in the cache?) then (yes)
  :Return the cached text;
  stop
else (no)
endif
:Build the context
----
features and scores of the alert
expected statistics of the identifier
closest pattern in the knowledge base
most similar past explanation
signals of the identifier (signal map)
short web search (Wikipedia, NVD),
used by Gemini only;
if (Gemini answers?) then (yes)
  :mode = gemini
  numbers of the answer that are
  not in the context are recorded;
else (no)
  if (local Ollama answers?) then (yes)
    :mode = ollama
    numbers of the answer that are
    not in the context are recorded;
  else (no)
    :Rule based template
    mode = rule_based;
  endif
endif
:Save it in the history store, then show
the summary, detail and recommendation
with the name of the engine;
stop
@enduml
