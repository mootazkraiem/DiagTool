@startuml
!include style.iuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
hide footbox

actor Analyst
participant "AnomalyIntelViewModel" as VM
participant "PythonApiClient" as Client
participant "server.py" as Server
participant "explainer.llm" as Explainer
participant "Gemini" as Gemini
participant "Ollama" as Ollama

Analyst -> VM : select alert
VM -> Client : GetAlertExplanationAsync(index)
Client -> Server : GET /api/explain/{index}
activate Server
Server -> Server : find the alert\n(last analysis or replay,\nelse live buffer)
opt explanation not in the cache
  Server -> Explainer : explain_alert(alert)
  activate Explainer
  Explainer -> Explainer : build_context(alert),\nsignal map, web search
  Explainer -> Gemini : prompt with the\nweb results
  alt Gemini answers
    Gemini --> Explainer : explanation
  else Gemini not available
    Explainer -> Ollama : prompt without\nthe web results
    alt Ollama answers
      Ollama --> Explainer : explanation
    else no model available
      Explainer -> Explainer : rule based\ntemplate
    end
  end
  Explainer --> Server : explanation + mode
  deactivate Explainer
end
Server --> Client : JSON
deactivate Server
Client --> VM : ExplainAlertResponse
VM --> Analyst : explanation,\nengine name
@enduml
