rectangle "Fix 1\nvehicle model\nselection" as F1
rectangle "Fix 2\ndriving state\nclassification" as F2
rectangle "Fix 3\nattribution of\nthe reason" as F3
rectangle "Fix 4\none parser\nfor replay" as F4
