@startuml
!include style.iuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
hide footbox

actor Analyst
participant "LogPlaybackViewModel" as VM
participant "VehicleDataService" as Data
participant "server.py" as Server
participant "replay_runner\n(subprocess)" as Runner
participant "RealtimeEngine" as Engine

Analyst -> VM : Open file, vehicle selected
VM -> VM : parse the file\n(CanLogImportService)
VM -> Data : LoadReplayPackets()
VM -> Data : TriggerBackendReplayAsync()
Data -> Server : POST /api/replay/start\n{input_path, vehicle_id}
activate Server
Server -> Runner : start process
activate Runner
Server --> Data : state: running
loop every frame of the file
  Runner -> Engine : process_frame(frame)
  Engine --> Runner : scores, alert or none
end
note right of Runner : every 1,000 frames,\npartial alerts\nwritten to a file
loop every 500 ms until the end
  Data -> Server : GET /api/replay/status
  opt every 10th poll (about 5 s)
    Data -> Server : GET /api/replay/partial-alerts
  end
end
Runner -> Runner : write the summary file
Runner --> Server : process ends
deactivate Runner
Server -> Server : status completed,\nalerts published\nfor /api/explain
Data -> Server : GET /api/replay/alerts
Server --> Data : alert list
deactivate Server
Data --> VM : AlertHistoryUpdated
VM --> Analyst : alerts on the timeline
@enduml
