@startuml
!include style.iuml
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 40

rectangle "14 rolling features\nof the frame" as F
rectangle "RobustScaler" as S
rectangle "K-Means\n(5 clusters, shared\nby all vehicles)" as K
rectangle "Cluster to state\nmapping" as M
rectangle "Driving state:\nparking, idle\nor driving" as ST
rectangle "Isolation Forest of\nthis state and vehicle\n(with its own scaler)" as IF
rectangle "Generic model,\nthen a heuristic" as G

F -right-> S
S -right-> K
K -right-> M
M -down-> ST
ST -left-> IF
IF .left.> G : no forest\nfor this state
@enduml
