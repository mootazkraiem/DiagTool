@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam state {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

[*] --> Parking

Parking --> Idle : engine/traction\nactivity detected
Idle --> Driving : sustained motion\nfeatures detected
Driving --> Idle : motion features\ndrop off
Idle --> Parking : no activity for\nrolling window
Driving --> Parking : session ends

note right of Driving
  K-Means classification from
  14 timing/payload features,
  scaled with RobustScaler
  before classify_state()
end note
@enduml
