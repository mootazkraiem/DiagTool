@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 6
skinparam state {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

[*] --> Parking

Parking --> Idle : activity detected
Idle --> Driving : sustained motion
Driving --> Idle : motion drops off
Idle --> Parking : no activity
Driving --> Parking : session ends
@enduml
