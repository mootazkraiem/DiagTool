@startuml
!include style.iuml
skinparam roundCorner 14

start
:Open the MF4 file with asammdf;
repeat :Next channel group;
  if (group holds CAN frames?) then (yes)
    :Extract timestamp,
    identifier and payload;
  else (no, empty template)
  endif
repeat while (groups left?) is (yes)
->no;
:Merge the groups
and sort by timestamp;
:Compare the number of frames
with the metadata of the file;
if (counts equal?) then (yes)
  :Common frame stream
  (97,741 frames for the Kia EV6 file);
else (no)
  :Look for the missing frames
  before using the file;
endif
stop
@enduml
