@startuml
!include style.iuml
skinparam roundCorner 14

start
:Recordings of one vehicle
(listed in the plan file);
:Split by recording:
training recordings / holdout recordings
(no overlap, checked with SHA-256);
:Compute the 9 features per identifier
on the training recordings;
repeat :Next identifier;
  if (at least 1,000 rows
  and varying features?) then (yes)
    :Fit an Isolation Forest
    (200 trees, seed 42, no scaler);
    :Threshold: 2% of the training rows
    (strict quantile), keep the median;
  else (no)
    :Record it as sparse
    or unmodelled;
  endif
repeat while (identifiers left?) is (yes)
->no;
:Write models.joblib and manifest.json
to assets/models_staging/<version>;
:Score the holdout recordings,
write the validation report;
if (evaluation acceptable?) then (yes)
  :Promote to assets/models
  (model file stored with Git LFS);
  :Archive the replaced files
  with promotion.json;
else (no)
  :Hold the model back;
endif
stop
@enduml
