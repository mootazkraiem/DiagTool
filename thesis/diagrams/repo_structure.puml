@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 6
skinparam component {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

component "WPF Client Project" as Client
component "Python Backend Project" as Backend
component "Shared Assets\n(trained models, DBC files, datasets)" as Assets

Client --> Backend
Client ..> Assets
Backend ..> Assets
@enduml
