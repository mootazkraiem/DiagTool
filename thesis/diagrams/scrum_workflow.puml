@startuml
!include style.iuml
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

rectangle "Product backlog\n(prioritised work)" as PB
rectangle "Sprint planning" as SP
rectangle "Sprint backlog" as SB
rectangle "Sprint\n(one to four weeks,\ndaily follow up)" as S
rectangle "Working increment" as I
rectangle "Sprint review\n(backlog updated)" as R
rectangle "Retrospective" as RE

PB -right-> SP
SP -right-> SB
SB -right-> S
S -down-> I
I -left-> R
R -left-> RE
RE -up-> SP : next sprint
@enduml
