@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam component {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

component "XAML Views\n(Home, Dashboard, ...)" as Views
component "ViewModels\n(SectionViewModels.cs)" as VMs
component "VehicleDataService\n(shared state + poll timer)" as VDS
component "PythonApiClient\n(HTTP wrapper)" as API
component "Backend REST API" as Backend

Views <--> VMs
VMs <--> VDS
VMs <--> API
VDS <--> Backend
API <--> Backend
@enduml
