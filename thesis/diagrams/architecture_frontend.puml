@startuml
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 6
skinparam component {
  BackgroundColor #EAF2FF
  BorderColor #2C5AA0
  ArrowColor #2C5AA0
}

component "Screens\n(Home, Dashboard, Telemetry,\nDiagnostics, Log Playback,\nAnomaly Intel, Settings)" as Screens
component "Shared Client Services\n(API client + live state)" as Services
component "Backend REST API" as Backend

Screens --> Services
Services --> Backend
@enduml
