<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CANvision.Native</RootNamespace>
    <AssemblyName>CANvisionNative</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference typefaces compiled in as WPF resources (SIL Open Font
         License). Space Grotesk = display/UI, JetBrains Mono = every
         machine value. -->
    <Resource Include="assets\fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives under tests/ and must not be globbed into the app. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <InternalsVisibleTo Include="CANvisionNative.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Only assets\6k+-D+copy+-+High+Contrast.webp is actually loaded at runtime
      (via pack://siteoforigin in UI/SettingsView.xaml). Everything else under
      assets\ (ML datasets/models/dbc files) is read directly from the project
      root by the Python backend process, never from this build's output dir,
      so it must NOT be globbed wholesale here — assets\ contains ~7GB of
      gitignored training data that should never end up in bin\.
    -->
    <Content Include="assets\6k+-D+copy+-+High+Contrast.webp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
